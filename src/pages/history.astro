---
import Layout from '../layouts/Layout.astro';
import { getMediaUrl } from '../utils/media';
---

<Layout 
  title="History – Crescent School"
  description="Chronicle the inspiring 55+ year history of Crescent Model Higher Secondary School since 1968. Founded by the four brothers of Crescent Group into Pakistan's largest premier not-for-profit educational institution."
>
  <!-- Standard Top Page Hero Banner -->
  <section class="page_hero_banner">
    <div class="container">
      <div class="hero_breadcrumbs">
        <a href="/">Home</a>
        <span>/</span>
        <span>Our Institution</span>
        <span>/</span>
        <a href="/about-us/">About Us</a>
        <span>/</span>
        <span class="current">History</span>
      </div>
      <h1 class="hero_page_title">Our Rich History</h1>
      <p class="hero_subtitle">A journey of more than five decades, transforming from thirty-five students into Pakistan's flagship not-for-profit educational beacon.</p>
    </div>
  </section>

  <!-- Timeline Section 1: The Founders -->
  <section class="history_era_section">
    <div class="container">
      <div class="history_era_grid">
        <div class="era_text">
          <span class="era_year">1968 • THE GENESIS</span>
          <h2 class="era_title">Four Brothers — The Founders of Crescent Group</h2>
          <p class="era_lead">
            Four visionary brothers — <strong>Mian Fazal Karim</strong>, <strong>Mian Muhammad Amin</strong>, <strong>Haji Muhammad Shafi</strong>, and <strong>Mian Muhammad Bashir</strong> — founded the Crescent Group and anchored philanthropy into their core philosophy.
          </p>
          <p class="era_body">
            Driven by a passionate belief that accessible, quality schooling is the single most vital catalyst for national progress, they established the <strong>Crescent Educational Trust</strong> to provide underprivileged and middle-class families with premier British and national curriculum education at nominal costs.
          </p>
          <div class="quote_box">
            "Without providing quality education at a reasonable cost to less privileged children, Pakistan cannot progress."
          </div>
        </div>

        <div class="era_media">
          <div class="image_frame">
            <img 
              src={getMediaUrl("/images/batch2/crescent-history-u.jpg")} 
              alt="Founders of Crescent Group" 
              loading="lazy"
              onerror="this.src='/images/hero_slider_1.jpg'"
            />
            <span class="img_caption">Founders of the Crescent Educational Trust</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Timeline Section 2: Eminent Personalities & First Batch -->
  <section class="history_era_section alternate_bg">
    <div class="container">
      <div class="history_era_grid reverse">
        <div class="era_text">
          <span class="era_year">1968 - 1970 • EXPANSION</span>
          <h2 class="era_title">Eminent Personalities & The First Batch</h2>
          <p class="era_body">
            Other leading personalities of Pakistani society made invaluable contributions with their experience, judicial acumen, and wisdom: <strong>Chief Justice Muhammad Munir</strong>, <strong>Chief Justice Yaqoob Ali Khan</strong>, <strong>Dr. Ameer-ud-Din</strong>, <strong>Dr. Mubashir Hassan</strong>, and renowned journalist <strong>Mr. Majid Nizami</strong>.
          </p>
          <p class="era_body">
            While the permanent campus was still under construction, the first batch of <strong>35 students</strong> was accommodated in a humble two-room facility in Garden Town in April 1968. By 1970, the institution had proudly shifted to its permanent 8-acre campus in the prestigious Shadman Colony, Lahore.
          </p>
          <p class="era_body">
            The highest standards of education, an affordable fee structure, well-trained and dedicated faculty, and merit-based, need-blind admissions were maintained right from inception.
          </p>
        </div>

        <div class="era_media">
          <div class="image_frame">
            <img 
              src={getMediaUrl("/images/batch2/first-batch.jpg")} 
              alt="First Batch of Crescent School Students (1968)" 
              loading="lazy"
              onerror="this.src='/images/welcome_side.jpg'"
            />
            <span class="img_caption">Archival Photograph: First Batch of Students, 1968</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Timeline Section 3: The Game Changers -->
  <section class="history_era_section">
    <div class="container">
      <div class="history_era_grid">
        <div class="era_text">
          <span class="era_year">LEADERSHIP EXCELLENCE</span>
          <h2 class="era_title">The "Game Changers"</h2>
          <p class="era_lead">
            The school was immensely fortunate to have legendary academic leadership in its formative decades: <strong>Sheikh Moin ud Din</strong> as Principal and <strong>Ms. Jahan Ara Khan</strong> as Headmistress.
          </p>
          <p class="era_body">
            Their unyielding commitment to discipline, academic rigour, moral upbringing, and athletic cultivation set the benchmark that continues to define Crescent culture today. Under their stewardship, the school grew exponentially in student count, board distinctions, and national debating and sporting trophies.
          </p>
          <p class="era_body">
            In 1987, the <strong>Girls Campus</strong> was established as an independent academic complex, ensuring that young women have equal, dedicated access to top-tier laboratories, Cambridge curriculum, and athletic amenities.
          </p>
        </div>

        <div class="era_media">
          <div class="image_frame">
            <img 
              src={getMediaUrl("/images/batch2/crescent-hint-college.jpg")} 
              alt="Historic Crescent College Building" 
              loading="lazy"
              onerror="this.src='/images/hero_slider_2.jpg'"
            />
            <span class="img_caption">The Crescent College Wing & Historic Quadrangle</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Timeline Section 4: Largest Not for Profit School -->
  <section class="history_era_section alternate_bg">
    <div class="container">
      <div class="history_era_grid reverse">
        <div class="era_text">
          <span class="era_year">MODERN ERA • 9,000+ SCHOLARS</span>
          <h2 class="era_title">Largest Not-for-Profit School in Pakistan</h2>
          <p class="era_lead">
            With a rich history exceeding fifty-five years, Crescent Model Higher Secondary School stands today as the largest and most prestigious not-for-profit educational institution in the country.
          </p>
          <p class="era_body">
            Spread across two grand campuses in Shadman, the school currently educates over <strong>6,000 boys</strong> and <strong>3,000 girls</strong>. The infrastructure boasts complete Cambridge O & A Levels facilities, the International Baccalaureate (IB) continuum (MYP, DP, CP), computerized libraries, robotics incubators, an Olympic swimming pool, and sprawling football grounds.
          </p>
          <p class="era_body">
            Tens of thousands of alumni have graduated to become prominent judges, federal secretaries, military generals, physicians, corporate CEOs, and academic scholars across Pakistan and the globe.
          </p>
        </div>

        <div class="era_media dual_images">
          <div class="image_frame">
            <img 
              src={getMediaUrl("/images/batch2/nonprofit.jpg")} 
              alt="Crescent Non-Profit School Model" 
              loading="lazy"
              onerror="this.src='/images/hero_slider_1.jpg'"
            />
          </div>
          <div class="image_frame">
            <img 
              src={getMediaUrl("/images/batch2/DJI_0043.jpg")} 
              alt="Drone Aerial View of Crescent Campus" 
              loading="lazy"
              onerror="this.src='/images/hero_slider_3.jpg'"
            />
            <span class="img_caption">Aerial Drone View: 8-Acre Shadman Campus Today</span>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .history_era_section {
    padding: 80px 0;
    background: var(--bg-white);
  }

  .history_era_section.alternate_bg {
    background: var(--bg-light);
  }

  .history_era_grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 50px;
    align-items: center;
  }

  .history_era_grid.reverse {
    grid-template-columns: 1fr 1.2fr;
  }

  .history_era_grid.reverse .era_media {
    order: 1;
  }

  .history_era_grid.reverse .era_text {
    order: 2;
  }

  .era_year {
    display: inline-block;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1.5px;
    color: var(--accent-gold-hover);
    background: rgba(0, 33, 71, 0.07);
    padding: 6px 14px;
    border-radius: 20px;
    margin-bottom: 14px;
  }

  .era_title {
    font-size: clamp(26px, 3.2vw, 36px);
    color: var(--primary-color);
    margin-bottom: 18px;
    line-height: 1.3;
  }

  .era_lead {
    font-size: 17px;
    font-weight: 600;
    line-height: 1.65;
    color: var(--primary-light);
    margin-bottom: 16px;
  }

  .era_body {
    font-size: 15px;
    line-height: 1.8;
    color: var(--text-muted);
    margin-bottom: 16px;
  }

  .quote_box {
    background: rgba(0, 33, 71, 0.04);
    border-left: 4px solid var(--accent-gold);
    padding: 18px 22px;
    font-style: italic;
    color: var(--primary-color);
    font-size: 15px;
    line-height: 1.6;
    margin-top: 20px;
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  }

  .image_frame {
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    background: #ffffff;
    border: 4px solid #ffffff;
  }

  .image_frame img {
    width: 100%;
    height: 320px;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .image_frame:hover img {
    transform: scale(1.02);
  }

  .img_caption {
    display: block;
    font-size: 12.5px;
    color: var(--text-muted);
    padding: 10px 14px;
    background: #ffffff;
    text-align: center;
    border-top: 1px solid var(--border-light);
    font-weight: 500;
  }

  .dual_images {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .dual_images .image_frame img {
    height: 200px;
  }

  @media (max-width: 900px) {
    .history_era_grid,
    .history_era_grid.reverse {
      grid-template-columns: 1fr;
    }

    .history_era_grid.reverse .era_media {
      order: 2;
    }

    .history_era_grid.reverse .era_text {
      order: 1;
    }
  }
</style>
