---
import Layout from '../layouts/Layout.astro';
import { getMediaUrl } from '../utils/media';

const facilities = [
  {
    title: "Well-Ventilated Classrooms",
    category: "Academic Environment",
    image: "/images/batch3/classrooms_junior.jpg",
    desc: "Ergonomically designed, airy classrooms furnished with multimedia smart boards, climate control, and vibrant student-friendly interiors."
  },
  {
    title: "Gymnasium & Indoor Fitness",
    category: "Physical Fitness",
    image: "/images/batch3/gym.jpg",
    desc: "State-of-the-art indoor fitness gymnasium equipped with modern strength machines, cardio units, and dedicated physical training instructors."
  },
  {
    title: "Olympic-Standard Swimming Pool",
    category: "Aquatics",
    image: "/images/batch3/swimming_pool.jpg",
    desc: "Heated, hygienic, full-sized aquatic facility staffed with certified lifeguards and professional national swim coaches."
  },
  {
    title: "Tennis Courts & Multi-Sport Arena",
    category: "Racquet Sports",
    image: "/images/batch3/tennis_court.jpg",
    desc: "Professional hardcourt tennis grounds, badminton courts, and basketball courts hosting inter-house and inter-school championships."
  },
  {
    title: "College & Research Libraries",
    category: "Learning Resources",
    image: "/images/batch3/library_college.jpg",
    desc: "Expansive repositories housing over 40,000 volumes, international academic journals, digital cataloging, and quiet study alcoves."
  },
  {
    title: "Advanced IT & Computer Labs",
    category: "Digital Technology",
    image: "/images/batch3/computer_lab.jpg",
    desc: "High-speed networked computing laboratories equipped with modern hardware, Python/C++ development environments, and high-speed fiber internet."
  },
  {
    title: "Multimedia Lecture Theatres",
    category: "Conferences & Seminars",
    image: "/images/batch3/lecture_theater.jpg",
    desc: "Tiered executive lecture halls featuring high-definition projection systems, surround acoustics, and presentation podiums."
  },
  {
    title: "Modern Science Laboratories",
    category: "Practical Research",
    image: "/images/batch3/science_lab.jpg",
    desc: "Individual, purpose-built laboratory complexes for Physics, Chemistry, and Biology complying with strict international safety protocols."
  },
  {
    title: "On-Campus Medical Clinic",
    category: "Healthcare & Safety",
    image: "/images/batch3/clinic.jpg",
    desc: "Fully staffed on-campus infirmary providing immediate first aid, licensed doctor/nurse supervision, and annual student health screenings."
  },
  {
    title: "Faculty Training Centre",
    category: "Professional Development",
    image: "/images/batch3/training_centre.jpg",
    desc: "Dedicated continuing education facility hosting Cambridge PDQ modules, teacher workshops, and pedagogical innovation roundtables."
  },
  {
    title: "Central School Mosque",
    category: "Spiritual Reflection",
    image: "/images/batch3/mosque.jpg",
    desc: "Spacious, serene campus mosque accommodating thousands of congregants for daily and Friday prayers in an atmosphere of tranquility."
  },
  {
    title: "Sprawling Green Sports Grounds",
    category: "Outdoor Athletics",
    image: "/images/batch3/sports_grounds.jpg",
    desc: "Lush 8-acre open athletic fields accommodating cricket pitches, football turf, track and field races, and annual sports days."
  },
  {
    title: "Grand Central Auditorium",
    category: "Arts & Assemblies",
    image: "/images/batch3/auditorium.jpg",
    desc: "Acoustically engineered mega-auditorium seating over 1,500 people for drama festivals, debates, convocations, and cultural pageants."
  },
  {
    title: "Faculty Daycare Facility",
    category: "Staff Welfare",
    image: "/images/batch3/daycare.jpg",
    desc: "Safe, cheerful early childhood creche supporting working mothers on the faculty with certified caregivers and stimulating activity toys."
  },
  {
    title: "Innovation & Robotics Incubator",
    category: "STEM & Future Tech",
    image: "/images/batch3/robotics.jpg",
    desc: "Equipped with robotics toolkits, 3D printers, sensor electronics, and competitive FIRST LEGO League testing arenas."
  }
];
---

<Layout 
  title="Campus Facilities & Infrastructure – Crescent School"
  description="Discover the world-class campus facilities at Crescent School Lahore. Olympic swimming pool, gym, tennis courts, science labs, libraries, auditorium, and sports grounds."
>
  <!-- Standard Top Page Hero Banner -->
  <section class="page_hero_banner">
    <div class="container">
      <div class="hero_breadcrumbs">
        <a href="/">Home</a>
        <span>/</span>
        <span>Life at Crescent</span>
        <span>/</span>
        <span class="current">Facilities</span>
      </div>
      <h1 class="hero_page_title">Campus Facilities & Infrastructure</h1>
      <p class="hero_subtitle">An expansive 8-acre premier academic and athletic ecosystem designed to nurture body, mind, and spirit.</p>
    </div>
  </section>

  <!-- Facilities Overview -->
  <section class="facilities_intro_section">
    <div class="container">
      <div class="intro_box_center">
        <span class="sub_badge">WORLD-CLASS INFRASTRUCTURE</span>
        <h2 class="section_title">A Unique Blend of Tradition & Modernism</h2>
        <div class="title-decorator"></div>
        <p>
          Life at Crescent Model Higher Secondary School is enriched by a comprehensive array of physical, academic, and co-curricular infrastructure. From Olympic-standard aquatic arenas and sprawling athletic grounds to advanced robotics incubators and serene spiritual sanctuaries, every facility is meticulously maintained to provide an empowering environment for our 9,000+ scholars.
        </p>
      </div>

      <!-- Facilities Grid -->
      <div class="facilities_grid">
        {facilities.map((fac) => (
          <div class="facility_card">
            <div class="facility_media">
              <img 
                src={getMediaUrl(fac.image)} 
                alt={fac.title} 
                loading="lazy" 
                onerror="this.src='/images/hero_slider_1.jpg'"
              />
              <span class="facility_category">{fac.category}</span>
            </div>
            <div class="facility_content">
              <h3>{fac.title}</h3>
              <p>{fac.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .sub_badge {
    display: inline-block;
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: var(--primary-color);
    background: rgba(0, 33, 71, 0.08);
    padding: 5px 12px;
    border-radius: 16px;
    margin-bottom: 12px;
    text-transform: uppercase;
  }

  .facilities_intro_section {
    padding: 80px 0 100px;
    background: var(--bg-light);
  }

  .intro_box_center {
    text-align: center;
    max-width: 820px;
    margin: 0 auto 50px;
  }

  .intro_box_center p {
    font-size: 16px;
    line-height: 1.8;
    color: var(--text-muted);
  }

  .facilities_grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 30px;
  }

  .facility_card {
    background: #ffffff;
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--border-light);
    display: flex;
    flex-direction: column;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .facility_card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-lg);
    border-color: var(--accent-gold);
  }

  .facility_media {
    position: relative;
    width: 100%;
    height: 220px;
    background: #f1f5f9;
    overflow: hidden;
  }

  .facility_media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .facility_card:hover .facility_media img {
    transform: scale(1.06);
  }

  .facility_category {
    position: absolute;
    bottom: 12px;
    left: 12px;
    background: rgba(0, 33, 71, 0.85);
    color: var(--accent-gold);
    font-size: 11px;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 10px;
    letter-spacing: 0.5px;
    backdrop-filter: blur(4px);
    text-transform: uppercase;
  }

  .facility_content {
    padding: 24px 20px;
    border-top: 3px solid var(--accent-gold);
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .facility_content h3 {
    font-size: 18px;
    color: var(--primary-color);
    margin-bottom: 8px;
    font-family: var(--font-heading);
    line-height: 1.35;
  }

  .facility_content p {
    font-size: 13.5px;
    line-height: 1.65;
    color: var(--text-muted);
  }
</style>
