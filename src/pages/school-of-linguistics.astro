---
import Layout from '../layouts/Layout.astro';
import { getMediaUrl } from '../utils/media';

const languages = [
  {
    name: "French (Français)",
    level: "A1 – B2 DELF/DALF",
    partner: "Alliance Française de Lahore",
    desc: "Comprehensive French language immersion covering conversational fluency, grammar mastery, and diplomatic cultural exchange. Direct pathways to Francophone universities.",
    icon: "FR"
  },
  {
    name: "German (Deutsch)",
    level: "A1 – B1 Goethe-Zertifikat",
    partner: "European Academic Pathway",
    desc: "Rigorous German linguistic foundation emphasizing technical vocabulary, reading comprehension, and oral conversation tailored for European higher education.",
    icon: "DE"
  },
  {
    name: "Mandarin Chinese (中文)",
    level: "HSK Levels 1 – 3",
    partner: "Global Commerce & Tech",
    desc: "Mastery of Pinyin, Chinese Hanzi characters, tonal pronunciation, and contemporary business dialogue for the 21st-century global economy.",
    icon: "CN"
  },
  {
    name: "Classical Arabic (العربية)",
    level: "Quranic & Modern Standard",
    partner: "Cultural & Theological Heritage",
    desc: "In-depth Arabic grammar (Sarf & Nahw), classical Quranic vocabulary, comprehension of classical texts, and conversational Arab diplomacy.",
    icon: "AR"
  }
];
---

<Layout 
  title="School of Linguistics – Crescent School"
  description="Discover the School of Linguistics at Crescent School. Immersive foreign language programmes in French, German, Mandarin Chinese, and Arabic for global leadership and diplomacy."
>
  <!-- Standard Top Page Hero Banner -->
  <section class="page_hero_banner">
    <div class="container">
      <div class="hero_breadcrumbs">
        <a href="/">Home</a>
        <span>/</span>
        <span>Our Institution</span>
        <span>/</span>
        <span>Schools of Renaissance</span>
        <span>/</span>
        <span class="current">School of Linguistics</span>
      </div>
      <h1 class="hero_page_title">School of Linguistics</h1>
      <p class="hero_subtitle">Cultivating multilingual fluency, cross-cultural diplomacy, and global communication agility for future international leaders.</p>
    </div>
  </section>

  <!-- Overview Section -->
  <section class="linguistics_intro_section">
    <div class="container">
      <div class="intro_grid">
        <div class="intro_text">
          <span class="sub_badge">GLOBAL COMMUNICATIVE MASTERY</span>
          <h2 class="section_heading">Unlocking the World Through Multilingual Competence</h2>
          <div class="lead_text">
            Keeping the need for deep intellectual understanding and international diplomacy in mind, German, Mandarin Chinese, French, and Classical Arabic have been integrated into the student curriculum.
          </div>
          <p class="body_paragraph">
            Learning foreign languages not only enhances neuro-plasticity, critical thinking, and working memory, but also equips students with an indispensable passport to global higher education, diplomatic careers, and international commerce.
          </p>
          <p class="body_paragraph">
            The School of Linguistics features digital language laboratories, native listening suites, and conversational club environments where language is experienced dynamically through debate, cinema, cultural festivals, and certified international testing.
          </p>

          <div class="linguistics_pillars">
            <div class="lp_item">
              <span class="lp_check">✓</span>
              <div>
                <strong>Accredited Certifications:</strong> Preparing students for DELF/DALF (French), Goethe-Zertifikat (German), and HSK (Mandarin).
              </div>
            </div>
            <div class="lp_item">
              <span class="lp_check">✓</span>
              <div>
                <strong>Multimedia Phonetic Labs:</strong> Dedicated audio stations with noise-canceling headsets for accent calibration and auditory drills.
              </div>
            </div>
            <div class="lp_item">
              <span class="lp_check">✓</span>
              <div>
                <strong>Global University Pathways:</strong> Fulfilling foreign language admissions requirements for elite Ivy League, European, and Oxbridge institutions.
              </div>
            </div>
          </div>
        </div>

        <div class="intro_media">
          <div class="media_card">
            <img 
              src={getMediaUrl("/images/partner_alliance.png")} 
              alt="Alliance Française Language Partnership" 
              loading="lazy"
              style="padding: 30px; object-fit: contain; max-height: 220px;"
            />
            <span class="media_caption">Official collaboration with Alliance Française de Lahore</span>
          </div>
          <div class="media_card">
            <img 
              src={getMediaUrl("/images/batch3/library_college.jpg")} 
              alt="Language Research & Digital Lab" 
              loading="lazy"
              onerror="this.src='/images/welcome_side.jpg'"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Language Tracks -->
  <section class="languages_section">
    <div class="container">
      <div class="section_header_center">
        <span class="sub_badge">LANGUAGE TRACKS</span>
        <h2 class="section_title">Foreign Language Offerings</h2>
        <div class="title-decorator"></div>
      </div>

      <div class="languages_grid">
        {languages.map((lang) => (
          <div class="lang_card">
            <div class="lang_header">
              <div class="flag_badge">{lang.icon}</div>
              <div>
                <span class="cert_badge">{lang.level}</span>
                <h3>{lang.name}</h3>
              </div>
            </div>
            <p class="lang_partner">Partner: <strong>{lang.partner}</strong></p>
            <p class="lang_desc">{lang.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .sub_badge {
    display: inline-block;
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: var(--primary-color);
    background: rgba(0, 33, 71, 0.08);
    padding: 5px 12px;
    border-radius: 16px;
    margin-bottom: 12px;
    text-transform: uppercase;
  }

  .linguistics_intro_section {
    padding: 80px 0;
    background: var(--bg-white);
  }

  .intro_grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 50px;
    align-items: center;
  }

  .section_heading {
    font-size: clamp(26px, 3.2vw, 36px);
    color: var(--primary-color);
    margin-bottom: 18px;
    line-height: 1.3;
  }

  .lead_text {
    font-size: 17px;
    font-weight: 600;
    line-height: 1.65;
    color: var(--primary-light);
    margin-bottom: 16px;
  }

  .body_paragraph {
    font-size: 15px;
    line-height: 1.8;
    color: var(--text-muted);
    margin-bottom: 16px;
  }

  .linguistics_pillars {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-top: 24px;
  }

  .lp_item {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-dark);
  }

  .lp_check {
    color: var(--accent-gold-hover);
    font-weight: 800;
    font-size: 16px;
  }

  .intro_media {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .media_card {
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    background: #ffffff;
    border: 4px solid #ffffff;
  }

  .media_card img {
    width: 100%;
    height: 240px;
    object-fit: cover;
  }

  .media_caption {
    display: block;
    font-size: 12px;
    color: var(--text-muted);
    padding: 8px 12px;
    background: #ffffff;
    text-align: center;
  }

  .languages_section {
    padding: 80px 0 100px;
    background: var(--bg-light);
  }

  .section_header_center {
    text-align: center;
    max-width: 700px;
    margin: 0 auto 50px;
  }

  .languages_grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 28px;
  }

  .lang_card {
    background: #ffffff;
    border-radius: var(--radius-md);
    padding: 34px 26px;
    border: 1px solid var(--border-light);
    box-shadow: var(--shadow-sm);
    transition: all 0.3s ease;
    border-top: 4px solid var(--accent-gold);
  }

  .lang_card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-lg);
  }

  .lang_header {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 16px;
  }

  .flag_badge {
    width: 48px;
    height: 48px;
    background: var(--primary-gradient);
    color: var(--accent-gold);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 15px;
    flex-shrink: 0;
  }

  .cert_badge {
    font-size: 11px;
    font-weight: 700;
    color: var(--accent-teal);
    background: rgba(3, 106, 109, 0.08);
    padding: 3px 8px;
    border-radius: 8px;
    display: inline-block;
    margin-bottom: 4px;
  }

  .lang_header h3 {
    font-size: 18px;
    color: var(--primary-color);
  }

  .lang_partner {
    font-size: 13px;
    color: var(--text-dark);
    margin-bottom: 10px;
  }

  .lang_desc {
    font-size: 13.5px;
    line-height: 1.65;
    color: var(--text-muted);
  }

  @media (max-width: 900px) {
    .intro_grid {
      grid-template-columns: 1fr;
    }
  }
</style>
