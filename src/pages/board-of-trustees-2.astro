---
import Layout from '../layouts/Layout.astro';
import { getMediaUrl } from '../utils/media';

const chairman = {
  name: "Justice (R) Karamat Nazir Bhandari",
  role: "Chairman",
  image: "/images/batch2/Justice-R-Karamat-Nazir-Bhandari.png",
  bio: "Distinguished jurist, former Judge of the Supreme Court of Pakistan and Lahore High Court, providing visionary legal and strategic governance to the Crescent Educational Trust."
};

const trustees = [
  { name: "Mr. Ahsan Bashir", role: "Member", image: "/images/batch2/Mr.-Ahsan-Bashir.png" },
  { name: "Mr. Altaf Muhammad Saleem", role: "Managing Trustee / Secretary", image: "/images/batch2/Mr.-Altaf-Muhammad-Saleem.png" },
  { name: "Dr. Attiya Inayatullah", role: "Member", image: "/images/batch2/Ms.-Attiya-Inayatullah.png" },
  { name: "Mr. Humayun Mazhar", role: "Member", image: "/images/batch2/Mr.-Humayun-Mazhar.png" },
  { name: "Mr. Khalid Bashir", role: "Member", image: "/images/batch2/Mr.-Khalid-Bashir-1.png" },
  { name: "Mr. Muhammad Anwar", role: "Member", image: "/images/batch2/Muhammad-Anwer-1.png" },
  { name: "Mr. Muhammad Javed Amin", role: "Member", image: "/images/batch2/Mr.-Muhammad-Javed-Amin.png" },
  { name: "Dr. Ain ul Momina", role: "Member", image: "/images/batch2/Dr-Ain-ul-Momina.png" }
];
---

<Layout 
  title="Board of Trustees – Crescent Educational Trust"
  description="Meet the esteemed Board of Trustees of the Crescent Educational Trust, governing Crescent Model Higher Secondary School with unwavering integrity, stewardship, and philanthropic dedication."
>
  <!-- Standard Top Page Hero Banner -->
  <section class="page_hero_banner">
    <div class="container">
      <div class="hero_breadcrumbs">
        <a href="/">Home</a>
        <span>/</span>
        <span>Our Institution</span>
        <span>/</span>
        <span class="current">Board of Trustees</span>
      </div>
      <h1 class="hero_page_title">Board of Trustees</h1>
      <p class="hero_subtitle">Eminent business leaders, jurists, scholars, and philanthropists upholding the founding trust since 1968.</p>
    </div>
  </section>

  <!-- Governance Introduction -->
  <section class="trustees_intro_section">
    <div class="container">
      <div class="intro_box_center">
        <span class="sub_badge">INSTITUTIONAL STEWARDSHIP</span>
        <h2 class="section_title">Governing with Purpose & Trust</h2>
        <div class="title-decorator"></div>
        <p>
          The <strong>Crescent Educational Trust</strong> was constituted by the founding leaders of the Crescent Group to ensure that Crescent Model Higher Secondary School remains in perpetuity a non-profit, student-centric, and academically elite sanctuary. The Board of Trustees provides sovereign governance, fiduciary oversight, and strategic guidance.
        </p>
      </div>

      <!-- Chairman Showcase -->
      <div class="chairman_feature_card">
        <div class="chairman_img_box">
          <img 
            src={getMediaUrl(chairman.image)} 
            alt={chairman.name} 
            loading="lazy" 
            onerror="this.src='/images/cs_logo.png'"
          />
        </div>
        <div class="chairman_details">
          <span class="badge_role gold">{chairman.role}</span>
          <h2 class="chair_name">{chairman.name}</h2>
          <p class="chair_title">Chairman, Crescent Educational Trust</p>
          <div class="chair_bio">
            <p>{chairman.bio}</p>
          </div>
          <div class="chair_action">
            <a href="/message-from-the-chairman-crescent-educational-trust/" class="btn_text_link">
              Read Chairman's Official Message →
            </a>
          </div>
        </div>
      </div>

      <!-- Trustees Grid -->
      <div class="trustees_subheading">
        <span class="sub_badge">MEMBERS OF THE TRUST</span>
        <h3>Eminent Board Members</h3>
        <div class="title-decorator left"></div>
      </div>

      <div class="trustees_grid">
        {trustees.map((trustee) => (
          <div class="trustee_card">
            <div class="trustee_photo">
              <img 
                src={getMediaUrl(trustee.image)} 
                alt={trustee.name} 
                loading="lazy" 
                onerror="this.src='/images/cs_logo.png'"
              />
            </div>
            <div class="trustee_info">
              <h4>{trustee.name}</h4>
              <span class="trustee_role">{trustee.role}</span>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>
</Layout>

<style>
  .sub_badge {
    display: inline-block;
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: var(--primary-color);
    background: rgba(0, 33, 71, 0.08);
    padding: 5px 12px;
    border-radius: 16px;
    margin-bottom: 12px;
    text-transform: uppercase;
  }

  .trustees_intro_section {
    padding: 80px 0 100px;
    background: var(--bg-light);
  }

  .intro_box_center {
    text-align: center;
    max-width: 820px;
    margin: 0 auto 50px;
  }

  .intro_box_center p {
    font-size: 16px;
    line-height: 1.8;
    color: var(--text-muted);
  }

  .chairman_feature_card {
    background: #ffffff;
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    border: 1px solid var(--border-light);
    display: grid;
    grid-template-columns: 320px 1fr;
    margin-bottom: 70px;
    border-top: 4px solid var(--accent-gold);
  }

  .chairman_img_box {
    background: #f1f5f9;
    height: 100%;
    min-height: 340px;
  }

  .chairman_img_box img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .chairman_details {
    padding: 40px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .badge_role {
    display: inline-block;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1px;
    padding: 5px 14px;
    border-radius: 14px;
    margin-bottom: 10px;
    width: fit-content;
    text-transform: uppercase;
  }

  .badge_role.gold {
    background: rgba(253, 200, 0, 0.18);
    color: #9a7200;
  }

  .chair_name {
    font-size: clamp(24px, 3vw, 32px);
    color: var(--primary-color);
    margin-bottom: 4px;
  }

  .chair_title {
    font-size: 14px;
    color: var(--text-muted);
    font-weight: 600;
    margin-bottom: 18px;
  }

  .chair_bio p {
    font-size: 15px;
    line-height: 1.7;
    color: var(--text-dark);
    margin-bottom: 24px;
  }

  .btn_text_link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--primary-color);
    font-weight: 700;
    font-size: 14.5px;
    transition: color 0.2s ease;
  }

  .btn_text_link:hover {
    color: var(--accent-gold-hover);
  }

  .trustees_subheading {
    margin-bottom: 30px;
  }

  .trustees_subheading h3 {
    font-size: 24px;
    color: var(--primary-color);
    margin-bottom: 8px;
  }

  .title-decorator.left {
    margin: 0 0 24px 0;
  }

  .trustees_grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 26px;
  }

  .trustee_card {
    background: #ffffff;
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--border-light);
    display: flex;
    flex-direction: column;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .trustee_card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-lg);
    border-color: var(--accent-gold);
  }

  .trustee_photo {
    width: 100%;
    height: 280px;
    background: #f8fafc;
    overflow: hidden;
  }

  .trustee_photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: transform 0.4s ease;
  }

  .trustee_card:hover .trustee_photo img {
    transform: scale(1.05);
  }

  .trustee_info {
    padding: 20px 16px;
    text-align: center;
    border-top: 3px solid var(--accent-gold);
    display: flex;
    flex-direction: column;
    flex: 1;
    justify-content: center;
  }

  .trustee_info h4 {
    font-size: 16px;
    color: var(--primary-color);
    margin-bottom: 6px;
    line-height: 1.35;
  }

  .trustee_role {
    font-size: 12.5px;
    color: var(--text-muted);
    font-weight: 600;
  }

  @media (max-width: 900px) {
    .chairman_feature_card {
      grid-template-columns: 1fr;
    }

    .chairman_img_box {
      height: 320px;
    }

    .chairman_details {
      padding: 26px 20px;
    }
  }
</style>
