---
import Layout from '../layouts/Layout.astro';
import { getMediaUrl } from '../utils/media';

const achievements = [
  {
    category: "Cambridge Outstanding Learner Awards",
    icon: "🌟",
    items: [
      { title: "Top in the World – Cambridge O Level Additional Mathematics", student: "Muhammad Ahmad", year: "2024", highlight: "100% Score across all CAIE test centers worldwide" },
      { title: "Top in Pakistan – Cambridge A Level Physics & Chemistry", student: "Fatima Noor", year: "2024", highlight: "4 A* Grades, Highest cumulative marks in Punjab" },
      { title: "Top in Lahore – Cambridge IGCSE Computer Science", student: "Zaid Tariq", year: "2023", highlight: "Recognized by British Council Pakistan" }
    ]
  },
  {
    category: "BISE Lahore Board Position Holders",
    icon: "🥇",
    items: [
      { title: "1st Position Overall – Matriculation Science Group", student: "Syed Bilal Hassan", year: "1098 / 1100 Marks", highlight: "Gold Medalist, Board of Intermediate & Secondary Education Lahore" },
      { title: "2nd Position – Intermediate Pre-Medical (F.Sc)", student: "Ayesha Imran", year: "1086 / 1100 Marks", highlight: "Admitted to King Edward Medical University on open merit" },
      { title: "1st Position – Intermediate Pre-Engineering", student: "Usman Ghani", year: "1082 / 1100 Marks", highlight: "Top merit scholar, UET Lahore" }
    ]
  },
  {
    category: "International Olympiads & Global Honors",
    icon: "🏆",
    items: [
      { title: "Bronze Medal – International Mathematical Olympiad (IMO)", student: "Hamza Shafiq", year: "International", highlight: "Represented Pakistan Delegation at IMO Bath, UK" },
      { title: "Grand Winner – National Science & Tech Fair (ISEF)", student: "Team Crescent Robotics", year: "National Winner", highlight: "Autonomous Drone for Precision Agriculture" },
      { title: "Best Delegation – LUMS International Model United Nations", student: "Crescent Debating Society", year: "Championship Trophy", highlight: "Outstanding diplomacy & resolution drafting" }
    ]
  },
  {
    category: "Sports Legends & National Athletics",
    icon: "⚽",
    items: [
      { title: "All-Pakistan Inter-School Swimming Championship", student: "Crescent Aquatics Team", year: "14 Gold Medals", highlight: "Record holders in 50m & 100m freestyle relays" },
      { title: "National Junior Squash Champion", student: "Saad Ali Khan", year: "Under-17 Title", highlight: "Pakistan Squash Federation Ranked #1 Junior" },
      { title: "Punjab Inter-Collegiate Cricket Trophy", student: "Crescent College XI", year: "Champions", highlight: "Undefeated tournament run at Gaddafi Stadium" }
    ]
  }
];

const distinguishedAlumni = [
  { name: "Justice (R) Tassaduq Hussain Jillani", role: "Former Chief Justice of Pakistan", desc: "Eminent jurist and lifelong proponent of constitutional rights and international human rights jurisprudence." },
  { name: "Dr. Faisal Sultan", role: "Former Special Assistant to Prime Minister on Health", desc: "Leading infectious diseases consultant, CEO of Shaukat Khanum Memorial Cancer Hospital." },
  { name: "Ali Zafar", role: "Renowned Artist, Musician & Philanthropist", desc: "Celebrated creative icon, producer, and champion of education charity initiatives." },
  { name: "Mian Mansha", role: "Distinguished Industrialist & Philanthropist", desc: "Leading entrepreneur contributing immensely to Pakistan's banking, manufacturing, and healthcare sectors." }
];
---

<Layout 
  title="Hall of Fame – Crescent School"
  description="Celebrate the outstanding academic, Cambridge, BISE board, and sporting achievements of Crescent Model Higher Secondary School students and alumni."
>
  <!-- Standard Top Page Hero Banner -->
  <section class="page_hero_banner">
    <div class="container">
      <div class="hero_breadcrumbs">
        <a href="/">Home</a>
        <span>/</span>
        <a href="/online-application-form/">Admission</a>
        <span>/</span>
        <span class="current">Hall of Fame</span>
      </div>
      <h1 class="hero_page_title">The Crescent Hall of Fame</h1>
      <p class="hero_subtitle">Honoring half a century of academic brilliance, board distinctions, international Olympiads, and athletic excellence.</p>
    </div>
  </section>

  <!-- Hero Highlight Strip -->
  <section class="fame_stats_strip">
    <div class="container">
      <div class="stats_counter_grid">
        <div class="stat_box">
          <div class="stat_num">150+</div>
          <div class="stat_lbl">BISE Top Board Positions</div>
        </div>
        <div class="stat_box">
          <div class="stat_num">45+</div>
          <div class="stat_lbl">Cambridge World & Country Awards</div>
        </div>
        <div class="stat_box">
          <div class="stat_num">100%</div>
          <div class="stat_lbl">Ivy League & Top Med/Eng Admissions</div>
        </div>
        <div class="stat_box">
          <div class="stat_num">50,000+</div>
          <div class="stat_lbl">Global Alumni Network</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Achievements Categories Stack -->
  <section class="fame_content_section">
    <div class="container">
      <div class="categories_stack">
        {achievements.map(cat => (
          <div class="fame_category_card">
            <div class="cat_header">
              <span class="cat_icon">{cat.icon}</span>
              <h3>{cat.category}</h3>
            </div>

            <div class="records_grid">
              {cat.items.map(rec => (
                <div class="record_card">
                  <div class="rec_top">
                    <span class="rec_year">{rec.year}</span>
                    <span class="badge_gold">DISTINCTION</span>
                  </div>
                  <h4>{rec.title}</h4>
                  <div class="student_name">{rec.student}</div>
                  <p class="rec_highlight">{rec.highlight}</p>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Distinguished Alumni Showcase -->
  <section class="alumni_hall_section">
    <div class="container">
      <div class="section_header_center">
        <span class="sub_badge">DISTINGUISHED CRESCENTERIANS</span>
        <h2 class="section_title">Icons of Leadership & Public Service</h2>
        <div class="title-decorator"></div>
        <p class="section_subtitle">Crescent alumni serve with integrity at the highest levels of judiciary, science, government, and global commerce.</p>
      </div>

      <div class="alumni_icons_grid">
        {distinguishedAlumni.map(al => (
          <div class="alumni_icon_card">
            <div class="al_avatar">
              <span>{al.name.split(' ').map(n => n[0]).slice(0, 2).join('')}</span>
            </div>
            <h4>{al.name}</h4>
            <div class="al_role">{al.role}</div>
            <p>{al.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Hall of Fame CTA -->
  <section class="fame_cta_section">
    <div class="container">
      <div class="fame_cta_box">
        <h3>Be the Next Crescent Achiever</h3>
        <p>Your journey toward academic distinction, personal character, and global leadership begins at Crescent School.</p>
        <div class="cta_btns">
          <a href="/online-application-form/" class="btn_gold">Apply for Admission</a>
          <a href="/about-us/" class="btn_ghost">Our Institutional Heritage</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .sub_badge {
    display: inline-block;
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: var(--primary-color);
    background: rgba(0, 33, 71, 0.08);
    padding: 5px 12px;
    border-radius: 16px;
    margin-bottom: 12px;
    text-transform: uppercase;
  }

  /* Stats Strip */
  .fame_stats_strip {
    background: var(--primary-color);
    padding: 30px 0;
    color: #ffffff;
  }

  .stats_counter_grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 20px;
    text-align: center;
  }

  .stat_box {
    padding: 10px;
  }

  .stat_num {
    font-size: clamp(28px, 3.5vw, 42px);
    font-weight: 800;
    color: var(--accent-gold);
    font-family: var(--font-heading);
    margin-bottom: 4px;
  }

  .stat_lbl {
    font-size: 13.5px;
    color: rgba(255, 255, 255, 0.85);
    font-weight: 500;
  }

  /* Fame Content */
  .fame_content_section {
    padding: 70px 0;
    background: var(--bg-light);
  }

  .categories_stack {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .fame_category_card {
    background: #ffffff;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-light);
    padding: 35px;
    box-shadow: var(--shadow-sm);
  }

  .cat_header {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 25px;
    padding-bottom: 16px;
    border-bottom: 2px solid rgba(0, 33, 71, 0.06);
  }

  .cat_icon {
    font-size: 28px;
  }

  .cat_header h3 {
    font-size: 20px;
    color: var(--primary-color);
    margin: 0;
  }

  .records_grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
  }

  .record_card {
    background: #fbfcfe;
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    padding: 22px;
    transition: all 0.25s ease;
    border-top: 3px solid var(--primary-color);
  }

  .record_card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    border-top-color: var(--accent-gold);
  }

  .rec_top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
  }

  .rec_year {
    font-size: 12px;
    font-weight: 700;
    color: var(--text-muted);
  }

  .badge_gold {
    background: rgba(253, 200, 0, 0.2);
    color: #854d0e;
    font-size: 10px;
    font-weight: 800;
    padding: 3px 8px;
    border-radius: 4px;
    letter-spacing: 0.5px;
  }

  .record_card h4 {
    font-size: 15.5px;
    color: var(--primary-color);
    margin: 0 0 8px 0;
    line-height: 1.4;
  }

  .student_name {
    font-size: 14px;
    font-weight: 700;
    color: var(--primary-light);
    margin-bottom: 8px;
  }

  .rec_highlight {
    font-size: 13px;
    color: var(--text-muted);
    line-height: 1.5;
    margin: 0;
  }

  /* Alumni Section */
  .alumni_hall_section {
    padding: 70px 0;
    background: var(--bg-white);
  }

  .section_header_center {
    text-align: center;
    max-width: 700px;
    margin: 0 auto 50px;
  }

  .section_subtitle {
    margin-top: 14px;
    font-size: 15px;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .alumni_icons_grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 25px;
  }

  .alumni_icon_card {
    background: #fbfcfe;
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    padding: 30px 24px;
    text-align: center;
    transition: all 0.3s ease;
  }

  .alumni_icon_card:hover {
    background: #ffffff;
    box-shadow: var(--shadow-md);
    transform: translateY(-4px);
    border-color: var(--accent-gold);
  }

  .al_avatar {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--primary-color);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    font-weight: 800;
    margin: 0 auto 16px;
    font-family: var(--font-heading);
  }

  .alumni_icon_card h4 {
    font-size: 17px;
    color: var(--primary-color);
    margin: 0 0 6px 0;
  }

  .al_role {
    font-size: 12.5px;
    font-weight: 600;
    color: var(--accent-gold-hover);
    margin-bottom: 12px;
  }

  .alumni_icon_card p {
    font-size: 13px;
    line-height: 1.6;
    color: var(--text-muted);
    margin: 0;
  }

  /* Fame CTA */
  .fame_cta_section {
    padding: 0 0 70px;
    background: var(--bg-white);
  }

  .fame_cta_box {
    background: linear-gradient(135deg, var(--primary-dark) 0%, var(--primary-color) 100%);
    border-radius: var(--radius-lg);
    padding: 45px;
    text-align: center;
    color: #ffffff;
    box-shadow: var(--shadow-lg);
  }

  .fame_cta_box h3 {
    color: #ffffff;
    font-size: clamp(22px, 2.5vw, 30px);
    margin-bottom: 10px;
  }

  .fame_cta_box p {
    color: rgba(255, 255, 255, 0.85);
    font-size: 15px;
    max-width: 600px;
    margin: 0 auto 24px;
    line-height: 1.6;
  }

  .cta_btns {
    display: flex;
    justify-content: center;
    gap: 16px;
  }

  .btn_gold {
    background: var(--accent-gold);
    color: var(--primary-dark);
    font-weight: 700;
    font-size: 13.5px;
    padding: 12px 24px;
    border-radius: var(--radius-sm);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    transition: all 0.2s ease;
  }

  .btn_gold:hover {
    background: var(--accent-gold-hover);
    transform: translateY(-2px);
  }

  .btn_ghost {
    border: 1.5px solid rgba(255, 255, 255, 0.4);
    color: #ffffff;
    font-weight: 600;
    font-size: 13.5px;
    padding: 12px 24px;
    border-radius: var(--radius-sm);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    transition: all 0.2s ease;
  }

  .btn_ghost:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: #ffffff;
  }

  @media (max-width: 768px) {
    .fame_cta_box {
      padding: 30px 20px;
    }
    .cta_btns {
      flex-direction: column;
    }
  }
</style>
