---
import Layout from '../layouts/Layout.astro';
import { getMediaUrl } from '../utils/media';
---

<Layout 
  title="Senior School – Crescent School"
  description="Explore the Senior School at Crescent Model Higher Secondary School. Leading BISE Lahore Board distinctions, state-of-the-art science labs, and comprehensive matriculation preparation."
>
  <!-- Standard Top Page Hero Banner -->
  <section class="page_hero_banner">
    <div class="container">
      <div class="hero_breadcrumbs">
        <a href="/">Home</a>
        <span>/</span>
        <span>Academics</span>
        <span>/</span>
        <span class="current">Senior School</span>
      </div>
      <h1 class="hero_page_title">Senior School</h1>
      <p class="hero_subtitle">Cultivating academic mastery, board examination distinction, and sound character for future nation builders.</p>
    </div>
  </section>

  <!-- Overview Section -->
  <section class="academic_intro_section">
    <div class="container">
      <div class="intro_grid">
        <div class="intro_text">
          <span class="sub_badge">ACADEMIC PINNACLE</span>
          <h2 class="section_heading">Adding Value to Every Student's Achievement</h2>
          <div class="lead_text">
            We believe in adding profound value to our students' achievements by providing top-quality education so they gain admission into the country's most competitive professional colleges and universities.
          </div>
          <p class="body_paragraph">
            Emphasizing a well-balanced body of knowledge, analytical skills, and hands-on experiences, daily classroom instruction defines clear learning goals. In an atmosphere that fosters a lifelong love for learning, students are taught how to study effectively and are given the personal mentorship needed to construct an impregnable academic foundation.
          </p>
          <p class="body_paragraph">
            The Senior School maintains a celebrated, historic tradition of securing <strong>top positions in the Board of Intermediate and Secondary Education (BISE) Lahore</strong> every single year. We stimulate children’s capacity for critical thinking, conceptual clarity, and self-discipline.
          </p>

          <div class="highlights_list">
            <div class="highlight_item">
              <span class="check_icon">✓</span>
              <div>
                <strong>BISE Lahore Board Distinctions:</strong> Unbroken record of overall board positions and record-shattering A+ percentages.
              </div>
            </div>
            <div class="highlight_item">
              <span class="check_icon">✓</span>
              <div>
                <strong>Advanced Scientific Laboratories:</strong> Fully equipped individual Physics, Chemistry, and Biology practical suites.
              </div>
            </div>
            <div class="highlight_item">
              <span class="check_icon">✓</span>
              <div>
                <strong>Experienced Master Faculty:</strong> Highly trained pedagogical mentors monitoring individual progression at each stage.
              </div>
            </div>
          </div>
        </div>

        <div class="intro_media">
          <div class="media_card">
            <img 
              src={getMediaUrl("/images/batch3/senior.jpg")} 
              alt="Senior School Campus Life" 
              loading="lazy"
              onerror="this.src='/images/welcome_side.jpg'"
            />
            <span class="media_caption">Senior academic quadrangle and state-of-the-art facilities</span>
          </div>
          <div class="media_card">
            <img 
              src={getMediaUrl("/images/batch3/lab.jpg")} 
              alt="Senior Sciences Laboratory" 
              loading="lazy"
              onerror="this.src='/images/hero_slider_2.jpg'"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Curricular Focus Areas -->
  <section class="focus_areas_section">
    <div class="container">
      <div class="section_header_center">
        <span class="sub_badge">SUBJECT PATHWAYS</span>
        <h2 class="section_title">Senior Matriculation Streams (Classes IX & X)</h2>
        <div class="title-decorator"></div>
      </div>

      <div class="streams_grid">
        <div class="stream_card">
          <div class="stream_icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/>
              <path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/>
              <path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"/>
              <path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/>
            </svg>
          </div>
          <h3>Science Group (Biology)</h3>
          <p>Pre-Medical foundation emphasizing Physics, Chemistry, Biology, Mathematics, English, Urdu, and Islamiat / Pak Studies.</p>
        </div>

        <div class="stream_card">
          <div class="stream_icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
              <line x1="8" y1="21" x2="16" y2="21"/>
              <line x1="12" y1="17" x2="12" y2="21"/>
            </svg>
          </div>
          <h3>Science Group (Computer Science)</h3>
          <p>Pre-Engineering & Computing track combining Physics, Chemistry, Computer Science, Mathematics, and language requirements.</p>
        </div>

        <div class="stream_card">
          <div class="stream_icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"/>
              <path d="M12 6v6l4 2"/>
            </svg>
          </div>
          <h3>Extensive Mock Drills & Mentorship</h3>
          <p>Rigorous pre-board examinations, paper presentation calibration, and continuous diagnostic remediation ensure top ranks.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Photo Strip -->
  <section class="gallery_strip_section">
    <div class="container">
      <div class="gallery_grid">
        <div class="gallery_item">
          <img src={getMediaUrl("/images/batch3/basketball.jpg")} alt="Athletic Excellence" loading="lazy" />
        </div>
        <div class="gallery_item">
          <img src={getMediaUrl("/images/batch3/senior-a.jpg")} alt="Senior Classrooms" loading="lazy" />
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .sub_badge {
    display: inline-block;
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: var(--primary-color);
    background: rgba(0, 33, 71, 0.08);
    padding: 5px 12px;
    border-radius: 16px;
    margin-bottom: 12px;
    text-transform: uppercase;
  }

  .academic_intro_section {
    padding: 80px 0;
    background: var(--bg-white);
  }

  .intro_grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 50px;
    align-items: center;
  }

  .section_heading {
    font-size: clamp(26px, 3.2vw, 36px);
    color: var(--primary-color);
    margin-bottom: 18px;
    line-height: 1.3;
  }

  .lead_text {
    font-size: 17px;
    font-weight: 600;
    line-height: 1.65;
    color: var(--primary-light);
    margin-bottom: 16px;
  }

  .body_paragraph {
    font-size: 15px;
    line-height: 1.8;
    color: var(--text-muted);
    margin-bottom: 16px;
  }

  .highlights_list {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-top: 24px;
  }

  .highlight_item {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--text-dark);
  }

  .check_icon {
    color: var(--accent-gold-hover);
    font-weight: 800;
    font-size: 16px;
  }

  .intro_media {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .media_card {
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    background: #ffffff;
    border: 4px solid #ffffff;
  }

  .media_card img {
    width: 100%;
    height: 240px;
    object-fit: cover;
  }

  .media_caption {
    display: block;
    font-size: 12px;
    color: var(--text-muted);
    padding: 8px 12px;
    background: #ffffff;
    text-align: center;
  }

  .focus_areas_section {
    padding: 80px 0;
    background: var(--bg-light);
  }

  .section_header_center {
    text-align: center;
    max-width: 700px;
    margin: 0 auto 40px;
  }

  .streams_grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 28px;
  }

  .stream_card {
    background: #ffffff;
    border-radius: var(--radius-md);
    padding: 34px 26px;
    border: 1px solid var(--border-light);
    box-shadow: var(--shadow-sm);
    transition: all 0.3s ease;
  }

  .stream_card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-lg);
    border-color: var(--accent-gold);
  }

  .stream_icon {
    width: 48px;
    height: 48px;
    background: var(--primary-gradient);
    color: var(--accent-gold);
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 18px;
  }

  .stream_card h3 {
    font-size: 18px;
    color: var(--primary-color);
    margin-bottom: 10px;
  }

  .stream_card p {
    font-size: 14px;
    line-height: 1.65;
    color: var(--text-muted);
  }

  .gallery_strip_section {
    padding: 0 0 80px;
    background: var(--bg-light);
  }

  .gallery_grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }

  .gallery_item {
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    border: 4px solid #ffffff;
  }

  .gallery_item img {
    width: 100%;
    height: 280px;
    object-fit: cover;
  }

  @media (max-width: 900px) {
    .intro_grid,
    .gallery_grid {
      grid-template-columns: 1fr;
    }
  }
</style>
