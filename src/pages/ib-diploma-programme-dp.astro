---
import Layout from '../layouts/Layout.astro';
import { getMediaUrl } from '../utils/media';
---

<Layout 
  title="IB Diploma Programme (DP) – Crescent School"
  description="Discover the prestigious International Baccalaureate (IB) Diploma Programme at Crescent School. A globally acclaimed 2-year pre-university credential recognized by elite world universities."
>
  <!-- Standard Top Page Hero Banner -->
  <section class="page_hero_banner">
    <div class="container">
      <div class="hero_breadcrumbs">
        <a href="/">Home</a>
        <span>/</span>
        <span>Academics</span>
        <span>/</span>
        <span class="current">IB Diploma Programme (DP)</span>
      </div>
      <h1 class="hero_page_title">IB Diploma Programme (DP)</h1>
      <p class="hero_subtitle">The global gold standard in pre-university education, cultivating academic depth, intellectual curiosity, and ethical conviction.</p>
    </div>
  </section>

  <!-- Authorization Feature Section -->
  <section class="auth_feature_section">
    <div class="container">
      <div class="auth_card">
        <div class="auth_logo">
          <img 
            src={getMediaUrl("/images/batch3/IB-DP-300x132.jpg")} 
            alt="Authorized IB World School Diploma Programme" 
            loading="lazy" 
            onerror="this.src='/images/partner_ib.jpg'"
          />
        </div>
        <div class="auth_text">
          <span class="badge_authorized">AUTHORIZED IB WORLD SCHOOL</span>
          <h2>An Authorized Global Gateway to Elite Higher Education</h2>
          <p class="auth_lead">
            Crescent Model Higher Secondary School, Lahore, is an authorized school for the <strong>International Baccalaureate (IB) Diploma Programme</strong>.
          </p>
          <p class="auth_body">
            The IB Diploma Programme (DP) is a rigorous, balanced, and internationally benchmarked two-year course of study for students aged 16 to 19. Respected by world-leading universities across the UK, USA, Canada, and Europe, the DP addresses the intellectual, emotional, and physical wellbeing of students.
          </p>
          <div class="disclaimer_note">
            For further official information regarding the International Baccalaureate and its programmes, visit <a href="https://www.ibo.org" target="_blank" rel="noopener">www.ibo.org</a>.
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- The DP Core -->
  <section class="dp_core_section">
    <div class="container">
      <div class="section_header_center">
        <span class="sub_badge">DISTINGUISHING PILLARS</span>
        <h2 class="section_title">The Three Pillars of the DP Core</h2>
        <div class="title-decorator"></div>
        <p class="section_subtitle">
          At the heart of the Diploma Programme are three unique compulsory components that broaden students' educational experience and challenge them to apply their knowledge.
        </p>
      </div>

      <div class="core_grid">
        <div class="core_card">
          <div class="core_icon">TOK</div>
          <h3>Theory of Knowledge (TOK)</h3>
          <p>An interdisciplinary requirement where students examine the nature of knowledge, reflect critically on diverse ways of knowing, and explore how we know what we claim to know.</p>
        </div>

        <div class="core_card">
          <div class="core_icon">EE</div>
          <h3>The Extended Essay</h3>
          <p>An independent, self-directed 4,000-word research paper on a topic of passionate interest, mentoring students in university-level analytical investigation and citation standards.</p>
        </div>

        <div class="core_card">
          <div class="core_icon">CAS</div>
          <h3>Creativity, Activity, Service</h3>
          <p>Engaging in experiential projects outside academia: arts and creative thinking, physical fitness and athletics, and compassionate unpaid community service.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Admission & Poster Callout -->
  <section class="admission_poster_section">
    <div class="container">
      <div class="poster_box_grid">
        <div class="poster_media">
          <img 
            src={getMediaUrl("/images/batch3/ib_admission_poster.png")} 
            alt="Crescent IB DP Admission Open" 
            loading="lazy" 
            onerror="this.src='/images/welcome_side.jpg'"
          />
        </div>
        <div class="poster_info">
          <span class="sub_badge">ADMISSION NOTICE</span>
          <h2>Enroll in the IB Diploma Programme</h2>
          <p>
            Admissions are open for eligible students who have completed their Matriculation, Cambridge O-Levels, or equivalent secondary schooling. Crescent School offers dedicated academic counseling, state-of-the-art sciences and IT infrastructure, and generous merit-based fee concessions.
          </p>
          <ul class="poster_benefits">
            <li>✓ Small classroom cohorts for personalized mentorship</li>
            <li>✓ Highly certified IB Workshop Leader faculty</li>
            <li>✓ Direct global university placement guidance</li>
            <li>✓ Modern digital laboratory suites and dedicated study hubs</li>
          </ul>
          <div class="action_btns">
            <a href="/online-application-form/" class="btn_gold">Apply Online Now</a>
            <a href="/contact-2/" class="btn_navy">Schedule Campus Visit</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .sub_badge {
    display: inline-block;
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: var(--primary-color);
    background: rgba(0, 33, 71, 0.08);
    padding: 5px 12px;
    border-radius: 16px;
    margin-bottom: 12px;
    text-transform: uppercase;
  }

  .auth_feature_section {
    padding: 80px 0;
    background: var(--bg-white);
  }

  .auth_card {
    background: #ffffff;
    border-radius: var(--radius-md);
    padding: 45px;
    box-shadow: var(--shadow-md);
    border: 1px solid var(--border-light);
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 40px;
    align-items: center;
    border-left: 6px solid var(--accent-gold);
  }

  .auth_logo img {
    max-width: 100%;
    height: auto;
    object-fit: contain;
  }

  .badge_authorized {
    display: inline-block;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1px;
    color: var(--accent-teal);
    background: rgba(3, 106, 109, 0.1);
    padding: 4px 12px;
    border-radius: 12px;
    margin-bottom: 10px;
  }

  .auth_text h2 {
    font-size: clamp(24px, 3vw, 32px);
    color: var(--primary-color);
    margin-bottom: 12px;
  }

  .auth_lead {
    font-size: 16.5px;
    line-height: 1.7;
    color: var(--primary-light);
    margin-bottom: 12px;
    font-weight: 600;
  }

  .auth_body {
    font-size: 15px;
    line-height: 1.75;
    color: var(--text-muted);
    margin-bottom: 18px;
  }

  .disclaimer_note {
    font-size: 12.5px;
    line-height: 1.6;
    color: #64748b;
    background: #f8fafc;
    padding: 12px 16px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-light);
  }

  .disclaimer_note a {
    color: var(--primary-color);
    font-weight: 600;
    text-decoration: underline;
  }

  .dp_core_section {
    padding: 80px 0;
    background: var(--bg-light);
  }

  .section_header_center {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 50px;
  }

  .section_subtitle {
    font-size: 16px;
    color: var(--text-muted);
  }

  .core_grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 28px;
  }

  .core_card {
    background: #ffffff;
    border-radius: var(--radius-md);
    padding: 38px 28px;
    border: 1px solid var(--border-light);
    box-shadow: var(--shadow-sm);
    border-top: 4px solid var(--accent-gold);
    transition: all 0.3s ease;
  }

  .core_card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-lg);
  }

  .core_icon {
    width: 50px;
    height: 50px;
    background: var(--primary-gradient);
    color: var(--accent-gold);
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 16px;
    margin-bottom: 18px;
    letter-spacing: 0.5px;
  }

  .core_card h3 {
    font-size: 19px;
    color: var(--primary-color);
    margin-bottom: 12px;
  }

  .core_card p {
    font-size: 14px;
    line-height: 1.7;
    color: var(--text-muted);
  }

  .admission_poster_section {
    padding: 80px 0 100px;
    background: var(--bg-white);
  }

  .poster_box_grid {
    display: grid;
    grid-template-columns: 360px 1fr;
    gap: 50px;
    align-items: center;
    background: var(--bg-light);
    border-radius: var(--radius-md);
    padding: 40px;
    border: 1px solid var(--border-light);
  }

  .poster_media {
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    background: #ffffff;
    border: 4px solid #ffffff;
  }

  .poster_media img {
    width: 100%;
    height: auto;
    display: block;
  }

  .poster_info h2 {
    font-size: 28px;
    color: var(--primary-color);
    margin-bottom: 14px;
  }

  .poster_info p {
    font-size: 15px;
    line-height: 1.75;
    color: var(--text-muted);
    margin-bottom: 20px;
  }

  .poster_benefits {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: 14px;
    color: var(--text-dark);
    margin-bottom: 28px;
    font-weight: 500;
  }

  .action_btns {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }

  .btn_gold {
    background: var(--accent-gold);
    color: var(--primary-dark);
    padding: 12px 24px;
    border-radius: var(--radius-sm);
    font-weight: 700;
    font-size: 14px;
    transition: all 0.2s ease;
  }

  .btn_gold:hover {
    background: var(--accent-gold-hover);
    transform: translateY(-2px);
  }

  .btn_navy {
    background: var(--primary-color);
    color: #ffffff;
    padding: 12px 24px;
    border-radius: var(--radius-sm);
    font-weight: 700;
    font-size: 14px;
    transition: all 0.2s ease;
  }

  .btn_navy:hover {
    background: var(--primary-light);
    transform: translateY(-2px);
  }

  @media (max-width: 900px) {
    .auth_card,
    .poster_box_grid {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .auth_logo img,
    .poster_media {
      margin: 0 auto;
    }

    .action_btns {
      justify-content: center;
    }
  }
</style>
