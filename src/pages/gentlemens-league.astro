---
import Layout from '../layouts/Layout.astro';
import { getMediaUrl } from '../utils/media';
---

<Layout 
  title="Gentlemen’s League – Crescent School"
  description="Discover the Gentlemen's League at Crescent School. Cultivating chivalry, executive protocol, emotional intelligence, and aristocratic sports: Fencing, Archery, Horse Riding, and Golf."
>
  <!-- Standard Top Page Hero Banner -->
  <section class="page_hero_banner">
    <div class="container">
      <div class="hero_breadcrumbs">
        <a href="/">Home</a>
        <span>/</span>
        <span>Our Institution</span>
        <span>/</span>
        <span>Schools of Renaissance</span>
        <span>/</span>
        <span class="current">Gentlemen’s League</span>
      </div>
      <h1 class="hero_page_title">Gentlemen’s League</h1>
      <p class="hero_subtitle">Molding honorable, cultured, and dignified young men who lead with integrity, chivalry, and athletic distinction.</p>
    </div>
  </section>

  <!-- Quote & Philosophy -->
  <section class="league_intro_section">
    <div class="container">
      <div class="quote_banner_box">
        <div class="quote_mark">“</div>
        <p class="quote_text">Being a true gentleman never goes out of style.</p>
        <span class="quote_author">— Crescent Gentlemen's Ethos</span>
      </div>

      <div class="intro_grid">
        <div class="intro_text">
          <span class="sub_badge">LEADERSHIP & CHARACTER</span>
          <h2 class="section_heading">Manners, Chivalry & Dignified Leadership</h2>
          <div class="lead_text">
            A gentleman is deeply conscious of his demeanor, words, moral obligations, and interactions with others. He treats every individual with unconditional dignity and respect.
          </div>
          <p class="body_paragraph">
            The <strong>Gentlemen’s League</strong> focuses intentionally on character development, social manners, executive poise, and disciplined athletic pursuits. Supervised by coaches certified by the <em>International Etiquette & Protocol Academy of London</em>, the program prepares young men for high-stakes leadership.
          </p>
          <p class="body_paragraph">
            From boardroom negotiation etiquette and courtroom decorum to dining protocol and public discourse, students graduate with an enduring moral compass and magnetic social grace.
          </p>

          <div class="curriculum_skills">
            <h3>Key Competencies Cultivated:</h3>
            <ul class="skills_list">
              <li>✓ <strong>Social Intelligence:</strong> Active listening, empathetic negotiation, and diplomacy.</li>
              <li>✓ <strong>Executive Demeanor:</strong> Impeccable posture, personal grooming, and formal attire etiquette.</li>
              <li>✓ <strong>Ethical Chivalry:</strong> Responsibility toward the vulnerable, civic leadership, and honor.</li>
              <li>✓ <strong>Physical Discipline:</strong> Mastery over demanding, noble athletic disciplines.</li>
            </ul>
          </div>
        </div>

        <div class="intro_media">
          <div class="media_card">
            <img 
              src={getMediaUrl("/images/batch4/league_main.jpg")} 
              alt="Gentlemen's League Training" 
              loading="lazy"
              onerror="this.src='/images/welcome_side.jpg'"
            />
          </div>
          <div class="media_card">
            <img 
              src={getMediaUrl("/images/batch4/league_nnn.jpg")} 
              alt="Sports and Protocol Activity" 
              loading="lazy"
              onerror="this.src='/images/hero_slider_2.jpg'"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- The 4 Noble Sports -->
  <section class="sports_section">
    <div class="container">
      <div class="section_header_center">
        <span class="sub_badge">ARISTOCRATIC ATHLETICS</span>
        <h2 class="section_title">The Four Gentlemen's Sports</h2>
        <div class="title-decorator"></div>
        <p class="section_subtitle">
          Instilling tactical foresight, razor-sharp focus, balance, and quiet self-control through heritage sporting disciplines.
        </p>
      </div>

      <div class="sports_grid">
        <div class="sport_card">
          <div class="sport_icon">
            <img src={getMediaUrl("/images/batch4/icon_fence.png")} alt="Fencing" />
          </div>
          <h3>Fencing</h3>
          <p>The art of tactical swordsmanship, developing lightning-fast reflexes, spatial anticipation, and absolute mental focus under pressure.</p>
        </div>

        <div class="sport_card">
          <div class="sport_icon">
            <img src={getMediaUrl("/images/batch4/icon_archery.png")} alt="Archery" />
          </div>
          <h3>Archery</h3>
          <p>Cultivating unyielding mental composure, breath discipline, visual acuity, and laser precision targeting in competitive setups.</p>
        </div>

        <div class="sport_card">
          <div class="sport_icon">
            <img src={getMediaUrl("/images/batch4/icon_riding.png")} alt="Horse Riding" />
          </div>
          <h3>Horse Riding (Equestrian)</h3>
          <p>Mastering equine communication, balance, courage, physical stamina, and commanding control in partnership with noble steeds.</p>
        </div>

        <div class="sport_card">
          <div class="sport_icon">
            <img src={getMediaUrl("/images/batch4/icon_golf.png")} alt="Golf" />
          </div>
          <h3>Golf</h3>
          <p>The consummate sport of executive patience, strategic trajectory calculation, emotional equilibrium, and honorable fair play.</p>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .sub_badge {
    display: inline-block;
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: var(--primary-color);
    background: rgba(0, 33, 71, 0.08);
    padding: 5px 12px;
    border-radius: 16px;
    margin-bottom: 12px;
    text-transform: uppercase;
  }

  .league_intro_section {
    padding: 70px 0 90px;
    background: var(--bg-white);
  }

  .quote_banner_box {
    background: linear-gradient(135deg, #002147 0%, #001733 100%);
    color: #ffffff;
    border-radius: var(--radius-md);
    padding: 40px;
    text-align: center;
    margin-bottom: 60px;
    border-bottom: 4px solid var(--accent-gold);
    box-shadow: var(--shadow-md);
  }

  .quote_mark {
    font-size: 60px;
    line-height: 1;
    color: var(--accent-gold);
    font-family: serif;
    margin-bottom: 6px;
  }

  .quote_text {
    font-size: clamp(20px, 2.8vw, 26px);
    font-family: var(--font-heading);
    font-style: italic;
    color: #ffffff;
    margin-bottom: 10px;
  }

  .quote_author {
    font-size: 15px;
    color: var(--accent-gold);
    font-weight: 600;
  }

  .intro_grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 50px;
    align-items: center;
  }

  .section_heading {
    font-size: clamp(26px, 3.2vw, 36px);
    color: var(--primary-color);
    margin-bottom: 18px;
    line-height: 1.3;
  }

  .lead_text {
    font-size: 17px;
    font-weight: 600;
    line-height: 1.65;
    color: var(--primary-light);
    margin-bottom: 16px;
  }

  .body_paragraph {
    font-size: 15px;
    line-height: 1.8;
    color: var(--text-muted);
    margin-bottom: 16px;
  }

  .curriculum_skills {
    margin-top: 26px;
    background: var(--bg-light);
    border-radius: var(--radius-md);
    padding: 24px;
    border-left: 4px solid var(--accent-gold);
  }

  .curriculum_skills h3 {
    font-size: 17px;
    color: var(--primary-color);
    margin-bottom: 14px;
  }

  .skills_list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-dark);
  }

  .intro_media {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .media_card {
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    background: #ffffff;
    border: 4px solid #ffffff;
  }

  .media_card img {
    width: 100%;
    height: 240px;
    object-fit: cover;
  }

  .sports_section {
    padding: 80px 0 100px;
    background: var(--bg-light);
  }

  .section_header_center {
    text-align: center;
    max-width: 700px;
    margin: 0 auto 50px;
  }

  .sports_grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 28px;
  }

  .sport_card {
    background: #ffffff;
    border-radius: var(--radius-md);
    padding: 38px 26px;
    border: 1px solid var(--border-light);
    box-shadow: var(--shadow-sm);
    text-align: center;
    transition: all 0.3s ease;
    border-top: 4px solid var(--accent-gold);
  }

  .sport_card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-lg);
  }

  .sport_icon {
    width: 72px;
    height: 72px;
    margin: 0 auto 20px;
    background: rgba(0, 33, 71, 0.04);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 14px;
  }

  .sport_icon img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .sport_card h3 {
    font-size: 20px;
    color: var(--primary-color);
    margin-bottom: 12px;
  }

  .sport_card p {
    font-size: 14px;
    line-height: 1.65;
    color: var(--text-muted);
  }

  @media (max-width: 900px) {
    .intro_grid {
      grid-template-columns: 1fr;
    }
  }
</style>
