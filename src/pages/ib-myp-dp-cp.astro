---
import Layout from '../layouts/Layout.astro';
import { getMediaUrl } from '../utils/media';
---

<Layout 
  title="IB Middle Years Programme (MYP) – Crescent School"
  description="Crescent Model Higher Secondary School is a candidate school for the International Baccalaureate (IB) Middle Years Programme (MYP) for learners aged 11 to 16 in Lahore."
>
  <!-- Standard Top Page Hero Banner -->
  <section class="page_hero_banner">
    <div class="container">
      <div class="hero_breadcrumbs">
        <a href="/">Home</a>
        <span>/</span>
        <span>Academics</span>
        <span>/</span>
        <span class="current">IB Middle Years Programme (MYP)</span>
      </div>
      <h1 class="hero_page_title">IB Middle Years Programme (MYP)</h1>
      <p class="hero_subtitle">Fostering active learners and internationally minded young people who can empathize with others and pursue lives of purpose.</p>
    </div>
  </section>

  <!-- Candidacy Status Feature Section -->
  <section class="candidacy_section">
    <div class="container">
      <div class="candidacy_card">
        <div class="candidacy_logo">
          <img 
            src={getMediaUrl("/images/partner_ib.jpg")} 
            alt="International Baccalaureate World School" 
            loading="lazy" 
          />
        </div>
        <div class="candidacy_content">
          <span class="badge_candidacy">OFFICIAL CANDIDATE SCHOOL</span>
          <h2>Crescent Achieves IB MYP Candidacy Status</h2>
          <p class="lead_desc">
            Crescent Model Higher Secondary School, Lahore, is a candidate school* for the <strong>International Baccalaureate (IB) Middle Years Programme (MYP)</strong>. This school is pursuing authorization as an IB World School.
          </p>
          <p class="body_desc">
            IB World Schools share a common philosophy — a commitment to high-quality, challenging, international education that Crescent School believes is vital for our learners in a rapidly shifting world.
          </p>
          <div class="disclaimer_note">
            *Only schools authorized by the IB Organization can offer any of its four academic programmes: the Primary Years Programme (PYP), the Middle Years Programme (MYP), the Diploma Programme (DP), or the Career-related Programme (CP). Candidate status gives no guarantee that authorization will be granted. For further information, visit <a href="https://www.ibo.org" target="_blank" rel="noopener">www.ibo.org</a>.
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- What is the MYP -->
  <section class="myp_framework_section">
    <div class="container">
      <div class="section_header_center">
        <span class="sub_badge">CURRICULUM ARCHITECTURE</span>
        <h2 class="section_title">The MYP Educational Framework (Ages 11–16)</h2>
        <div class="title-decorator"></div>
        <p class="section_subtitle">
          The MYP is designed to help students develop both disciplinary and interdisciplinary understanding through authentic learning contexts.
        </p>
      </div>

      <div class="framework_grid">
        <div class="framework_card">
          <div class="icon_box">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"/>
              <line x1="2" y1="12" x2="22" y2="12"/>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
            </svg>
          </div>
          <h3>Global Contexts</h3>
          <p>Teaching and learning in the MYP involves understanding human commonality and shared guardianship of the planet through six interconnected global contexts.</p>
        </div>

        <div class="framework_card">
          <div class="icon_box">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
              <polyline points="14 2 14 8 20 8"/>
              <line x1="16" y1="13" x2="8" y2="13"/>
              <line x1="16" y1="17" x2="8" y2="17"/>
            </svg>
          </div>
          <h3>Approaches to Learning (ATL)</h3>
          <p>Providing the foundation for independent learning. ATL skills empower students to 'learn how to learn' across communication, research, thinking, and self-management.</p>
        </div>

        <div class="framework_card">
          <div class="icon_box">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
            </svg>
          </div>
          <h3>The Personal Project</h3>
          <p>In Year 5 of MYP, each student produces an independent, student-driven Personal Project demonstrating their cumulative research, creativity, and project management skills.</p>
        </div>

        <div class="framework_card">
          <div class="icon_box">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
              <circle cx="9" cy="7" r="4"/>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
            </svg>
          </div>
          <h3>Action & Service</h3>
          <p>Students apply what they learn in class to help their communities, developing empathy, altruism, and active citizenship outside the traditional classroom.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 8 Subject Groups -->
  <section class="subjects_section">
    <div class="container">
      <div class="subjects_box">
        <h3>The Eight Disciplines of the MYP</h3>
        <p class="subjects_intro">The programme requires students to study across eight balanced subject groups:</p>
        
        <div class="subjects_pill_grid">
          <div class="subject_pill">Language & Literature</div>
          <div class="subject_pill">Language Acquisition</div>
          <div class="subject_pill">Individuals & Societies</div>
          <div class="subject_pill">Sciences (Physics, Chem, Bio)</div>
          <div class="subject_pill">Mathematics</div>
          <div class="subject_pill">Arts (Visual & Performing)</div>
          <div class="subject_pill">Physical & Health Education</div>
          <div class="subject_pill">Design & Technology</div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .sub_badge {
    display: inline-block;
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: var(--primary-color);
    background: rgba(0, 33, 71, 0.08);
    padding: 5px 12px;
    border-radius: 16px;
    margin-bottom: 12px;
    text-transform: uppercase;
  }

  .candidacy_section {
    padding: 80px 0;
    background: var(--bg-white);
  }

  .candidacy_card {
    background: #ffffff;
    border-radius: var(--radius-md);
    padding: 45px;
    box-shadow: var(--shadow-md);
    border: 1px solid var(--border-light);
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 40px;
    align-items: center;
    border-left: 6px solid var(--accent-gold);
  }

  .candidacy_logo img {
    max-width: 100%;
    height: auto;
    object-fit: contain;
  }

  .badge_candidacy {
    display: inline-block;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1px;
    color: #9a7200;
    background: rgba(253, 200, 0, 0.2);
    padding: 4px 12px;
    border-radius: 12px;
    margin-bottom: 10px;
  }

  .candidacy_content h2 {
    font-size: clamp(24px, 3vw, 32px);
    color: var(--primary-color);
    margin-bottom: 12px;
  }

  .lead_desc {
    font-size: 16.5px;
    line-height: 1.7;
    color: var(--primary-light);
    margin-bottom: 12px;
    font-weight: 600;
  }

  .body_desc {
    font-size: 15px;
    line-height: 1.75;
    color: var(--text-muted);
    margin-bottom: 18px;
  }

  .disclaimer_note {
    font-size: 12.5px;
    line-height: 1.6;
    color: #64748b;
    background: #f8fafc;
    padding: 12px 16px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-light);
  }

  .disclaimer_note a {
    color: var(--primary-color);
    font-weight: 600;
    text-decoration: underline;
  }

  .myp_framework_section {
    padding: 80px 0;
    background: var(--bg-light);
  }

  .section_header_center {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 50px;
  }

  .section_subtitle {
    font-size: 16px;
    color: var(--text-muted);
  }

  .framework_grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 26px;
  }

  .framework_card {
    background: #ffffff;
    border-radius: var(--radius-md);
    padding: 34px 26px;
    border: 1px solid var(--border-light);
    box-shadow: var(--shadow-sm);
    transition: all 0.3s ease;
  }

  .framework_card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-lg);
    border-color: var(--accent-gold);
  }

  .icon_box {
    width: 48px;
    height: 48px;
    background: var(--primary-gradient);
    color: var(--accent-gold);
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 18px;
  }

  .framework_card h3 {
    font-size: 18px;
    color: var(--primary-color);
    margin-bottom: 10px;
  }

  .framework_card p {
    font-size: 14px;
    line-height: 1.65;
    color: var(--text-muted);
  }

  .subjects_section {
    padding: 0 0 80px;
    background: var(--bg-light);
  }

  .subjects_box {
    background: #ffffff;
    border-radius: var(--radius-md);
    padding: 40px;
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--border-light);
    text-align: center;
  }

  .subjects_box h3 {
    font-size: 22px;
    color: var(--primary-color);
    margin-bottom: 8px;
  }

  .subjects_intro {
    font-size: 15px;
    color: var(--text-muted);
    margin-bottom: 24px;
  }

  .subjects_pill_grid {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
  }

  .subject_pill {
    background: rgba(0, 33, 71, 0.05);
    color: var(--primary-color);
    font-weight: 600;
    font-size: 13.5px;
    padding: 10px 18px;
    border-radius: 20px;
    border: 1px solid var(--border-light);
    transition: all 0.2s ease;
  }

  .subject_pill:hover {
    background: var(--primary-color);
    color: #ffffff;
  }

  @media (max-width: 800px) {
    .candidacy_card {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .candidacy_logo img {
      margin: 0 auto;
    }
  }
</style>
