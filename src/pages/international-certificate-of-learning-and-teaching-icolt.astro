---
import Layout from '../layouts/Layout.astro';
import { getMediaUrl } from '../utils/media';

const icoltModules = [
  {
    title: "Reflective Teaching & Lesson Critique",
    desc: "Frameworks for evaluating instructional effectiveness, analyzing classroom dynamics, and fostering continuous self-improvement."
  },
  {
    title: "Active Learning & Student Engagement",
    desc: "Techniques for transitioning from lecture-heavy instruction to student-centered inquiry, cooperative group projects, and hands-on discovery."
  },
  {
    title: "Assessment FOR Learning",
    desc: "Designing diagnostic and formative assessment strategies, effective peer feedback, and data-informed individualized remediation."
  },
  {
    title: "Inclusive Pedagogy & Differentiation",
    desc: "Addressing diverse learning needs, multiple intelligences, and scaffolding instruction for students across varying achievement levels."
  }
];
---

<Layout 
  title="International Certificate of Learning & Teaching (ICoLT) – Crescent School"
  description="Explore the ICoLT programme at Crescent School, co-designed with the University of Strathclyde, Glasgow (UK). An 18-day transformative international teaching certificate."
>
  <!-- Standard Top Page Hero Banner -->
  <section class="page_hero_banner">
    <div class="container">
      <div class="hero_breadcrumbs">
        <a href="/">Home</a>
        <span>/</span>
        <a href="/professional-development/">Professional Development</a>
        <span>/</span>
        <span class="current">ICoLT</span>
      </div>
      <h1 class="hero_page_title">International Certificate of Learning & Teaching (ICoLT)</h1>
      <p class="hero_subtitle">A transformative 18-day professional development qualification co-designed with the University of Strathclyde, Glasgow (UK).</p>
    </div>
  </section>

  <!-- Overview Section -->
  <section class="icolt_intro_section">
    <div class="container">
      <div class="intro_grid">
        <div class="intro_text">
          <span class="sub_badge">UK UNIVERSITY COLLABORATION</span>
          <h2 class="section_heading">Transforming Teaching Standards in the Local Context</h2>
          <div class="lead_text">
            The International Certificate of Learning and Teaching (ICoLT) is an enriching and transformative professional development opportunity designed for educators seeking to align their classroom practices with global benchmarks.
          </div>
          <p class="body_paragraph">
            This intensive <strong>18-day certificate course</strong> was co-designed by the learning and development leadership of Crescent Model Higher Secondary School and esteemed faculty from the <strong>University of Strathclyde, Glasgow (Scotland, UK)</strong>.
          </p>
          <p class="body_paragraph">
            Specifically tailored to meet the unique challenges and opportunities of educators in Pakistan, ICoLT provides a structured yet dynamic learning journey. Teachers are equipped with innovative active-learning strategies, global best practices, and reflective teaching methodologies that deliver immediate improvements in student achievement.
          </p>

          <div class="icolt_highlights">
            <div class="ih_item">
              <span class="ih_check">✓</span>
              <div>
                <strong>Co-Designed with University of Strathclyde (UK):</strong> International academic rigor combined with contextual classroom relevance.
              </div>
            </div>
            <div class="ih_item">
              <span class="ih_check">✓</span>
              <div>
                <strong>Practical Classroom Observation:</strong> Live peer lesson observations, micro-teaching drills, and actionable mentor coaching.
              </div>
            </div>
            <div class="ih_item">
              <span class="ih_check">✓</span>
              <div>
                <strong>Pathway to Postgraduate Diplomas:</strong> Serves as an accredited stepping stone toward UK PGCert and Master’s in Education credentials.
              </div>
            </div>
          </div>
        </div>

        <div class="intro_media">
          <div class="media_card">
            <img 
              src={getMediaUrl("/images/batch5/cpd_workshop_7.jpg")} 
              alt="ICoLT Interactive Seminar Session" 
              loading="lazy"
              onerror="this.src='/images/batch3/training_centre.jpg'"
            />
            <span class="media_caption">Faculty micro-teaching and pedagogy review workshop</span>
          </div>
          <div class="media_card">
            <img 
              src={getMediaUrl("/images/batch5/cpd_workshop_6.jpg")} 
              alt="Collaborative Teacher Planning" 
              loading="lazy"
              onerror="this.src='/images/batch5/cpd_workshop_3.jpg'"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Core Modules -->
  <section class="modules_section">
    <div class="container">
      <div class="section_header_center">
        <span class="sub_badge">CURRICULUM MODULES</span>
        <h2 class="section_title">Key Pillars of the ICoLT Curriculum</h2>
        <div class="title-decorator"></div>
      </div>

      <div class="modules_grid">
        {icoltModules.map((mod, index) => (
          <div class="module_card">
            <div class="mod_number">0{index + 1}</div>
            <h3>{mod.title}</h3>
            <p>{mod.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Gallery Strip -->
  <section class="gallery_strip_section">
    <div class="container">
      <div class="gallery_grid">
        <div class="gallery_item">
          <img src={getMediaUrl("/images/batch5/cpd_workshop_9.jpg")} alt="Teacher Collaboration" loading="lazy" />
        </div>
        <div class="gallery_item">
          <img src={getMediaUrl("/images/batch5/cpd_workshop_10.jpg")} alt="Pedagogy Presentation" loading="lazy" />
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .sub_badge {
    display: inline-block;
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: var(--primary-color);
    background: rgba(0, 33, 71, 0.08);
    padding: 5px 12px;
    border-radius: 16px;
    margin-bottom: 12px;
    text-transform: uppercase;
  }

  .icolt_intro_section {
    padding: 80px 0;
    background: var(--bg-white);
  }

  .intro_grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 50px;
    align-items: center;
  }

  .section_heading {
    font-size: clamp(26px, 3.2vw, 36px);
    color: var(--primary-color);
    margin-bottom: 18px;
    line-height: 1.3;
  }

  .lead_text {
    font-size: 17px;
    font-weight: 600;
    line-height: 1.65;
    color: var(--primary-light);
    margin-bottom: 16px;
  }

  .body_paragraph {
    font-size: 15px;
    line-height: 1.8;
    color: var(--text-muted);
    margin-bottom: 16px;
  }

  .icolt_highlights {
    margin-top: 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ih_item {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-dark);
  }

  .ih_check {
    color: var(--accent-gold-hover);
    font-weight: 800;
    font-size: 16px;
  }

  .intro_media {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .media_card {
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    background: #ffffff;
    border: 4px solid #ffffff;
  }

  .media_card img {
    width: 100%;
    height: 240px;
    object-fit: cover;
  }

  .media_caption {
    display: block;
    font-size: 12px;
    color: var(--text-muted);
    padding: 8px 12px;
    background: #ffffff;
    text-align: center;
  }

  .modules_section {
    padding: 80px 0;
    background: var(--bg-light);
  }

  .section_header_center {
    text-align: center;
    max-width: 700px;
    margin: 0 auto 50px;
  }

  .modules_grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 26px;
  }

  .module_card {
    background: #ffffff;
    border-radius: var(--radius-md);
    padding: 34px 26px;
    border: 1px solid var(--border-light);
    box-shadow: var(--shadow-sm);
    position: relative;
    border-top: 4px solid var(--accent-gold);
    transition: all 0.3s ease;
  }

  .module_card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-lg);
  }

  .mod_number {
    font-size: 26px;
    font-weight: 800;
    color: rgba(0, 33, 71, 0.12);
    margin-bottom: 12px;
    font-family: var(--font-heading);
  }

  .module_card h3 {
    font-size: 19px;
    color: var(--primary-color);
    margin-bottom: 10px;
  }

  .module_card p {
    font-size: 14px;
    line-height: 1.65;
    color: var(--text-muted);
  }

  .gallery_strip_section {
    padding: 0 0 80px;
    background: var(--bg-light);
  }

  .gallery_grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }

  .gallery_item {
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    border: 4px solid #ffffff;
  }

  .gallery_item img {
    width: 100%;
    height: 260px;
    object-fit: cover;
  }

  @media (max-width: 900px) {
    .intro_grid,
    .gallery_grid {
      grid-template-columns: 1fr;
    }
  }
</style>
