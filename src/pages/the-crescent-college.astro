---
import Layout from '../layouts/Layout.astro';
import { getMediaUrl } from '../utils/media';
---

<Layout 
  title="The Crescent College – Crescent School"
  description="Discover The Crescent College (F.Sc Pre-Medical, Pre-Engineering, ICS, General Science). Offering premier intermediate education, merit scholarships, and professional entrance coaching in Lahore."
>
  <!-- Standard Top Page Hero Banner -->
  <section class="page_hero_banner">
    <div class="container">
      <div class="hero_breadcrumbs">
        <a href="/">Home</a>
        <span>/</span>
        <span>Academics</span>
        <span>/</span>
        <span class="current">The Crescent College</span>
      </div>
      <h1 class="hero_page_title">The Crescent College</h1>
      <p class="hero_subtitle">Empowering ambitious scholars with higher secondary distinction, professional career pathways, and leadership excellence.</p>
    </div>
  </section>

  <!-- Overview Section -->
  <section class="academic_intro_section">
    <div class="container">
      <div class="intro_grid">
        <div class="intro_text">
          <span class="sub_badge">HIGHER SECONDARY SANCTUARY</span>
          <h2 class="section_heading">Value-Driven Pre-University Distinction</h2>
          <div class="lead_text">
            A value-based and value-driven institution that provides innovative educational environments, opportunities, and experiences enabling students to grow, thrive, and prosper.
          </div>
          <p class="body_paragraph">
            We bring together a dynamic community of young scholars from diverse backgrounds and facilitate their journey to becoming responsible leaders equipped to undertake the challenges of the 21st century.
          </p>
          <p class="body_paragraph">
            Our career-oriented learners are not only provided with rigorous academic roadmaps, but also thrive in an environment rich with co-curricular and athletic pursuits designed to nurture their hidden potential and fuel their passion for excellence.
          </p>

          <div class="highlights_list">
            <div class="highlight_item">
              <span class="check_icon">✓</span>
              <div>
                <strong>Professional Entrance Coaching:</strong> Dedicated on-campus preparation modules for MDCAT, ECAT, FAST, NUST, GIKI, and international SAT/IELTS.
              </div>
            </div>
            <div class="highlight_item">
              <span class="check_icon">✓</span>
              <div>
                <strong>Merit Scholarships & Financial Aid:</strong> Generous fee waivers and academic incentives awarded to high-achieving matriculation and O-Level graduates.
              </div>
            </div>
            <div class="highlight_item">
              <span class="check_icon">✓</span>
              <div>
                <strong>Faculty Mentorship:</strong> Renowned senior professors dedicated to teaching students how to conceptualize complex scientific theories and execute career goals.
              </div>
            </div>
          </div>
        </div>

        <div class="intro_media">
          <div class="media_card">
            <img 
              src={getMediaUrl("/images/batch3/college_bg10.jpg")} 
              alt="The Crescent College Main Campus" 
              loading="lazy"
              onerror="this.src='/images/hero_slider_2.jpg'"
            />
            <span class="media_caption">The Crescent College Academic Complex</span>
          </div>
          <div class="media_card">
            <img 
              src={getMediaUrl("/images/batch3/college_bh10.jpg")} 
              alt="Crescent College Quadrangle" 
              loading="lazy"
              onerror="this.src='/images/welcome_side.jpg'"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Intermediate Academic Streams -->
  <section class="college_streams_section">
    <div class="container">
      <div class="section_header_center">
        <span class="sub_badge">ACADEMIC DISCIPLINES</span>
        <h2 class="section_title">Intermediate Programmes (BISE Lahore)</h2>
        <div class="title-decorator"></div>
      </div>

      <div class="streams_grid">
        <!-- Stream 1 -->
        <div class="stream_card">
          <div class="stream_header">
            <span class="badge_stream">PRE-MEDICAL</span>
            <h3>F.Sc Pre-Medical</h3>
          </div>
          <p class="stream_desc">Rigorous foundation in biological and chemical sciences tailored for aspiring doctors, dental surgeons, biotechnologists, and healthcare leaders.</p>
          <ul class="stream_subjects">
            <li>• Biology & Biochemical Sciences</li>
            <li>• Physics & Applied Mechanics</li>
            <li>• Chemistry (Organic & Inorganic)</li>
            <li>• English, Urdu, Islamic Studies & Pak Studies</li>
          </ul>
        </div>

        <!-- Stream 2 -->
        <div class="stream_card">
          <div class="stream_header">
            <span class="badge_stream">PRE-ENGINEERING</span>
            <h3>F.Sc Pre-Engineering</h3>
          </div>
          <p class="stream_desc">Advanced mathematical analysis and physical sciences preparing future engineers, architects, data analysts, and innovators.</p>
          <ul class="stream_subjects">
            <li>• Advanced Mathematics & Calculus</li>
            <li>• Physics & Laboratory Electromagnetism</li>
            <li>• Chemistry & Analytical Principles</li>
            <li>• English, Urdu, Islamic Studies & Pak Studies</li>
          </ul>
        </div>

        <!-- Stream 3 -->
        <div class="stream_card">
          <div class="stream_header">
            <span class="badge_stream">COMPUTER SCIENCE</span>
            <h3>ICS (Computer Science)</h3>
          </div>
          <p class="stream_desc">Modern software engineering foundation, computational algorithms, and analytical logic for tech innovators.</p>
          <ul class="stream_subjects">
            <li>• Computer Science & Programming (C/C++, Python)</li>
            <li>• Mathematics & Discrete Structures</li>
            <li>• Physics / Statistics / Economics Options</li>
            <li>• English, Urdu, Islamic Studies & Pak Studies</li>
          </ul>
        </div>

        <!-- Stream 4 -->
        <div class="stream_card">
          <div class="stream_header">
            <span class="badge_stream">GENERAL SCIENCE</span>
            <h3>General Science (I.Com / Gen. Sc)</h3>
          </div>
          <p class="stream_desc">Flexible multidisciplinary stream combining quantitative mathematics, economics, statistics, and business reasoning.</p>
          <ul class="stream_subjects">
            <li>• Mathematics & Quantitative Methods</li>
            <li>• Statistics & Probability Distributions</li>
            <li>• Economics / Computer Science</li>
            <li>• Language & National Heritage Requirements</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Photo Strip -->
  <section class="gallery_strip_section">
    <div class="container">
      <div class="college_banner">
        <img 
          src={getMediaUrl("/images/batch3/college_bg100.jpg")} 
          alt="Crescent College Campus Life" 
          loading="lazy"
          onerror="this.src='/images/hero_slider_1.jpg'"
        />
      </div>
    </div>
  </section>
</Layout>

<style>
  .sub_badge {
    display: inline-block;
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: var(--primary-color);
    background: rgba(0, 33, 71, 0.08);
    padding: 5px 12px;
    border-radius: 16px;
    margin-bottom: 12px;
    text-transform: uppercase;
  }

  .academic_intro_section {
    padding: 80px 0;
    background: var(--bg-white);
  }

  .intro_grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 50px;
    align-items: center;
  }

  .section_heading {
    font-size: clamp(26px, 3.2vw, 36px);
    color: var(--primary-color);
    margin-bottom: 18px;
    line-height: 1.3;
  }

  .lead_text {
    font-size: 17px;
    font-weight: 600;
    line-height: 1.65;
    color: var(--primary-light);
    margin-bottom: 16px;
  }

  .body_paragraph {
    font-size: 15px;
    line-height: 1.8;
    color: var(--text-muted);
    margin-bottom: 16px;
  }

  .highlights_list {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-top: 24px;
  }

  .highlight_item {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--text-dark);
  }

  .check_icon {
    color: var(--accent-gold-hover);
    font-weight: 800;
    font-size: 16px;
  }

  .intro_media {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .media_card {
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    background: #ffffff;
    border: 4px solid #ffffff;
  }

  .media_card img {
    width: 100%;
    height: 240px;
    object-fit: cover;
  }

  .media_caption {
    display: block;
    font-size: 12px;
    color: var(--text-muted);
    padding: 8px 12px;
    background: #ffffff;
    text-align: center;
  }

  .college_streams_section {
    padding: 80px 0;
    background: var(--bg-light);
  }

  .section_header_center {
    text-align: center;
    max-width: 700px;
    margin: 0 auto 50px;
  }

  .streams_grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
    gap: 28px;
  }

  .stream_card {
    background: #ffffff;
    border-radius: var(--radius-md);
    padding: 34px 26px;
    border: 1px solid var(--border-light);
    box-shadow: var(--shadow-sm);
    transition: all 0.3s ease;
    border-top: 4px solid var(--accent-gold);
  }

  .stream_card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-lg);
  }

  .badge_stream {
    display: inline-block;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1px;
    color: var(--accent-teal);
    background: rgba(3, 106, 109, 0.08);
    padding: 4px 10px;
    border-radius: 12px;
    margin-bottom: 10px;
  }

  .stream_card h3 {
    font-size: 20px;
    color: var(--primary-color);
    margin-bottom: 12px;
  }

  .stream_desc {
    font-size: 14px;
    line-height: 1.65;
    color: var(--text-muted);
    margin-bottom: 18px;
  }

  .stream_subjects {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 13px;
    color: var(--text-dark);
    font-weight: 500;
    padding-top: 14px;
    border-top: 1px solid var(--border-light);
  }

  .gallery_strip_section {
    padding: 0 0 80px;
    background: var(--bg-light);
  }

  .college_banner {
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    border: 4px solid #ffffff;
    background: #ffffff;
  }

  .college_banner img {
    width: 100%;
    height: auto;
    max-height: 400px;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 900px) {
    .intro_grid {
      grid-template-columns: 1fr;
    }
  }
</style>
