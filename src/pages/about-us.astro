---
import Layout from '../layouts/Layout.astro';
import { getMediaUrl } from '../utils/media';
---

<Layout 
  title="About Us – Crescent School"
  description="Discover Crescent Model Higher Secondary School (Crescent School), established in 1968. A distinguished institution providing quality, accessible, and holistic education across our Boys and Girls Campuses in Shadman, Lahore."
>
  <!-- Standard Top Page Hero Banner -->
  <section class="page_hero_banner">
    <div class="container">
      <div class="hero_breadcrumbs">
        <a href="/">Home</a>
        <span>/</span>
        <span>Our Institution</span>
        <span>/</span>
        <span class="current">About Us</span>
      </div>
      <h1 class="hero_page_title">About Crescent School</h1>
      <p class="hero_subtitle">A premier institution of academic distinction, holistic character cultivation, and visionary leadership since 1968.</p>
    </div>
  </section>

  <!-- Overview & History Introduction -->
  <section class="about_intro_section">
    <div class="container">
      <div class="about_intro_grid">
        <div class="about_intro_text">
          <span class="sub_badge">OUR LEGACY & HERITAGE</span>
          <h2 class="section_heading">Faith – Unity – Discipline</h2>
          <div class="lead_text">
            The School started functioning in April, 1968 with thirty-five students in a few classrooms. Later, the school shifted to Shadman Colony in the heart of Lahore. The school is functioning at its present location since 1970 with 6,000+ students in the Boys Campus and 3,000+ students in the Girls Campus.
          </div>
          <p class="body_paragraph">
            The sprawling campus consists of purposefully designed modern classrooms, advanced Science and Computer Laboratories, research libraries, state-of-the-art auditoriums, an Olympic-standard swimming pool, gymnasium, and ample lush playing fields.
          </p>
          <p class="body_paragraph">
            Crescent Model Higher Secondary School has a distinguished track record of over fifty-five years. The Crescent Group has earmarked generous endowments and development funds for the continuous upgradation of school facilities, ensuring it remains at the pinnacle of educational delivery for future generations.
          </p>
        </div>

        <div class="about_intro_media">
          <div class="media_card primary_img">
            <img 
              src={getMediaUrl("/images/batch2/about-1.jpg")} 
              alt="Crescent School Campus Life" 
              loading="lazy"
              onerror="this.src='/images/hero_slider_1.jpg'"
            />
          </div>
          <div class="media_card secondary_img">
            <img 
              src={getMediaUrl("/images/batch2/about-2.jpg")} 
              alt="Crescent School Historic Architecture" 
              loading="lazy"
              onerror="this.src='/images/hero_slider_2.jpg'"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Dual Campuses Showcase -->
  <section class="campuses_showcase_section">
    <div class="container">
      <div class="section_header_center">
        <span class="sub_badge">CAMPUS ARCHITECTURE</span>
        <h2 class="section_title">Two Dedicated Campuses, One Standard of Excellence</h2>
        <div class="title-decorator"></div>
      </div>

      <div class="campuses_grid">
        <!-- Boys Campus Card -->
        <div class="campus_card">
          <div class="campus_header">
            <div class="campus_icon">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
                <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
              </svg>
            </div>
            <div>
              <span class="campus_meta">SHADMAN MAIN CAMPUS</span>
              <h3 class="campus_name">Boys Campus</h3>
            </div>
          </div>
          <div class="campus_body">
            <p>Home to over 6,000 ambitious young scholars. The Boys Campus features extensive athletic grounds, specialized science complexes, the Cambridge O/A-Level wing, The Crescent College, robotics labs, and expansive learning resources.</p>
            <ul class="campus_perks">
              <li>✓ Early Years, Primary, Middle & Senior Wings</li>
              <li>✓ Cambridge Assessment International Education</li>
              <li>✓ Crescent College (F.Sc, ICS, General Science)</li>
              <li>✓ Olympic-spec swimming pool & multi-sport grounds</li>
            </ul>
          </div>
        </div>

        <!-- Girls Campus Card -->
        <div class="campus_card">
          <div class="campus_header">
            <div class="campus_icon">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
              </svg>
            </div>
            <div>
              <span class="campus_meta">INDEPENDENT ACADEMIC COMPLEX</span>
              <h3 class="campus_name">Girls Campus</h3>
            </div>
          </div>
          <div class="campus_body">
            <p>Empowering over 3,000 talented young women since 1987 in a secure, nurturing, and high-achieving environment. Dedicated to academic rigour, leadership, and ethical character building.</p>
            <ul class="campus_perks">
              <li>✓ Dedicated Primary, Middle, Senior & College Sections</li>
              <li>✓ World-Class Cambridge O/A Levels & Matriculation</li>
              <li>✓ Specialized Arts, Music & Finishing School</li>
              <li>✓ Holistic pastoral care and leadership incubation</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Founding Vision & Social Responsibility -->
  <section class="founding_vision_section">
    <div class="container">
      <div class="vision_content_box">
        <span class="sub_badge light">CORPORATE SOCIAL RESPONSIBILITY</span>
        <h2>The Visionary Founders</h2>
        <div class="title-decorator light"></div>
        <p class="vision_lead">
          Founders of the Crescent Group — <strong>Mian Fazl Karim</strong>, <strong>Mian Muhammad Amin</strong>, <strong>Mian Muhammad Shafi</strong>, and <strong>Mian Muhammad Bashir</strong> — considered corporate social responsibility as a cornerstone of their business policy.
        </p>
        <p class="vision_body">
          Eminent national personalities like <strong>Dr. Amir-ud-Din</strong>, <strong>Chief Justice Yaqub Ali Khan</strong>, <strong>Dr. Mubashir Hassan</strong>, and <strong>Mr. Majid Nizami</strong> played a pioneering role alongside Mian Muhammad Amin to establish Crescent Model Higher Secondary School in Lahore. They fundamentally believed that without providing high quality education at a reasonable and accessible cost to deserving children, the nation cannot progress.
        </p>
      </div>
    </div>
  </section>

  <!-- Student Voice & Testimonials -->
  <section class="testimonials_section">
    <div class="container">
      <div class="section_header_center">
        <span class="sub_badge">TESTIMONIALS</span>
        <h2 class="section_title">What Our Students Say</h2>
        <div class="title-decorator"></div>
      </div>

      <div class="testimonials_grid">
        <!-- Testimonial 1 -->
        <div class="testimonial_card">
          <div class="quote_icon">“</div>
          <p class="testimonial_text">
            "All the teachers have worked very hard to make my concepts crystal clear through their vast knowledge and precious time. With the motivation and unwavering support of my devoted teachers, I kept striving and working hard. The digital and physical academic support at Crescent is unmatched."
          </p>
          <div class="testimonial_author">
            <div class="author_avatar">SS</div>
            <div class="author_info">
              <h4>Shiza Shanzay</h4>
              <span>Class C-III (Orange)</span>
            </div>
          </div>
        </div>

        <!-- Testimonial 2 -->
        <div class="testimonial_card">
          <div class="quote_icon">“</div>
          <p class="testimonial_text">
            "My overall experience at Crescent Model Higher Secondary School has been amazing. Studying with enthusiastic teachers in a peaceful, motivating, and friendly environment makes every day full of joy. Co-curricular activities provide tremendous support to our all-round personal growth."
          </p>
          <div class="testimonial_author">
            <div class="author_avatar">OS</div>
            <div class="author_info">
              <h4>Okar Singh</h4>
              <span>Class VI (Turquoise)</span>
            </div>
          </div>
        </div>

        <!-- Testimonial 3 -->
        <div class="testimonial_card">
          <div class="quote_icon">“</div>
          <p class="testimonial_text">
            "My journey at Crescent has been phenomenal. Talking about Crescent, I truly believe choosing this institution was the best decision of my schooling years, and I am definitely going to pursue my A-Levels here as well. The teachers' dedication is extraordinary."
          </p>
          <div class="testimonial_author">
            <div class="author_avatar">NM</div>
            <div class="author_info">
              <h4>Naveen Malik</h4>
              <span>Class C-III (Orange)</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .sub_badge {
    display: inline-block;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: var(--primary-color);
    background: rgba(0, 33, 71, 0.08);
    padding: 6px 14px;
    border-radius: 20px;
    margin-bottom: 14px;
    text-transform: uppercase;
  }

  .sub_badge.light {
    color: var(--accent-gold);
    background: rgba(253, 200, 0, 0.15);
  }

  .about_intro_section {
    padding: 80px 0;
    background: var(--bg-white);
  }

  .about_intro_grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 50px;
    align-items: center;
  }

  .section_heading {
    font-size: clamp(28px, 3.5vw, 38px);
    margin-bottom: 20px;
    color: var(--primary-color);
  }

  .lead_text {
    font-size: 18px;
    font-weight: 600;
    line-height: 1.6;
    color: var(--primary-light);
    margin-bottom: 18px;
  }

  .body_paragraph {
    font-size: 15px;
    line-height: 1.75;
    color: var(--text-muted);
    margin-bottom: 16px;
  }

  .about_intro_media {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .media_card {
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    border: 4px solid #ffffff;
  }

  .media_card img {
    width: 100%;
    height: 260px;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .media_card:hover img {
    transform: scale(1.03);
  }

  .campuses_showcase_section {
    padding: 80px 0;
    background: var(--bg-light);
  }

  .section_header_center {
    text-align: center;
    max-width: 700px;
    margin: 0 auto 30px;
  }

  .campuses_grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 30px;
  }

  .campus_card {
    background: #ffffff;
    border-radius: var(--radius-md);
    padding: 35px 30px;
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--border-light);
    transition: all 0.3s ease;
  }

  .campus_card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-lg);
    border-color: var(--accent-gold);
  }

  .campus_header {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 20px;
    padding-bottom: 18px;
    border-bottom: 2px solid var(--border-light);
  }

  .campus_icon {
    width: 56px;
    height: 56px;
    background: var(--primary-gradient);
    color: var(--accent-gold);
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-sm);
  }

  .campus_meta {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    color: var(--accent-gold-hover);
    display: block;
    margin-bottom: 2px;
  }

  .campus_name {
    font-size: 22px;
    color: var(--primary-color);
  }

  .campus_body p {
    font-size: 14px;
    color: var(--text-muted);
    line-height: 1.65;
    margin-bottom: 20px;
  }

  .campus_perks {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: 13.5px;
    color: var(--text-dark);
    font-weight: 500;
  }

  .founding_vision_section {
    padding: 90px 0;
    background: var(--primary-gradient);
    color: #ffffff;
    text-align: center;
  }

  .vision_content_box {
    max-width: 900px;
    margin: 0 auto;
  }

  .founding_vision_section h2 {
    font-size: clamp(28px, 4vw, 38px);
    color: #ffffff;
    margin-bottom: 12px;
  }

  .title-decorator.light {
    background: var(--accent-gold);
  }

  .vision_lead {
    font-size: 19px;
    line-height: 1.7;
    color: #f1f5f9;
    margin-bottom: 24px;
    font-weight: 500;
  }

  .vision_body {
    font-size: 15px;
    line-height: 1.8;
    color: #cbd5e1;
  }

  .testimonials_section {
    padding: 80px 0;
    background: var(--bg-white);
  }

  .testimonials_grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 30px;
  }

  .testimonial_card {
    background: var(--bg-light);
    border-radius: var(--radius-md);
    padding: 35px 28px;
    position: relative;
    border-top: 4px solid var(--accent-gold);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.3s ease;
  }

  .testimonial_card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }

  .quote_icon {
    font-size: 54px;
    line-height: 1;
    color: var(--accent-gold);
    font-family: serif;
    margin-bottom: 10px;
  }

  .testimonial_text {
    font-size: 14.5px;
    line-height: 1.7;
    color: var(--text-dark);
    font-style: italic;
    margin-bottom: 24px;
  }

  .testimonial_author {
    display: flex;
    align-items: center;
    gap: 14px;
    border-top: 1px solid var(--border-light);
    padding-top: 16px;
  }

  .author_avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--primary-color);
    color: var(--accent-gold);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 14px;
  }

  .author_info h4 {
    font-size: 15px;
    color: var(--primary-color);
    margin-bottom: 2px;
  }

  .author_info span {
    font-size: 12px;
    color: var(--text-muted);
  }

  @media (max-width: 900px) {
    .about_intro_grid {
      grid-template-columns: 1fr;
    }
  }
</style>
