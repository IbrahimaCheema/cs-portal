---
import Layout from '../layouts/Layout.astro';
import { getMediaUrl } from '../utils/media';
---

<Layout 
  title="Crescent Early Years & Primary Section – Crescent School"
  description="Explore Crescent Early Years and Primary Section. Offering inquiry-based learning, the IB Primary Years Programme (PYP), and holistic foundational child development in Lahore."
>
  <!-- Standard Top Page Hero Banner -->
  <section class="page_hero_banner">
    <div class="container">
      <div class="hero_breadcrumbs">
        <a href="/">Home</a>
        <span>/</span>
        <span>Academics</span>
        <span>/</span>
        <span class="current">Early Years & Primary</span>
      </div>
      <h1 class="hero_page_title">Crescent Early Years & Primary Section</h1>
      <p class="hero_subtitle">Nurturing curiosity, creativity, and foundational confidence through joyful, inquiry-based early childhood education.</p>
    </div>
  </section>

  <!-- Intro & IB PYP Alignment -->
  <section class="academic_intro_section">
    <div class="container">
      <div class="intro_grid">
        <div class="intro_text">
          <span class="sub_badge">FOUNDATIONAL STAGE</span>
          <h2 class="section_heading">Inspiring Lifelong Learners from the Very First Step</h2>
          <div class="lead_text">
            Aligned with the International Baccalaureate (IB) philosophy, our school is dedicated to enhancing the education of a diverse and inclusive student community.
          </div>
          <p class="body_paragraph">
            In consonance with modern developmental pedagogy, Crescent School offers the <strong>Primary Years Programme (PYP)</strong> designed for young learners aged 3 to 12. It nurtures and develops young students as caring, active participants in a lifelong journey of learning.
          </p>
          <p class="body_paragraph">
            Our curriculum embraces transdisciplinary themes that enable children to explore local and global issues, connect real-world concepts, and express their developing perspectives through hands-on inquiry, artistic expression, and guided play.
          </p>
          
          <div class="highlights_list">
            <div class="highlight_item">
              <span class="check_icon">✓</span>
              <div>
                <strong>Inquiry-Based Classrooms:</strong> Encouraging questions, active investigation, and experiential discovery.
              </div>
            </div>
            <div class="highlight_item">
              <span class="check_icon">✓</span>
              <div>
                <strong>Holistic Child Development:</strong> Balancing academic fundamentals (phonics, numeracy) with emotional and social wellbeing.
              </div>
            </div>
            <div class="highlight_item">
              <span class="check_icon">✓</span>
              <div>
                <strong>Secure, Stimulating Campus:</strong> Dedicated play areas, age-appropriate reading nooks, and activity centers.
              </div>
            </div>
          </div>
        </div>

        <div class="intro_media">
          <div class="media_card">
            <img 
              src={getMediaUrl("/images/batch3/redcoat.jpg")} 
              alt="Crescent Early Years Student Life" 
              loading="lazy"
              onerror="this.src='/images/welcome_early_years.jpg'"
            />
            <span class="media_caption">Joyful learning in vibrant, student-centric classrooms</span>
          </div>
          <div class="media_card">
            <img 
              src={getMediaUrl("/images/batch3/red2.jpg")} 
              alt="Hands-on Primary Learning" 
              loading="lazy"
              onerror="this.src='/images/batch3/chairs.jpg'"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Academic Pillars -->
  <section class="pillars_section">
    <div class="container">
      <div class="section_header_center">
        <span class="sub_badge">CURRICULUM ARCHITECTURE</span>
        <h2 class="section_title">Our Early Years Learning Pillars</h2>
        <div class="title-decorator"></div>
      </div>

      <div class="pillars_grid">
        <div class="pillar_card">
          <div class="pillar_icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
              <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
            </svg>
          </div>
          <h3>Language & Literacy</h3>
          <p>Structured Jolly Phonics, rich storytelling, vocabulary immersion, and early writing skills that kindle a lifelong passion for reading.</p>
        </div>

        <div class="pillar_card">
          <div class="pillar_icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
              <line x1="9" y1="3" x2="9" y2="21"/>
              <line x1="3" y1="9" x2="21" y2="9"/>
            </svg>
          </div>
          <h3>Numeracy & Logic</h3>
          <p>Concrete-Pictorial-Abstract mathematics progression, pattern recognition, spatial reasoning, and fun arithmetic games.</p>
        </div>

        <div class="pillar_card">
          <div class="pillar_icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"/>
              <path d="M8 14s1.5 2 4 2 4-2 4-2"/>
              <line x1="9" y1="9" x2="9.01" y2="9"/>
              <line x1="15" y1="9" x2="15.01" y2="9"/>
            </svg>
          </div>
          <h3>Social & Emotional Wellbeing</h3>
          <p>Collaborative play, empathetic sharing, emotional regulation, and fostering positive social connections with peers and teachers.</p>
        </div>

        <div class="pillar_card">
          <div class="pillar_icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
            </svg>
          </div>
          <h3>Creative Arts & Motor Skills</h3>
          <p>Music, rhythmic movement, painting, sculpture, and physical playtime to refine fine and gross motor dexterity.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Photo Gallery Strip -->
  <section class="gallery_strip_section">
    <div class="container">
      <div class="gallery_grid">
        <div class="gallery_item">
          <img src={getMediaUrl("/images/batch3/chairs.jpg")} alt="Primary Activity Zone" loading="lazy" />
        </div>
        <div class="gallery_item">
          <img src={getMediaUrl("/images/batch3/junior.jpg")} alt="Junior Section Quad" loading="lazy" />
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .sub_badge {
    display: inline-block;
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: var(--primary-color);
    background: rgba(0, 33, 71, 0.08);
    padding: 5px 12px;
    border-radius: 16px;
    margin-bottom: 12px;
    text-transform: uppercase;
  }

  .academic_intro_section {
    padding: 80px 0;
    background: var(--bg-white);
  }

  .intro_grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 50px;
    align-items: center;
  }

  .section_heading {
    font-size: clamp(26px, 3.2vw, 36px);
    color: var(--primary-color);
    margin-bottom: 18px;
    line-height: 1.3;
  }

  .lead_text {
    font-size: 17px;
    font-weight: 600;
    line-height: 1.65;
    color: var(--primary-light);
    margin-bottom: 16px;
  }

  .body_paragraph {
    font-size: 15px;
    line-height: 1.8;
    color: var(--text-muted);
    margin-bottom: 16px;
  }

  .highlights_list {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-top: 24px;
  }

  .highlight_item {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--text-dark);
  }

  .check_icon {
    color: var(--accent-gold-hover);
    font-weight: 800;
    font-size: 16px;
  }

  .intro_media {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .media_card {
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    background: #ffffff;
    border: 4px solid #ffffff;
  }

  .media_card img {
    width: 100%;
    height: 240px;
    object-fit: cover;
  }

  .media_caption {
    display: block;
    font-size: 12px;
    color: var(--text-muted);
    padding: 8px 12px;
    background: #ffffff;
    text-align: center;
  }

  .pillars_section {
    padding: 80px 0 100px;
    background: var(--bg-light);
  }

  .section_header_center {
    text-align: center;
    max-width: 700px;
    margin: 0 auto 40px;
  }

  .pillars_grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 26px;
  }

  .pillar_card {
    background: #ffffff;
    border-radius: var(--radius-md);
    padding: 32px 24px;
    border: 1px solid var(--border-light);
    box-shadow: var(--shadow-sm);
    transition: all 0.3s ease;
  }

  .pillar_card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-lg);
    border-color: var(--accent-gold);
  }

  .pillar_icon {
    width: 48px;
    height: 48px;
    background: var(--primary-gradient);
    color: var(--accent-gold);
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 18px;
  }

  .pillar_card h3 {
    font-size: 18px;
    color: var(--primary-color);
    margin-bottom: 10px;
  }

  .pillar_card p {
    font-size: 14px;
    line-height: 1.65;
    color: var(--text-muted);
  }

  .gallery_strip_section {
    padding: 0 0 80px;
    background: var(--bg-light);
  }

  .gallery_grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }

  .gallery_item {
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    border: 4px solid #ffffff;
  }

  .gallery_item img {
    width: 100%;
    height: 280px;
    object-fit: cover;
  }

  @media (max-width: 900px) {
    .intro_grid,
    .gallery_grid {
      grid-template-columns: 1fr;
    }
  }
</style>
