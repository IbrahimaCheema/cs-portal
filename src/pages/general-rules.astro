---
import Layout from '../layouts/Layout.astro';
import { getMediaUrl } from '../utils/media';

const prohibitedItems = [
  { icon: "🚫", title: "Damaging School Property", desc: "Willful vandalism, defacing desks, breaking laboratory equipment, or damaging library volumes. Full restitution cost is charged." },
  { icon: "🚫", title: "Mobile Phones & Smart Gadgets", desc: "Carrying mobile phones, smartwatches with cellular connection, or unapproved electronics to school is strictly forbidden. Confiscated devices are held until term end." },
  { icon: "🚫", title: "Audio / Video Devices", desc: "Bringing entertainment players, gaming devices, or audio equipment unless specifically requested for an academic presentation." },
  { icon: "🚫", title: "Bullying & Harassment", desc: "Zero tolerance for verbal intimidation, cyber-bullying, physical aggression, hazing, or discriminatory behavior toward peers." },
  { icon: "🚫", title: "Smoking & Intoxicants", desc: "Possession, distribution, or consumption of tobacco, vaping products, betel nut, or any intoxicating substances on or near campus." },
  { icon: "🚫", title: "Weapons & Hazardous Objects", desc: "Carrying knives, explosives, firecrackers, sharp instruments, or weapons of any sort leads to immediate expulsion." },
  { icon: "🚫", title: "Unfair Means in Examinations", desc: "Cheating, smuggling notes, copying, or possessing unauthorized material during class tests or board/Cambridge exams." },
  { icon: "🚫", title: "Betting, Gambling & Lotteries", desc: "Engaging in wagers, informal gambling, or unauthorized ticket collections among students." },
  { icon: "🚫", title: "Insubordination & Misconduct", desc: "Disrespectful behavior, defiance, or rude demeanor toward teachers, administrative staff, proctors, or security officers." }
];

const withdrawalRules = [
  {
    step: "01",
    title: "One Month Written Notice",
    desc: "To withdraw a student from school, the parent or official legal guardian must submit a formal written notice at least one full month prior to the student's final intended day."
  },
  {
    step: "02",
    title: "Notice Period Attendance",
    desc: "The leaving student is required to regularly attend classes and complete academic assessments during the one-month notice period."
  },
  {
    step: "03",
    title: "Security Refund Application",
    desc: "Official Security Refund Application forms are obtained from the Accounts Office and submitted along with the original admission deposit receipt and library clearance."
  },
  {
    step: "04",
    title: "Crossed Cheque Disbursement",
    desc: "The refundable security deposit is settled and disbursed via a crossed bank cheque payable to the parent/guardian approximately within one month of final institutional clearance."
  }
];

const uniformPolicies = [
  {
    category: "Boys Uniform",
    details: "White collared formal shirt with school crest, navy blue trousers (Senior/College) or grey trousers/shorts (Junior), navy blue blazer/sweater in winter, official school tie, and black polished leather shoes with dark socks."
  },
  {
    category: "Girls Uniform",
    details: "Prescribed royal blue/white shalwar qameez with official white dupatta/scarf displaying the school monogram, navy blue sweater or blazer in winter, and black flat school shoes with white socks."
  },
  {
    category: "Identity Smart Cards",
    details: "All students must wear their official barcode-enabled Crescent Student ID card around their neck at all times for turnstile access, gate security, and library checkout."
  }
];
---

<Layout 
  title="General Rules & Code of Discipline – Crescent School"
  description="Review institutional rules, disciplinary policies, code of conduct, uniform guidelines, and withdrawal procedures at Crescent Model Higher Secondary School Lahore."
>
  <!-- Standard Top Page Hero Banner -->
  <section class="page_hero_banner">
    <div class="container">
      <div class="hero_breadcrumbs">
        <a href="/">Home</a>
        <span>/</span>
        <a href="/about-us/">About Us</a>
        <span>/</span>
        <span class="current">General Rules</span>
      </div>
      <h1 class="hero_page_title">General Rules & Discipline</h1>
      <p class="hero_subtitle">Fostering a safe, dignified, and character-driven learning community since 1968.</p>
    </div>
  </section>

  <!-- Preamble Section -->
  <section class="rules_preamble_section">
    <div class="container">
      <div class="preamble_card">
        <span class="sub_badge">CODE OF CONDUCT</span>
        <h2 class="section_heading">Preserving Institutional Dignity and Character</h2>
        <p class="lead_text">
          Discipline and character formation are foundational pillars of Crescent Model Higher Secondary School. Every Crescenterian is expected to conduct themselves with honesty, modesty, self-restraint, and courtesy both on campus and in society.
        </p>
        <p class="body_text">
          The following institutional policies and prohibitions are strictly enforced by the Disciplinary Committee. Non-compliance or serious breaches may result in official warnings, suspension, forfeiture of merit positions, or withdrawal from the rolls of the school.
        </p>
      </div>
    </div>
  </section>

  <!-- Strictly Prohibited Actions Grid -->
  <section class="prohibitions_section">
    <div class="container">
      <div class="section_header_center">
        <span class="sub_badge">DISCIPLINARY CODES</span>
        <h2 class="section_title">Strictly Prohibited Infractions</h2>
        <div class="title-decorator"></div>
        <p class="section_subtitle">Students found guilty of the following infractions are liable to disciplinary penalties or compulsory withdrawal.</p>
      </div>

      <div class="prohibitions_grid">
        {prohibitedItems.map(item => (
          <div class="prohibition_card">
            <span class="p_icon">{item.icon}</span>
            <div class="p_body">
              <h3>{item.title}</h3>
              <p>{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Withdrawal & Security Refund Rules -->
  <section class="withdrawal_section">
    <div class="container">
      <div class="section_header_center">
        <span class="sub_badge">ADMINISTRATIVE PROTOCOL</span>
        <h2 class="section_title">Student Withdrawal & Security Refund Policy</h2>
        <div class="title-decorator"></div>
      </div>

      <div class="withdrawal_grid">
        {withdrawalRules.map(r => (
          <div class="withdrawal_card">
            <div class="step_badge">{r.step}</div>
            <h3>{r.title}</h3>
            <p>{r.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Uniform & Attendance Standards -->
  <section class="standards_section">
    <div class="container">
      <div class="standards_layout">
        <div class="standards_col">
          <span class="sub_badge">UNIFORM & GROOMING</span>
          <h3>Uniform Guidelines</h3>
          <div class="standards_stack">
            {uniformPolicies.map(u => (
              <div class="standard_card">
                <h4>{u.category}</h4>
                <p>{u.details}</p>
              </div>
            ))}
          </div>
        </div>

        <div class="standards_col">
          <span class="sub_badge">ATTENDANCE & LEAVE</span>
          <h3>Attendance & Punctuality</h3>
          <div class="attendance_box">
            <div class="att_rule">
              <strong>Minimum 85% Attendance:</strong> Required to appear in annual board, Cambridge, and internal examinations.
            </div>
            <div class="att_rule">
              <strong>Morning Assembly Punctuality:</strong> Gate closes strictly at 7:55 AM. Late arrivals are marked and repeated late-coming triggers parent summons.
            </div>
            <div class="att_rule">
              <strong>Leave of Absence:</strong> Formal written leave applications must be submitted by parents for absence. Leaves exceeding two days due to illness require a registered medical practitioner's certificate.
            </div>
            <div class="att_rule">
              <strong>Unexcused Absence:</strong> Continuous unexcused absence for 6 consecutive days results in the striking off of the student's name from school rolls.
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Queries Strip -->
  <section class="rules_cta_strip">
    <div class="container">
      <div class="cta_bar">
        <div>
          <h4>Questions Regarding School Rules or Disciplinary Policies?</h4>
          <p>Contact the Section Headmistress / Headmaster or the Office of Student Affairs.</p>
        </div>
        <a href="/contact-2/" class="btn_contact_us">Contact Administration &rarr;</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .sub_badge {
    display: inline-block;
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: var(--primary-color);
    background: rgba(0, 33, 71, 0.08);
    padding: 5px 12px;
    border-radius: 16px;
    margin-bottom: 12px;
    text-transform: uppercase;
  }

  .rules_preamble_section {
    padding: 70px 0 40px;
    background: var(--bg-white);
  }

  .preamble_card {
    max-width: 860px;
    margin: 0 auto;
    text-align: center;
  }

  .section_heading {
    font-size: clamp(26px, 3.2vw, 36px);
    color: var(--primary-color);
    margin-bottom: 18px;
    line-height: 1.3;
  }

  .lead_text {
    font-size: 16.5px;
    line-height: 1.7;
    color: var(--primary-light);
    font-weight: 500;
    margin-bottom: 16px;
  }

  .body_text {
    font-size: 14.5px;
    line-height: 1.8;
    color: var(--text-muted);
  }

  /* Prohibitions */
  .prohibitions_section {
    padding: 70px 0;
    background: var(--bg-light);
  }

  .section_header_center {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 50px;
  }

  .section_subtitle {
    margin-top: 14px;
    font-size: 14.5px;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .prohibitions_grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 24px;
  }

  .prohibition_card {
    background: #ffffff;
    border-radius: var(--radius-md);
    padding: 24px;
    border: 1px solid var(--border-light);
    box-shadow: var(--shadow-sm);
    display: flex;
    gap: 16px;
    transition: all 0.25s ease;
    border-top: 3px solid #e53935;
  }

  .prohibition_card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }

  .p_icon {
    font-size: 24px;
    flex-shrink: 0;
    line-height: 1.3;
  }

  .p_body h3 {
    font-size: 16px;
    color: var(--primary-color);
    margin: 0 0 8px 0;
  }

  .p_body p {
    font-size: 13px;
    line-height: 1.55;
    color: var(--text-muted);
    margin: 0;
  }

  /* Withdrawal */
  .withdrawal_section {
    padding: 70px 0;
    background: var(--bg-white);
  }

  .withdrawal_grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 24px;
  }

  .withdrawal_card {
    background: #fbfcfe;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-light);
    padding: 30px 22px;
    position: relative;
    border-top: 3px solid var(--primary-color);
  }

  .step_badge {
    font-size: 24px;
    font-weight: 800;
    color: rgba(0, 33, 71, 0.15);
    margin-bottom: 12px;
    font-family: var(--font-heading);
  }

  .withdrawal_card h3 {
    font-size: 17px;
    color: var(--primary-color);
    margin: 0 0 10px 0;
  }

  .withdrawal_card p {
    font-size: 13px;
    line-height: 1.6;
    color: var(--text-muted);
    margin: 0;
  }

  /* Standards */
  .standards_section {
    padding: 70px 0;
    background: var(--bg-light);
  }

  .standards_layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
  }

  .standards_col h3 {
    font-size: 22px;
    color: var(--primary-color);
    margin: 0 0 20px 0;
  }

  .standards_stack {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .standard_card {
    background: #ffffff;
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    padding: 20px;
    box-shadow: var(--shadow-sm);
  }

  .standard_card h4 {
    font-size: 15px;
    color: var(--primary-color);
    margin: 0 0 8px 0;
  }

  .standard_card p {
    font-size: 13px;
    line-height: 1.6;
    color: var(--text-muted);
    margin: 0;
  }

  .attendance_box {
    background: #ffffff;
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    padding: 24px;
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .att_rule {
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--text-dark);
    padding-bottom: 12px;
    border-bottom: 1px solid var(--border-light);
  }

  .att_rule:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .att_rule strong {
    color: var(--primary-color);
    display: block;
    margin-bottom: 4px;
  }

  /* CTA */
  .rules_cta_strip {
    padding: 0 0 70px;
    background: var(--bg-light);
  }

  .cta_bar {
    background: linear-gradient(135deg, var(--primary-dark) 0%, var(--primary-color) 100%);
    border-radius: var(--radius-md);
    padding: 30px 40px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: #ffffff;
    gap: 20px;
  }

  .cta_bar h4 {
    color: #ffffff;
    font-size: 18px;
    margin: 0 0 6px 0;
  }

  .cta_bar p {
    color: rgba(255, 255, 255, 0.85);
    font-size: 13px;
    margin: 0;
  }

  .btn_contact_us {
    background: var(--accent-gold);
    color: var(--primary-dark);
    font-size: 13px;
    font-weight: 700;
    padding: 11px 20px;
    border-radius: var(--radius-sm);
    text-decoration: none;
    flex-shrink: 0;
    transition: all 0.2s ease;
  }

  .btn_contact_us:hover {
    background: var(--accent-gold-hover);
  }

  @media (max-width: 900px) {
    .standards_layout {
      grid-template-columns: 1fr;
    }
    .cta_bar {
      flex-direction: column;
      text-align: center;
    }
  }
</style>
