---
import Layout from '../layouts/Layout.astro';
import { getMediaUrl } from '../utils/media';

const whyWorkAtCrescent = [
  {
    icon: "🌱",
    title: "Continuous Professional Development",
    desc: "Full institutional sponsorship for Cambridge PDQs, CELTA/Delta, and international teaching certificates."
  },
  {
    icon: "💼",
    title: "Competitive Compensation & Provident Fund",
    desc: "Market-leading salary scales, annual performance increments, provident fund trust, and gratuity benefits."
  },
  {
    icon: "🏥",
    title: "Health & Well-being Coverage",
    desc: "Comprehensive group health insurance covering outpatient and inpatient medical care for faculty and dependants."
  },
  {
    icon: "🏛️",
    title: "Modern Educational Infrastructure",
    desc: "ICT-enabled smart classrooms, advanced science and robotics labs, extensive research libraries, and green campus grounds."
  }
];

const openPositions = [
  {
    title: "Senior School Faculty – Physics & Mathematics",
    section: "Cambridge O/A Level & Matriculation",
    experience: "3+ Years",
    type: "Full-Time",
    deadline: "Open until filled"
  },
  {
    title: "IB PYP Homeroom Educators",
    section: "Junior Section (IB Continuum)",
    experience: "2+ Years in Inquiry-Based Learning",
    type: "Full-Time",
    deadline: "Session 2026-27 Intake"
  },
  {
    title: "English Language & Literature Instructors",
    section: "Middle & Senior School",
    experience: "CELTA / Delta or Master's in English",
    type: "Full-Time",
    deadline: "Immediate"
  },
  {
    title: "Robotics & Computer Science Mentor",
    section: "Robotics Academy & Emerging Tech",
    experience: "STEM / Arduino / Python background",
    type: "Full-Time",
    deadline: "Open until filled"
  },
  {
    title: "Montessori Directress / Early Years Educator",
    section: "Crescent Early Years (Pre-K to K2)",
    experience: "AMI / Montessori Diploma",
    type: "Full-Time",
    deadline: "Session 2026-27 Intake"
  }
];
---

<Layout 
  title="Careers & Job Opportunities – Crescent School"
  description="Join the esteemed teaching and administrative faculty at Crescent Model Higher Secondary School Lahore. Explore open positions and submit your application online."
>
  <!-- Standard Top Page Hero Banner -->
  <section class="page_hero_banner">
    <div class="container">
      <div class="hero_breadcrumbs">
        <a href="/">Home</a>
        <span>/</span>
        <span class="current">Careers</span>
      </div>
      <h1 class="hero_page_title">Careers at Crescent School</h1>
      <p class="hero_subtitle">Empowering educators to inspire the leaders of tomorrow. Discover rewarding career opportunities at Crescent.</p>
    </div>
  </section>

  <!-- Welcome / Culture Strip -->
  <section class="careers_welcome_section">
    <div class="container">
      <div class="welcome_card">
        <span class="sub_badge">BE PART OF OUR MISSION</span>
        <h2 class="section_heading">Inspire, Innovate, and Grow With Us</h2>
        <p class="lead_text">
          At Crescent Model Higher Secondary School, our educators are the heartbeat of our 58-year legacy. We seek passionate, reflective, and driven educational professionals who share our commitment to moral integrity, academic brilliance, and holistic student development.
        </p>
        <p class="body_text">
          Whether you are an experienced Cambridge subject specialist, an inquiry-driven IB practitioner, or a dynamic administrative professional, Crescent provides an environment where your talents are celebrated and nurtured.
        </p>
      </div>
    </div>
  </section>

  <!-- Why Work At Crescent Grid -->
  <section class="benefits_section">
    <div class="container">
      <div class="section_header_center">
        <span class="sub_badge">FACULTY BENEFITS</span>
        <h2 class="section_title">Why Teach at Crescent School?</h2>
        <div class="title-decorator"></div>
      </div>

      <div class="benefits_grid">
        {whyWorkAtCrescent.map(b => (
          <div class="benefit_card">
            <div class="b_icon">{b.icon}</div>
            <h3>{b.title}</h3>
            <p>{b.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Current Openings -->
  <section class="openings_section">
    <div class="container">
      <div class="section_header_center">
        <span class="sub_badge">CURRENT VACANCIES</span>
        <h2 class="section_title">Open Faculty Positions</h2>
        <div class="title-decorator"></div>
      </div>

      <div class="openings_list">
        {openPositions.map(pos => (
          <div class="opening_card">
            <div class="pos_info">
              <h3>{pos.title}</h3>
              <div class="pos_meta">
                <span class="pos_tag">🏫 {pos.section}</span>
                <span class="pos_tag">⏱️ {pos.type}</span>
                <span class="pos_tag">🎯 {pos.experience}</span>
              </div>
            </div>
            <div class="pos_action">
              <span class="deadline_text">Status: {pos.deadline}</span>
              <a href="#apply_section" class="btn_apply_pos">Apply Now &rarr;</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Interactive Job Application Form -->
  <section class="application_form_section" id="apply_section">
    <div class="container">
      <div class="app_form_wrapper">
        <div class="form_header">
          <span class="sub_badge">ONLINE APPLICATION</span>
          <h3>Submit Your Employment Application</h3>
          <p>Complete the candidate dossier below. Our Human Resources Directorate evaluates applications on a rolling basis.</p>
        </div>

        <form id="career_form" class="styled_career_form">
          <div class="form_grid_3">
            <div class="form_group">
              <label for="full_name">Full Name *</label>
              <input type="text" id="full_name" name="name" required placeholder="Full Name" class="form_input" />
            </div>

            <div class="form_group">
              <label for="gender">Gender *</label>
              <select id="gender" name="gender" required class="form_select">
                <option value="" disabled selected>-- Select Gender --</option>
                <option value="Male">Male</option>
                <option value="Female">Female</option>
              </select>
            </div>

            <div class="form_group">
              <label for="dob">Date of Birth *</label>
              <input type="date" id="dob" name="dob" required class="form_input" />
            </div>
          </div>

          <div class="form_grid_3">
            <div class="form_group">
              <label for="email">Email Address *</label>
              <input type="email" id="email" name="email" required placeholder="name@domain.com" class="form_input" />
            </div>

            <div class="form_group">
              <label for="phone">Mobile Contact Number *</label>
              <input type="tel" id="phone" name="phone" required placeholder="03XX-XXXXXXX" class="form_input" />
            </div>

            <div class="form_group">
              <label for="position_applied">Position Applied For *</label>
              <select id="position_applied" name="position" required class="form_select">
                <option value="" disabled selected>-- Select Position --</option>
                <option value="Senior School Science/Math">Senior School Science / Mathematics</option>
                <option value="Cambridge O/A Level Subject Specialist">Cambridge O/A Level Subject Specialist</option>
                <option value="IB Homeroom / PYP Educator">IB Homeroom / PYP Educator</option>
                <option value="English Language & Literature">English Language & Literature</option>
                <option value="Robotics / Computer Science">Robotics / Computer Science</option>
                <option value="Early Years Montessori Directress">Early Years Montessori Directress</option>
                <option value="Administrative / Support Staff">Administrative / Support Staff</option>
              </select>
            </div>
          </div>

          <div class="form_grid_2">
            <div class="form_group">
              <label for="qualification">Highest Degree / Qualification *</label>
              <input type="text" id="qualification" name="qualification" required placeholder="e.g. M.Phil Physics, MA English, BS CS" class="form_input" />
            </div>

            <div class="form_group">
              <label for="experience">Total Years of Relevant Experience *</label>
              <input type="text" id="experience" name="experience" required placeholder="e.g. 5 Years" class="form_input" />
            </div>
          </div>

          <div class="form_group">
            <label for="resume_file">Upload CV / Resume (PDF or Word document, max 5MB)</label>
            <input type="file" id="resume_file" name="resume" accept=".pdf,.doc,.docx" class="form_file" />
          </div>

          <div class="form_group">
            <label for="cover_note">Cover Statement / Professional Profile</label>
            <textarea id="cover_note" name="cover_note" rows="4" placeholder="Briefly describe your educational philosophy and achievements..." class="form_textarea"></textarea>
          </div>

          <button type="submit" class="btn_submit_career">Submit Job Application &rarr;</button>
        </form>

        <div id="career_success_alert" class="success_alert" style="display: none;">
          <div class="alert_icon">📋</div>
          <h4>Application Received Successfully!</h4>
          <p>Thank you for your interest in joining Crescent School. Shortlisted candidates will be contacted by our HR department for preliminary assessments and panel interviews.</p>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  const careerForm = document.getElementById('career_form') as HTMLFormElement;
  const careerAlert = document.getElementById('career_success_alert');

  if (careerForm && careerAlert) {
    careerForm.addEventListener('submit', (e) => {
      e.preventDefault();
      careerForm.style.display = 'none';
      careerAlert.style.display = 'block';
    });
  }
</script>

<style>
  .sub_badge {
    display: inline-block;
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: var(--primary-color);
    background: rgba(0, 33, 71, 0.08);
    padding: 5px 12px;
    border-radius: 16px;
    margin-bottom: 12px;
    text-transform: uppercase;
  }

  .careers_welcome_section {
    padding: 70px 0 40px;
    background: var(--bg-white);
  }

  .welcome_card {
    max-width: 860px;
    margin: 0 auto;
    text-align: center;
  }

  .section_heading {
    font-size: clamp(26px, 3.2vw, 36px);
    color: var(--primary-color);
    margin-bottom: 18px;
    line-height: 1.3;
  }

  .lead_text {
    font-size: 16.5px;
    line-height: 1.7;
    color: var(--primary-light);
    font-weight: 500;
    margin-bottom: 16px;
  }

  .body_text {
    font-size: 14.5px;
    line-height: 1.8;
    color: var(--text-muted);
  }

  /* Benefits */
  .benefits_section {
    padding: 70px 0;
    background: var(--bg-light);
  }

  .section_header_center {
    text-align: center;
    max-width: 700px;
    margin: 0 auto 50px;
  }

  .benefits_grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 25px;
  }

  .benefit_card {
    background: #ffffff;
    border-radius: var(--radius-md);
    padding: 30px 24px;
    border: 1px solid var(--border-light);
    box-shadow: var(--shadow-sm);
    transition: all 0.3s ease;
  }

  .benefit_card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    border-color: var(--accent-gold);
  }

  .b_icon {
    font-size: 34px;
    margin-bottom: 14px;
  }

  .benefit_card h3 {
    font-size: 17.5px;
    color: var(--primary-color);
    margin: 0 0 10px 0;
  }

  .benefit_card p {
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--text-muted);
    margin: 0;
  }

  /* Openings List */
  .openings_section {
    padding: 70px 0;
    background: var(--bg-white);
  }

  .openings_list {
    max-width: 900px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .opening_card {
    background: #fbfcfe;
    border: 1px solid var(--border-light);
    border-left: 4px solid var(--primary-color);
    border-radius: var(--radius-md);
    padding: 24px 28px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    transition: all 0.2s ease;
  }

  .opening_card:hover {
    background: #ffffff;
    border-color: var(--accent-gold);
    border-left-color: var(--accent-gold);
    box-shadow: var(--shadow-sm);
  }

  .pos_info h3 {
    font-size: 18px;
    color: var(--primary-color);
    margin: 0 0 8px 0;
  }

  .pos_meta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .pos_tag {
    font-size: 12.5px;
    color: var(--text-muted);
    background: #ffffff;
    padding: 3px 8px;
    border-radius: 4px;
    border: 1px solid var(--border-light);
  }

  .pos_action {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 8px;
    flex-shrink: 0;
  }

  .deadline_text {
    font-size: 11.5px;
    color: var(--text-muted);
  }

  .btn_apply_pos {
    background: var(--primary-color);
    color: #ffffff;
    font-size: 13px;
    font-weight: 700;
    padding: 9px 18px;
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .btn_apply_pos:hover {
    background: var(--accent-gold);
    color: var(--primary-dark);
  }

  /* Form */
  .application_form_section {
    padding: 70px 0;
    background: var(--bg-light);
  }

  .app_form_wrapper {
    max-width: 900px;
    margin: 0 auto;
    background: #ffffff;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-light);
    padding: 40px;
    box-shadow: var(--shadow-sm);
  }

  .form_header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--border-light);
  }

  .form_header h3 {
    font-size: 22px;
    color: var(--primary-color);
    margin: 0 0 6px 0;
  }

  .form_header p {
    font-size: 13.5px;
    color: var(--text-muted);
    margin: 0;
  }

  .styled_career_form {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .form_grid_3 {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }

  .form_grid_2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }

  .form_group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .form_group label {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-dark);
  }

  .form_input,
  .form_select,
  .form_textarea,
  .form_file {
    padding: 10px 14px;
    border: 1px solid var(--border-light);
    border-radius: var(--radius-sm);
    font-size: 14px;
    background: #fbfcfe;
  }

  .form_input:focus,
  .form_select:focus,
  .form_textarea:focus {
    outline: none;
    border-color: var(--primary-color);
    background: #ffffff;
  }

  .btn_submit_career {
    background: var(--primary-color);
    color: #ffffff;
    font-size: 14px;
    font-weight: 700;
    padding: 13px 28px;
    border: none;
    border-radius: var(--radius-sm);
    cursor: pointer;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    transition: all 0.2s ease;
    align-self: flex-start;
  }

  .btn_submit_career:hover {
    background: var(--primary-light);
  }

  .success_alert {
    text-align: center;
    padding: 30px;
  }

  .alert_icon {
    font-size: 42px;
    margin-bottom: 12px;
  }

  .success_alert h4 {
    font-size: 20px;
    color: #137333;
    margin-bottom: 8px;
  }

  .success_alert p {
    font-size: 14px;
    color: var(--text-muted);
  }

  @media (max-width: 768px) {
    .opening_card {
      flex-direction: column;
      align-items: flex-start;
    }
    .pos_action {
      align-items: flex-start;
      width: 100%;
    }
    .form_grid_3,
    .form_grid_2 {
      grid-template-columns: 1fr;
    }
  }
</style>
