---
import Layout from '../layouts/Layout.astro';
import { getMediaUrl } from '../utils/media';
---

<Layout 
  title="School of Music – Crescent School"
  description="Explore the School of Music at Crescent School. Cultivating acoustic excellence, auditory perception, instrumental mastery, and musical intelligence in Lahore."
>
  <!-- Standard Top Page Hero Banner -->
  <section class="page_hero_banner">
    <div class="container">
      <div class="hero_breadcrumbs">
        <a href="/">Home</a>
        <span>/</span>
        <span>Our Institution</span>
        <span>/</span>
        <span>Schools of Renaissance</span>
        <span>/</span>
        <span class="current">School of Music</span>
      </div>
      <h1 class="hero_page_title">School of Music</h1>
      <p class="hero_subtitle">Awakening auditory intelligence, instrumental fluency, and the sublime harmony of orchestral expression.</p>
    </div>
  </section>

  <!-- Quote & Cognitive Introduction -->
  <section class="music_intro_section">
    <div class="container">
      <div class="quote_banner_box">
        <div class="quote_mark">“</div>
        <p class="quote_text">Music gives a soul to the universe, wings to the mind, flight to the imagination and life to everything.</p>
        <span class="quote_author">— Plato</span>
      </div>

      <div class="intro_grid">
        <div class="intro_text">
          <span class="sub_badge">COGNITIVE HARMONY</span>
          <h2 class="section_heading">Unlocking Linguistic & Mathematical Brilliance</h2>
          <div class="lead_text">
            Students who undergo musical training cultivate advanced neurological development across brain regions closely linked to language, reasoning, and spatial-temporal reasoning.
          </div>
          <p class="body_paragraph">
            The left side of the brain is better developed with music, and the songs can help imprint information on young minds. Musical training enhances spatial intelligence, mathematical agility, emotional sensitivity, and self-confidence.
          </p>
          <p class="body_paragraph">
            The School of Music at Crescent provides a structured pedagogical environment equipped with acoustic practice suites, digital audio workstations, and a diverse range of classical Eastern and Western musical instruments.
          </p>

          <div class="curriculum_focus_box">
            <h3>The Music Curriculum Focuses On:</h3>
            <ul class="focus_list">
              <li>✓ <strong>Musical Foundations:</strong> Mastery of tone, pitch, chords, meter, rhythm, and melodic contours.</li>
              <li>✓ <strong>Instrumental Literacy:</strong> Formal musical sheet reading, notation, solfège, and acoustic dynamics.</li>
              <li>✓ <strong>Orchestral Collaboration:</strong> Ensemble rehearsals, chamber choirs, brass bands, and live stage performance.</li>
              <li>✓ <strong>Cultural Heritage:</strong> Classical eastern raagas, patriotic anthems, and international choral repertoire.</li>
            </ul>
          </div>
        </div>

        <div class="intro_media">
          <div class="media_card">
            <img 
              src={getMediaUrl("/images/batch4/music_mac.jpg")} 
              alt="Crescent School Music Studio" 
              loading="lazy"
              onerror="this.src='/images/welcome_side.jpg'"
            />
            <span class="media_caption">Students training on keyboards and acoustic instruments</span>
          </div>
          <div class="media_card">
            <img 
              src={getMediaUrl("/images/batch4/music_mac2.jpg")} 
              alt="Music Performance and Training" 
              loading="lazy"
              onerror="this.src='/images/hero_slider_1.jpg'"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Instrument Disciplines -->
  <section class="instruments_section">
    <div class="container">
      <div class="section_header_center">
        <span class="sub_badge">INSTRUMENTAL TRAINING</span>
        <h2 class="section_title">Instrumental & Vocal Disciplines</h2>
        <div class="title-decorator"></div>
      </div>

      <div class="instruments_grid">
        <div class="instrument_card">
          <div class="inst_icon">
            <img src={getMediaUrl("/images/batch4/music_sheet.png")} alt="Sheet Music" />
          </div>
          <h3>Piano & Keyboard</h3>
          <p>Sight-reading, hand independence, classical sonatinas, modern chord progressions, and synthesizer orchestration.</p>
        </div>

        <div class="instrument_card">
          <div class="inst_icon">
            <img src={getMediaUrl("/images/batch4/music_gospel.png")} alt="Strings & Violin" />
          </div>
          <h3>Strings & Violin</h3>
          <p>Posture, bow control, pitch intonation, classical chamber music, and solo violin performance techniques.</p>
        </div>

        <div class="instrument_card">
          <div class="inst_icon">
            <img src={getMediaUrl("/images/batch4/music_karaoke.png")} alt="Vocal Choir" />
          </div>
          <h3>Vocal Choir & Anthems</h3>
          <p>Breath support, vocal range expansion, harmonic choral singing, diction, and national anthem performances.</p>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .sub_badge {
    display: inline-block;
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: var(--primary-color);
    background: rgba(0, 33, 71, 0.08);
    padding: 5px 12px;
    border-radius: 16px;
    margin-bottom: 12px;
    text-transform: uppercase;
  }

  .music_intro_section {
    padding: 70px 0 90px;
    background: var(--bg-white);
  }

  .quote_banner_box {
    background: linear-gradient(135deg, #002147 0%, #001733 100%);
    color: #ffffff;
    border-radius: var(--radius-md);
    padding: 40px;
    text-align: center;
    margin-bottom: 60px;
    border-bottom: 4px solid var(--accent-gold);
    box-shadow: var(--shadow-md);
  }

  .quote_mark {
    font-size: 60px;
    line-height: 1;
    color: var(--accent-gold);
    font-family: serif;
    margin-bottom: 6px;
  }

  .quote_text {
    font-size: clamp(20px, 2.8vw, 26px);
    font-family: var(--font-heading);
    font-style: italic;
    color: #ffffff;
    margin-bottom: 10px;
    max-width: 900px;
    margin-left: auto;
    margin-right: auto;
  }

  .quote_author {
    font-size: 15px;
    color: var(--accent-gold);
    font-weight: 600;
  }

  .intro_grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 50px;
    align-items: center;
  }

  .section_heading {
    font-size: clamp(26px, 3.2vw, 36px);
    color: var(--primary-color);
    margin-bottom: 18px;
    line-height: 1.3;
  }

  .lead_text {
    font-size: 17px;
    font-weight: 600;
    line-height: 1.65;
    color: var(--primary-light);
    margin-bottom: 16px;
  }

  .body_paragraph {
    font-size: 15px;
    line-height: 1.8;
    color: var(--text-muted);
    margin-bottom: 16px;
  }

  .curriculum_focus_box {
    margin-top: 26px;
    background: var(--bg-light);
    border-radius: var(--radius-md);
    padding: 24px;
    border-left: 4px solid var(--accent-gold);
  }

  .curriculum_focus_box h3 {
    font-size: 17px;
    color: var(--primary-color);
    margin-bottom: 14px;
  }

  .focus_list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-dark);
  }

  .intro_media {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .media_card {
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    background: #ffffff;
    border: 4px solid #ffffff;
  }

  .media_card img {
    width: 100%;
    height: 240px;
    object-fit: cover;
  }

  .media_caption {
    display: block;
    font-size: 12px;
    color: var(--text-muted);
    padding: 8px 12px;
    background: #ffffff;
    text-align: center;
  }

  .instruments_section {
    padding: 80px 0 100px;
    background: var(--bg-light);
  }

  .section_header_center {
    text-align: center;
    max-width: 700px;
    margin: 0 auto 50px;
  }

  .instruments_grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 30px;
  }

  .instrument_card {
    background: #ffffff;
    border-radius: var(--radius-md);
    padding: 38px 28px;
    border: 1px solid var(--border-light);
    box-shadow: var(--shadow-sm);
    text-align: center;
    transition: all 0.3s ease;
    border-top: 4px solid var(--accent-gold);
  }

  .instrument_card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-lg);
  }

  .inst_icon {
    width: 70px;
    height: 70px;
    margin: 0 auto 20px;
    background: rgba(0, 33, 71, 0.04);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 12px;
  }

  .inst_icon img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .instrument_card h3 {
    font-size: 20px;
    color: var(--primary-color);
    margin-bottom: 12px;
  }

  .instrument_card p {
    font-size: 14px;
    line-height: 1.65;
    color: var(--text-muted);
  }

  @media (max-width: 900px) {
    .intro_grid {
      grid-template-columns: 1fr;
    }
  }
</style>
