---
import Layout from '../layouts/Layout.astro';
import { getMediaUrl } from '../utils/media';

// Exact 4 Legacy Slider Frames matching user reference images
const heroSlides = [
  {
    image: '/images/hero_slider_1.jpg',
    title: 'Rich History Exceeding Fifty Years',
    desc: 'With a rich history exceeding fifty years, the Crescent Model Higher Secondary School has maintained its glorious tradition of providing quality education, trained staff and merit based and need blind admission policy.',
    align: 'right'
  },
  {
    image: '/images/hero_slider_2.jpg',
    title: 'Providing Quality Education',
    desc: '',
    align: 'right'
  },
  {
    image: '/images/hero_slider_3.jpg',
    title: 'Dedicated Faculty',
    desc: '',
    align: 'right'
  },
  {
    image: '/images/hero_slider_4.png',
    title: 'Merit Based & Need Blind Admission Policy',
    desc: '',
    align: 'right'
  }
];

const schoolWings = [
  {
    name: 'Crescent Early Years',
    badge: 'Playgroup to Prep',
    logo: '/images/logo_early_years.png',
    desc: 'Foundational learning based on playful inquiry, social-emotional development, and early cognitive mastery in dedicated nurturing spaces.',
    link: '/crescent-early-years_primary-section/'
  },
  {
    name: 'The Crescent School',
    badge: 'Primary to Matriculation',
    logo: '/images/logo_school.png',
    desc: 'Rigorous national curriculum enriched with character education, STEM foundations, and an outstanding legacy of top board positions.',
    link: '/middle-school/'
  },
  {
    name: 'The Crescent College',
    badge: 'Intermediate (HSSC)',
    logo: '/images/logo_college.png',
    desc: 'Premier college education offering F.Sc (Pre-Medical/Pre-Engineering), ICS, and I.Com with top university admissions placement.',
    link: '/the-crescent-college/'
  },
  {
    name: 'Cambridge & IB Section',
    badge: 'O/A Levels & IB MYP/DP/CP',
    logo: '/images/logo_cambridge.png',
    desc: 'World-recognized international qualifications including Cambridge CAIE O & A Levels and International Baccalaureate (IB) programmes.',
    link: '/cambridge-section/'
  }
];

const stats = [
  { value: '55+', label: 'Years of Legacy', sub: 'Established in 1968' },
  { value: '9,000+', label: 'Active Students', sub: 'One of Pakistan\'s Largest Not-for-Profits' },
  { value: '500+', label: 'Qualified Educators', sub: 'Trained Faculty & Cambridge Mentors' },
  { value: '100%', label: 'Merit & Need-Blind', sub: 'Scholarships for Deserving Talent' }
];

const achievements = [
  { image: '/images/achievement_1.jpeg', title: 'Top Board Positions & High Honors' },
  { image: '/images/achievement_2.jpeg', title: 'Outstanding Academic Distinction' },
  { image: '/images/achievement_3.jpeg', title: 'National & Regional Competitions' },
  { image: '/images/achievement_4.jpeg', title: 'Excellence in Extracurriculars & Debate' }
];

const partners = [
  { name: 'IB World School', image: '/images/partner_ib.jpg' },
  { name: 'Pearson Edexcel', image: '/images/partner_pearson.png' },
  { name: 'Gavel Clubs', image: '/images/partner_gavel.png' },
  { name: 'DSP', image: '/images/partner_dsp.png' },
  { name: 'USEFP', image: '/images/partner_usefp.png' },
  { name: 'Alliance Française', image: '/images/partner_alliance.png' },
  { name: 'Rizq Foundation', image: '/images/partner_rizq.png' },
  { name: 'ITTI', image: '/images/partner_itti.png' },
  { name: 'IML', image: '/images/partner_iml.png' },
  { name: 'ICoTS', image: '/images/partner_icots.png' },
  { name: 'Orange Tree', image: '/images/partner_orange.png' }
];
---

<Layout 
  title="Crescent School – Faith – Unity – Discipline | Lahore"
  description="Official portal of Crescent Model Higher Secondary School (Crescent School), Lahore. Founded in 1968, fostering over 9,000 students in Cambridge O/A Levels, IB Programmes, Matriculation, and Intermediate College."
>
  <!-- 1. Legacy Full-Bleed Slider (100% Unobstructed Image Clarity, Minimal Semi-Transparent Text Overlay) -->
  <section class="legacy-slider-section" aria-label="Campus Highlights">
    <div class="slider-wrapper" id="heroCarousel">
      {heroSlides.map((slide, idx) => (
        <div class={`slide-item ${idx === 0 ? 'active' : ''}`}>
          <!-- 100% Natural, Unfiltered Campus Photograph -->
          <img 
            src={getMediaUrl(slide.image)} 
            alt={slide.title} 
            class="slide-img" 
            loading={idx === 0 ? 'eager' : 'lazy'} 
          />

          <!-- Minimal Floating Semi-Transparent Text Overlay exactly like Legacy Site -->
          <div class="container text-overlay-container">
            <div class={`legacy-text-box align-${slide.align}`}>
              <h2 class="legacy-title">{slide.title}</h2>
              {slide.desc && <p class="legacy-desc">{slide.desc}</p>}
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Legacy Style Left / Right Navigation Chevrons -->
    <button class="slider-arrow prev-arrow" id="heroPrev" aria-label="Previous Slide">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"></polyline></svg>
    </button>
    <button class="slider-arrow next-arrow" id="heroNext" aria-label="Next Slide">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
    </button>
  </section>

  <!-- 2. Four Wings / Academic Pillars Grid -->
  <section class="academic-wings-section">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">Four Pillars of Academic Excellence</h2>
        <div class="title-decorator"></div>
        <p class="section-subtitle">
          From early childhood inquiry to internationally accredited college credentials, Crescent School provides tailored pedagogical pathways for every learner.
        </p>
      </div>

      <div class="wings-grid">
        {schoolWings.map(wing => (
          <div class="wing-card">
            <div class="wing-badge">{wing.badge}</div>
            <div class="wing-logo-wrap">
              <img src={getMediaUrl(wing.logo)} alt={wing.name} class="wing-logo" width="90" height="90" loading="lazy" />
            </div>
            <h3 class="wing-title">{wing.name}</h3>
            <p class="wing-desc">{wing.desc}</p>
            <a href={wing.link} class="wing-link">
              <span>Learn More</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. Welcome to Our School (1:1 Exact Legacy Layout Parity) -->
  <section class="welcome-section">
    <div class="container welcome-container">
      <div class="welcome-grid">
        <!-- Left Column: Typography & Text Content -->
        <div class="welcome-text-col">
          <h2 class="welcome-heading">Welcome to Our School</h2>
          
          <div class="welcome-body-content">
            <p class="welcome-lead">
              <strong>Welcome to The Crescent Model Higher Secondary School. The journey of Crescent Model School started in 1968 with a small group of leading educationists with big dreams of providing affordable education to the young generation of Pakistan.</strong>
            </p>
            
            <p class="welcome-desc">
              A handful of students has now turned into a student body of 9000+, one of the largest Not for Profit schools in Pakistan which is no less than a miracle. With a rich history exceeding fifty years, the Crescent Model Higher Secondary School has maintained its glorious tradition of providing quality education, trained staff and merit based and need blind admission policy. We strive to provide quality education for the next generations and enlighten our students intellectually, morally and spiritually during their years with us. And that is our vision for 2050.
            </p>

            <a href="/about-us/" class="welcome-readmore">READ MORE</a>
          </div>
        </div>

        <!-- Right Column: Single Clean Campus Image Carousel / Frame -->
        <div class="welcome-media-col">
          <div class="welcome-carousel-wrapper" id="welcomeCarousel">
            <div class="welcome-slide active">
              <img src={getMediaUrl('/images/welcome_early_years.jpg')} alt="Crescent Early Years" class="welcome-img" />
            </div>
            <div class="welcome-slide">
              <img src={getMediaUrl('/images/welcome_side.jpg')} alt="Campus Architecture" class="welcome-img" />
            </div>
            
            <!-- Carousel Controls -->
            <button class="welcome-carousel-btn prev" id="welcomePrev" aria-label="Previous Image">‹</button>
            <button class="welcome-carousel-btn next" id="welcomeNext" aria-label="Next Image">›</button>
            <div class="welcome-dots" id="welcomeDots">
              <span class="w-dot active" data-idx="0"></span>
              <span class="w-dot" data-idx="1"></span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Numerical Impact / Vital Statistics -->
  <section class="stats-section">
    <div class="container stats-grid">
      {stats.map(s => (
        <div class="stat-box">
          <div class="stat-value">{s.value}</div>
          <div class="stat-label">{s.label}</div>
          <div class="stat-sub">{s.sub}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- 5. High Achievements Showcase -->
  <section class="achievements-section">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">High Achievements</h2>
        <div class="title-decorator"></div>
        <p class="section-subtitle">
          Celebrating outstanding accolades, board distinctions, and student triumphs across academics, sports, and leadership.
        </p>
      </div>

      <div class="achievements-grid">
        {achievements.map((item, i) => (
          <div class="achievement-card">
            <div class="achieve-img-wrap">
              <img src={getMediaUrl(item.image)} alt={item.title} loading="lazy" />
              <div class="achieve-overlay">
                <span class="achieve-badge">Distinction #{i + 1}</span>
              </div>
            </div>
            <div class="achieve-info">
              <h4 class="achieve-title">{item.title}</h4>
            </div>
          </div>
        ))}
      </div>

      <div class="achieve-footer-cta">
        <a href="/hall-of-fame/" class="btn-primary">View Hall of Fame & Merit Lists</a>
      </div>
    </div>
  </section>

  <!-- 6. Accreditations & Educational Partners -->
  <section class="partners-section">
    <div class="container">
      <div class="partners-header">
        <span class="partners-badge">Global Recognition</span>
        <h3 class="partners-title">Accreditations, Affiliations & Educational Collaborations</h3>
      </div>
      
      <div class="partners-logo-strip">
        {partners.map(p => (
          <div class="partner-item" title={p.name}>
            <img src={getMediaUrl(p.image)} alt={p.name} loading="lazy" width="100" height="70" />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 7. Admission Prompt Banner -->
  <section class="admission-banner-section">
    <div class="container banner-inner">
      <div class="banner-text">
        <h2>Begin Your Journey with Crescent School</h2>
        <p>Admissions open for Early Years, Junior School, Senior School, O/A Levels, and College. Experience holistic, value-driven education.</p>
      </div>
      <div class="banner-buttons">
        <a href="/online-application-form/" class="btn-banner-apply">Online Admission Enquiry</a>
        <a href="/am-i-eligible/early-years/" class="btn-banner-eligibility">Check Eligibility Criteria</a>
      </div>
    </div>
  </section>
</Layout>

<script>
  // Simple Slide Transition
  const slides = document.querySelectorAll<HTMLElement>('.slide-item');
  const prevBtn = document.getElementById('heroPrev');
  const nextBtn = document.getElementById('heroNext');
  let currentIdx = 0;
  let timer: number;

  function showSlide(index: number) {
    if (!slides.length) return;
    slides.forEach(s => s.classList.remove('active'));
    currentIdx = (index + slides.length) % slides.length;
    slides[currentIdx].classList.add('active');
  }

  function startAutoPlay() {
    stopAutoPlay();
    timer = window.setInterval(() => {
      showSlide(currentIdx + 1);
    }, 5500);
  }

  function stopAutoPlay() {
    if (timer) clearInterval(timer);
  }

  prevBtn?.addEventListener('click', () => {
    showSlide(currentIdx - 1);
    startAutoPlay();
  });

  nextBtn?.addEventListener('click', () => {
    showSlide(currentIdx + 1);
    startAutoPlay();
  });

  startAutoPlay();

  // Welcome Carousel script
  const wSlides = document.querySelectorAll<HTMLElement>('.welcome-slide');
  const wDots = document.querySelectorAll<HTMLElement>('#welcomeDots .w-dot');
  const wPrev = document.getElementById('welcomePrev');
  const wNext = document.getElementById('welcomeNext');
  let wIdx = 0;

  function showWelcomeSlide(idx: number) {
    if (!wSlides.length) return;
    wSlides.forEach(s => s.classList.remove('active'));
    wDots.forEach(d => d.classList.remove('active'));
    wIdx = (idx + wSlides.length) % wSlides.length;
    wSlides[wIdx].classList.add('active');
    wDots[wIdx]?.classList.add('active');
  }

  wPrev?.addEventListener('click', () => showWelcomeSlide(wIdx - 1));
  wNext?.addEventListener('click', () => showWelcomeSlide(wIdx + 1));
  wDots.forEach((dot, i) => dot.addEventListener('click', () => showWelcomeSlide(i)));

  // Auto-play welcome carousel every 5s
  setInterval(() => showWelcomeSlide(wIdx + 1), 5000);
</script>

<style>
  /* Legacy Slider Section (100% Unobstructed Photo Clarity) */
  .legacy-slider-section {
    position: relative;
    width: 100%;
    height: 540px;
    background: #000000;
    overflow: hidden;
  }

  .slider-wrapper {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .slide-item {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.8s ease-in-out, visibility 0.8s;
  }

  .slide-item.active {
    opacity: 1;
    visibility: visible;
  }

  /* Full crisp natural photo - 100% brightness */
  .slide-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  /* Floating Minimal Text Container - Placed near bottom exactly like legacy reference */
  .text-overlay-container {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
    pointer-events: none;
    padding: 0 60px 48px;
  }

  /* Minimal semi-transparent black strip exactly matching LayerSlider legacy */
  .legacy-text-box {
    max-width: 780px;
    pointer-events: auto;
    text-align: left;
  }

  .legacy-title {
    display: inline-block;
    background-color: rgba(0, 0, 0, 0.45);
    color: #ffffff;
    font-family: 'Roboto', sans-serif;
    font-size: clamp(24px, 2.8vw, 36px);
    font-weight: 700;
    line-height: 1.25;
    padding: 10px 18px;
    margin-bottom: 8px;
    letter-spacing: 0.3px;
    border-radius: 2px;
    white-space: nowrap;
  }

  .legacy-desc {
    display: inline-block;
    background-color: rgba(0, 0, 0, 0.45);
    color: #ffffff;
    font-family: 'Roboto', sans-serif;
    font-size: 15.5px;
    line-height: 1.6;
    padding: 14px 18px;
    border-radius: 2px;
    margin-top: 6px;
  }

  /* Discrete Navigation Chevrons */
  .slider-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(0, 0, 0, 0.25);
    border: none;
    color: #ffffff;
    width: 44px;
    height: 60px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s ease, opacity 0.2s ease;
    opacity: 0.7;
    z-index: 10;
  }

  .slider-arrow:hover {
    background: rgba(0, 0, 0, 0.6);
    opacity: 1;
  }

  .slider-arrow svg {
    width: 28px;
    height: 28px;
  }

  .prev-arrow {
    left: 0;
    border-radius: 0 4px 4px 0;
  }

  .next-arrow {
    right: 0;
    border-radius: 4px 0 0 4px;
  }

  /* Academic Pillars */
  .academic-wings-section {
    padding: 75px 0 65px;
    background: #ffffff;
  }

  .section-header {
    text-align: center;
    margin-bottom: 45px;
  }

  .section-subtitle {
    max-width: 720px;
    margin: 0 auto;
    font-size: 15.5px;
    color: var(--text-muted);
  }

  .wings-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 26px;
  }

  .wing-card {
    background: var(--bg-light);
    border-radius: var(--radius-md);
    padding: 32px 24px 28px;
    border: 1px solid var(--border-light);
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
    position: relative;
    box-shadow: var(--shadow-sm);
  }

  .wing-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 14px 28px rgba(0, 33, 71, 0.12);
    border-color: var(--accent-gold);
    background: #ffffff;
  }

  .wing-badge {
    position: absolute;
    top: 16px;
    right: 16px;
    background: rgba(0, 33, 71, 0.08);
    color: var(--primary-color);
    font-size: 11.5px;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 12px;
  }

  .wing-logo-wrap {
    width: 80px;
    height: 80px;
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .wing-logo {
    max-height: 100%;
    width: auto;
    object-fit: contain;
  }

  .wing-title {
    font-size: 19px;
    color: var(--primary-color);
    margin-bottom: 12px;
    font-family: var(--font-heading);
  }

  .wing-desc {
    font-size: 13.5px;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 20px;
    flex: 1;
  }

  .wing-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 700;
    font-size: 13px;
    color: var(--primary-color);
  }

  .wing-link svg {
    width: 14px;
    height: 14px;
    transition: transform 0.2s ease;
  }

  .wing-card:hover .wing-link svg {
    transform: translateX(4px);
    color: var(--accent-gold-hover);
  }

  /* Welcome to Our School Section (Exact Legacy Elementor Layout) */
  .welcome-section {
    padding: 65px 0 75px;
    background: #ffffff;
    border-top: 1px solid #edf2f7;
  }

  .welcome-container {
    max-width: 1140px;
  }

  .welcome-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: center;
  }

  .welcome-text-col {
    padding-right: 15px;
  }

  .welcome-heading {
    font-size: 28px;
    font-family: 'Roboto', 'Open Sans', sans-serif;
    font-weight: 600;
    color: #222222;
    margin-bottom: 22px;
    line-height: 1.3;
  }

  .welcome-lead {
    font-size: 15px;
    line-height: 26px;
    color: #444444;
    margin-bottom: 16px;
  }

  .welcome-desc {
    font-size: 15px;
    line-height: 26px;
    color: #7a7a7a;
    margin-bottom: 22px;
  }

  .welcome-readmore {
    display: inline-block;
    font-size: 13.5px;
    font-weight: 700;
    color: #002147;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    border-bottom: 2px solid #FDC800;
    padding-bottom: 2px;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .welcome-readmore:hover {
    color: #FDC800;
    border-color: #002147;
  }

  /* Right Column Carousel */
  .welcome-media-col {
    position: relative;
    border-radius: 4px;
    overflow: hidden;
  }

  .welcome-carousel-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 544 / 570;
    max-height: 520px;
    background: #f1f5f9;
    border-radius: 4px;
    overflow: hidden;
  }

  .welcome-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.6s ease, visibility 0.6s;
  }

  .welcome-slide.active {
    opacity: 1;
    visibility: visible;
  }

  .welcome-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: 4px;
  }

  .welcome-carousel-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(0, 0, 0, 0.35);
    border: none;
    color: #ffffff;
    width: 36px;
    height: 48px;
    font-size: 24px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 5;
    transition: background 0.2s ease;
    border-radius: 2px;
  }

  .welcome-carousel-btn:hover {
    background: rgba(0, 0, 0, 0.7);
  }

  .welcome-carousel-btn.prev {
    left: 8px;
  }

  .welcome-carousel-btn.next {
    right: 8px;
  }

  .welcome-dots {
    position: absolute;
    bottom: 12px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 6px;
    z-index: 5;
  }

  .w-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.5);
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .w-dot.active {
    background: #ffffff;
  }

  .btn-primary {
    background: var(--accent-gold);
    color: #00132b !important;
    font-weight: 700;
    padding: 11px 22px;
    border-radius: 4px;
    font-size: 13.5px;
    text-transform: uppercase;
    letter-spacing: 0.4px;
    transition: var(--transition-fast);
  }

  .btn-primary:hover {
    background: var(--accent-gold-hover);
    transform: translateY(-2px);
  }

  .btn-outline {
    border: 2px solid var(--primary-color);
    color: var(--primary-color) !important;
    font-weight: 700;
    padding: 10px 22px;
    border-radius: 4px;
    font-size: 13.5px;
    text-transform: uppercase;
    transition: var(--transition-fast);
  }

  .btn-outline:hover {
    background: var(--primary-color);
    color: #ffffff !important;
  }

  /* Vital Statistics */
  .stats-section {
    background: var(--primary-gradient);
    color: #ffffff;
    padding: 60px 0;
    border-top: 3px solid var(--accent-gold);
    border-bottom: 3px solid var(--accent-gold);
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 30px;
    text-align: center;
  }

  .stat-value {
    font-size: 42px;
    font-weight: 800;
    font-family: var(--font-heading);
    color: var(--accent-gold);
    line-height: 1;
    margin-bottom: 8px;
  }

  .stat-label {
    font-size: 16px;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 4px;
  }

  .stat-sub {
    font-size: 12.5px;
