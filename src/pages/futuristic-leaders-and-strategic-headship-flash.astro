---
import Layout from '../layouts/Layout.astro';
import { getMediaUrl } from '../utils/media';

const leadershipPillars = [
  {
    num: "01",
    title: "Strategic Vision & Systems Thinking",
    desc: "Equipping academic heads to design long-range institutional strategies, forecast educational trends, and align departmental targets with global standards."
  },
  {
    num: "02",
    title: "Proactive Decision-Making & Agility",
    desc: "Strengthening analytical frameworks for swift, data-informed governance, mitigating institutional risks, and seizing transformative opportunities."
  },
  {
    num: "03",
    title: "High-Performance Team Leadership",
    desc: "Fostering cultures of collaborative inquiry, mentoring faculty members, driving peer feedback, and nurturing instructional excellence across departments."
  },
  {
    num: "04",
    title: "Leading Transformative Change",
    desc: "Preparing leaders to embrace, manage, and implement educational reform with resilience, emotional intelligence, and confident communication."
  }
];

const programHighlights = [
  {
    icon: "🎯",
    title: "Mandatory Core Requirement",
    desc: "Compulsory professional benchmark for all middle-level coordinators, subject leads, and newly appointed institutional heads."
  },
  {
    icon: "📊",
    title: "Case-Study Driven Pedagogy",
    desc: "Real-world institutional problem scenarios, simulation drills, and cross-departmental strategic problem-solving labs."
  },
  {
    icon: "🤝",
    title: "Executive Mentorship",
    desc: "Personalized coaching sessions led by experienced institutional trustees, principals, and guest international education directors."
  },
  {
    icon: "📜",
    title: "Leadership Certification",
    desc: "Formal institutional credential signifying mastery of 21st-century educational administration and strategic headship."
  }
];
---

<Layout 
  title="Futuristic Leaders and Strategic Headship (FLASH) – Crescent School"
  description="Explore the Futuristic Leaders and Strategic Headship (FLASH) program at Crescent School. Mandatory leadership development cultivating forward-thinking educational administrators."
>
  <!-- Standard Top Page Hero Banner -->
  <section class="page_hero_banner">
    <div class="container">
      <div class="hero_breadcrumbs">
        <a href="/">Home</a>
        <span>/</span>
        <a href="/professional-development/">Professional Development</a>
        <span>/</span>
        <span class="current">FLASH</span>
      </div>
      <h1 class="hero_page_title">Futuristic Leaders & Strategic Headship (FLASH)</h1>
      <p class="hero_subtitle">Cultivating forward-thinking academic administrators equipped to lead the evolving 21st-century educational landscape.</p>
    </div>
  </section>

  <!-- Executive Overview Section -->
  <section class="flash_overview_section">
    <div class="container">
      <div class="intro_grid">
        <div class="intro_content">
          <span class="sub_badge">EXECUTIVE LEADERSHIP ACADEMY</span>
          <h2 class="section_heading">Cultivating Forward-Thinking Educational Leaders</h2>
          <div class="lead_text">
            <strong>FLASH</strong> is mandatory for all middle-level and newly joined leaders at Crescent School, meticulously designed to cultivate visionary administrators who are equipped to navigate and excel in an ever-evolving global educational landscape.
          </div>
          <p class="body_paragraph">
            These rigorous professional development sessions focus on instilling long-range strategic vision, fostering sustainable innovation, and elevating executive management capabilities that drive systemic, long-term institutional success.
          </p>
          <p class="body_paragraph">
            Key attributes of FLASH include encouraging a proactive mindset, strengthening objective decision-making, promoting empathetic yet rigorous team leadership, and preparing educational heads to champion transformative change with unwavering confidence and institutional integrity.
          </p>

          <div class="key_attributes_list">
            <div class="attr_item">
              <span class="attr_check">✓</span>
              <div>
                <strong>Proactive Strategic Mindset:</strong> Anticipating shifts in pedagogy, regulatory requirements, and student well-being rather than reacting to crises.
              </div>
            </div>
            <div class="attr_item">
              <span class="attr_check">✓</span>
              <div>
                <strong>Data-Informed Decision Making:</strong> Leveraging student assessment metrics, attendance data, and faculty observations to inform policy decisions.
              </div>
            </div>
            <div class="attr_item">
              <span class="attr_check">✓</span>
              <div>
                <strong>Empathetic Team Stewardship:</strong> Building trust, managing conflict constructively, and inspiring educators toward peak instructional performance.
              </div>
            </div>
          </div>
        </div>

        <div class="intro_visuals">
          <div class="featured_visual_card">
            <img 
              src={getMediaUrl("/images/batch5/flash_leadership.jpg")} 
              alt="FLASH Executive Leadership Seminar" 
              loading="lazy"
              onerror="this.src='/images/batch3/training_centre.jpg'"
            />
            <div class="visual_caption">
              <strong>Executive Session:</strong> Strategic alignment and educational headship workshop at Crescent School
            </div>
          </div>
          <div class="secondary_visual_card">
            <img 
              src={getMediaUrl("/images/batch5/cpd_workshop_11.jpg")} 
              alt="Collaborative Problem-Solving Lab" 
              loading="lazy"
              onerror="this.src='/images/batch5/cpd_workshop_4.jpg'"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Core Leadership Pillars -->
  <section class="pillars_section">
    <div class="container">
      <div class="section_header_center">
        <span class="sub_badge">CURRICULUM ARCHITECTURE</span>
        <h2 class="section_title">Four Pillars of the FLASH Framework</h2>
        <div class="title-decorator"></div>
        <p class="section_subtitle">A multi-dimensional curriculum tailored specifically for departmental coordinators, academic heads, and senior administrators.</p>
      </div>

      <div class="pillars_grid">
        {leadershipPillars.map((pillar) => (
          <div class="pillar_card">
            <div class="pillar_number">{pillar.num}</div>
            <h3>{pillar.title}</h3>
            <p>{pillar.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Program Highlights Grid -->
  <section class="highlights_section">
    <div class="container">
      <div class="section_header_center">
        <span class="sub_badge">ACADEMIC RIGOR</span>
        <h2 class="section_title">Why FLASH Sets the Standard</h2>
        <div class="title-decorator"></div>
      </div>

      <div class="highlights_grid">
        {programHighlights.map((hl) => (
          <div class="highlight_box">
            <div class="hl_icon">{hl.icon}</div>
            <h4>{hl.title}</h4>
            <p>{hl.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Banner -->
  <section class="cta_banner_section">
    <div class="container">
      <div class="cta_box">
        <div class="cta_text">
          <h3>Elevate Your Educational Leadership</h3>
          <p>Learn more about executive training schedules, nomination criteria, and professional growth opportunities at the Crescent Continuous Professional Development Center.</p>
        </div>
        <div class="cta_actions">
          <a href="/professional-development/" class="btn_gold">View All CPD Programmes</a>
          <a href="/about-us/" class="btn_ghost">Our Institutional Vision</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .sub_badge {
    display: inline-block;
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: var(--primary-color);
    background: rgba(0, 33, 71, 0.08);
    padding: 5px 12px;
    border-radius: 16px;
    margin-bottom: 12px;
    text-transform: uppercase;
  }

  .flash_overview_section {
    padding: 80px 0;
    background: var(--bg-white);
  }

  .intro_grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 50px;
    align-items: center;
  }

  .section_heading {
    font-size: clamp(26px, 3.2vw, 36px);
    color: var(--primary-color);
    margin-bottom: 18px;
    line-height: 1.3;
  }

  .lead_text {
    font-size: 17px;
    font-weight: 500;
    line-height: 1.65;
    color: var(--primary-light);
    margin-bottom: 16px;
  }

  .body_paragraph {
    font-size: 15px;
    line-height: 1.8;
    color: var(--text-muted);
    margin-bottom: 16px;
  }

  .key_attributes_list {
    margin-top: 24px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .attr_item {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--text-dark);
  }

  .attr_check {
    color: var(--accent-gold-hover);
    font-weight: 800;
    font-size: 16px;
    line-height: 1.4;
  }

  .intro_visuals {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .featured_visual_card,
  .secondary_visual_card {
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    background: #ffffff;
    border: 4px solid #ffffff;
  }

  .featured_visual_card img {
    width: 100%;
    height: 250px;
    object-fit: cover;
    display: block;
  }

  .secondary_visual_card img {
    width: 100%;
    height: 220px;
    object-fit: cover;
    display: block;
  }

  .visual_caption {
    padding: 10px 14px;
    font-size: 13px;
    color: var(--text-muted);
    background: #ffffff;
    border-top: 1px solid var(--border-light);
  }

  /* Pillars Section */
  .pillars_section {
    padding: 80px 0;
    background: var(--bg-light);
  }

  .section_header_center {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 50px;
  }

  .section_subtitle {
    margin-top: 14px;
    font-size: 15px;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .pillars_grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 26px;
  }

  .pillar_card {
    background: #ffffff;
    border-radius: var(--radius-md);
    padding: 34px 26px;
    border: 1px solid var(--border-light);
    box-shadow: var(--shadow-sm);
    position: relative;
    border-top: 4px solid var(--primary-color);
    transition: all 0.3s ease;
  }

  .pillar_card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-lg);
    border-top-color: var(--accent-gold);
  }

  .pillar_number {
    font-size: 28px;
    font-weight: 800;
    color: rgba(0, 33, 71, 0.12);
    margin-bottom: 12px;
    font-family: var(--font-heading);
  }

  .pillar_card h3 {
    font-size: 19px;
    color: var(--primary-color);
    margin-bottom: 10px;
  }

  .pillar_card p {
    font-size: 14px;
    line-height: 1.65;
    color: var(--text-muted);
  }

  /* Highlights Section */
  .highlights_section {
    padding: 80px 0;
    background: var(--bg-white);
  }

  .highlights_grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 24px;
  }

  .highlight_box {
    padding: 28px 22px;
    border-radius: var(--radius-md);
    background: var(--bg-light);
    border: 1px solid var(--border-light);
    transition: all 0.3s ease;
  }

  .highlight_box:hover {
    background: #ffffff;
    box-shadow: var(--shadow-md);
    border-color: var(--accent-gold);
    transform: translateY(-3px);
  }

  .hl_icon {
    font-size: 32px;
    margin-bottom: 14px;
  }

  .highlight_box h4 {
    font-size: 17px;
    color: var(--primary-color);
    margin-bottom: 8px;
  }

  .highlight_box p {
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--text-muted);
  }

  /* CTA Banner */
  .cta_banner_section {
    padding: 0 0 80px;
    background: var(--bg-white);
  }

  .cta_box {
    background: linear-gradient(135deg, var(--primary-dark) 0%, var(--primary-color) 100%);
    color: #ffffff;
    border-radius: var(--radius-lg);
    padding: 44px 48px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 32px;
    box-shadow: var(--shadow-lg);
  }

  .cta_text h3 {
    color: #ffffff;
    font-size: clamp(20px, 2.4vw, 26px);
    margin-bottom: 10px;
  }

  .cta_text p {
    color: rgba(255, 255, 255, 0.85);
    font-size: 14.5px;
    line-height: 1.6;
    max-width: 650px;
  }

  .cta_actions {
    display: flex;
    gap: 16px;
    flex-shrink: 0;
  }

  .btn_gold {
    display: inline-block;
    background: var(--accent-gold);
    color: var(--primary-dark);
    font-weight: 700;
    font-size: 13.5px;
    padding: 12px 24px;
    border-radius: var(--radius-sm);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    transition: all 0.2s ease;
    text-decoration: none;
  }

  .btn_gold:hover {
    background: var(--accent-gold-hover);
    transform: translateY(-2px);
  }

  .btn_ghost {
    display: inline-block;
    border: 1.5px solid rgba(255, 255, 255, 0.4);
    color: #ffffff;
    font-weight: 600;
    font-size: 13.5px;
    padding: 12px 24px;
    border-radius: var(--radius-sm);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    transition: all 0.2s ease;
    text-decoration: none;
  }

  .btn_ghost:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: #ffffff;
  }

  @media (max-width: 900px) {
    .intro_grid {
      grid-template-columns: 1fr;
    }

    .cta_box {
      flex-direction: column;
      text-align: center;
      padding: 32px 24px;
    }

    .cta_actions {
      flex-direction: column;
      width: 100%;
    }
  }
</style>
