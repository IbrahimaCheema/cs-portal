---

<Layout 
  title="Administration & Academic Leadership – Crescent School"
  description="Meet the distinguished administrative team and academic leadership of Crescent Model Higher Secondary School across Early Years, Boys Campus, Girls Campus, and Central Operations."
>
  <!-- Standard Top Page Hero Banner -->
  <section class="page_hero_banner">
    <div class="container">
      <div class="hero_breadcrumbs">
        <a href="/">Home</a>
        <span>/</span>
        <span>Our Institution</span>
        <span>/</span>
        <span class="current">Administration</span>
      </div>
      <h1 class="hero_page_title">Administrative & Academic Leadership</h1>
      <p class="hero_subtitle">Seasoned educational leaders, curriculum directors, and operational heads steering institutional excellence.</p>
    </div>
  </section>

  <!-- Interactive / Categorized Team Section -->
  <section class="admin_section">
    <div class="container">
      
      <!-- Section 1: Early Years -->
      <div class="category_block">
        <div class="category_header">
          <span class="sub_badge">FOUNDATIONAL STAGE</span>
          <h2 class="category_title">Crescent Early Years & Primary Leadership</h2>
          <div class="title-decorator left"></div>
        </div>
        <div class="team_grid">
          {earlyYearsTeam.map((member) => (
            <div class="member_card">
              <div class="member_photo">
                <img 
                  src={getMediaUrl(member.image)} 
                  alt={member.name} 
                  loading="lazy" 
                  onerror="this.src='/images/cs_logo.png'"
                />
              </div>
              <div class="member_info">
                <h3>{member.name}</h3>
                <p class="member_role">{member.role}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Section 2: Boys Campus -->
      <div class="category_block">
        <div class="category_header">
          <span class="sub_badge">SHADMAN MAIN CAMPUS</span>
          <h2 class="category_title">Boys Campus Leadership</h2>
          <div class="title-decorator left"></div>
        </div>
        <div class="team_grid">
          {boysCampusTeam.map((member) => (
            <div class="member_card">
              <div class="member_photo">
                <img 
                  src={getMediaUrl(member.image)} 
                  alt={member.name} 
                  loading="lazy" 
                  onerror="this.src='/images/cs_logo.png'"
                />
              </div>
              <div class="member_info">
                <h3>{member.name}</h3>
                <p class="member_role">{member.role}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Section 3: Girls Campus -->
      <div class="category_block">
        <div class="category_header">
          <span class="sub_badge">FEMALE EMPOWERMENT COMPLEX</span>
          <h2 class="category_title">Girls Campus Leadership</h2>
          <div class="title-decorator left"></div>
        </div>
        <div class="team_grid">
          {girlsCampusTeam.map((member) => (
            <div class="member_card">
              <div class="member_photo">
                <img 
                  src={getMediaUrl(member.image)} 
                  alt={member.name} 
                  loading="lazy" 
                  onerror="this.src='/images/cs_logo.png'"
                />
              </div>
              <div class="member_info">
                <h3>{member.name}</h3>
                <p class="member_role">{member.role}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Section 4: Central Departments -->
      <div class="category_block">
        <div class="category_header">
          <span class="sub_badge">EXECUTIVE OPERATIONS</span>
          <h2 class="category_title">Central Administration & Department Heads</h2>
          <div class="title-decorator left"></div>
        </div>
        <div class="team_grid">
          {departmentsTeam.map((member) => (
            <div class="member_card">
              <div class="member_photo">
                <img 
                  src={getMediaUrl(member.image)} 
                  alt={member.name} 
                  loading="lazy" 
                  onerror="this.src='/images/cs_logo.png'"
                />
              </div>
              <div class="member_info">
                <h3>{member.name}</h3>
                <p class="member_role">{member.role}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

    </div>
  </section>
</Layout>

<style>
  .sub_badge {
    display: inline-block;
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: var(--primary-color);
    background: rgba(0, 33, 71, 0.08);
    padding: 5px 12px;
    border-radius: 16px;
    margin-bottom: 10px;
    text-transform: uppercase;
  }

  .admin_section {
    padding: 80px 0 100px;
    background: var(--bg-light);
  }

  .category_block {
    margin-bottom: 70px;
  }

  .category_block:last-child {
    margin-bottom: 0;
  }

  .category_header {
    margin-bottom: 30px;
  }

  .category_title {
    font-size: clamp(24px, 3vw, 30px);
    color: var(--primary-color);
    margin-bottom: 8px;
  }

  .title-decorator.left {
    margin: 0 0 24px 0;
  }

  .team_grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 24px;
  }

  .member_card {
    background: #ffffff;
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--border-light);
    display: flex;
    flex-direction: column;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .member_card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-lg);
    border-color: var(--accent-gold);
  }

  .member_photo {
    width: 100%;
    height: 250px;
    background: #f1f5f9;
    overflow: hidden;
  }

  .member_photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: transform 0.4s ease;
  }

  .member_card:hover .member_photo img {
    transform: scale(1.05);
  }

  .member_info {
    padding: 20px 16px;
    text-align: center;
    border-top: 3px solid var(--accent-gold);
    display: flex;
    flex-direction: column;
    flex: 1;
    justify-content: center;
  }

  .member_info h3 {
    font-size: 16px;
    color: var(--primary-color);
    margin-bottom: 6px;
    font-family: var(--font-heading);
    line-height: 1.35;
  }

  .member_role {
    font-size: 13px;
    color: var(--text-muted);
    font-weight: 500;
    line-height: 1.4;
  }
</style>
