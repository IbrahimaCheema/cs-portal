---
import Layout from '../layouts/Layout.astro';
import { getMediaUrl } from '../utils/media';
---

<Layout 
  title="Cambridge Section (O & A Levels) – Crescent School"
  description="Discover the prestigious Cambridge Section at Crescent Model Higher Secondary School. Offering Cambridge O-Levels and A-Levels with world-class faculty and global university counseling."
>
  <!-- Standard Top Page Hero Banner -->
  <section class="page_hero_banner">
    <div class="container">
      <div class="hero_breadcrumbs">
        <a href="/">Home</a>
        <span>/</span>
        <span>Academics</span>
        <span>/</span>
        <span class="current">Cambridge Section</span>
      </div>
      <h1 class="hero_page_title">Cambridge Section (O & A Levels)</h1>
      <p class="hero_subtitle">Global qualifications empowering scholars with analytical depth, intellectual agility, and international university pathways.</p>
    </div>
  </section>

  <!-- Overview Section -->
  <section class="academic_intro_section">
    <div class="container">
      <div class="intro_grid">
        <div class="intro_text">
          <span class="sub_badge">INTERNATIONAL STANDARDS</span>
          <h2 class="section_heading">Curriculum, Pedagogy & Assessment in Perfect Alignment</h2>
          <div class="lead_text">
            We aspire to brighten up the forte of every student with an education that operates at its peak when curriculum, teaching methodologies, active learning, and international assessment are seamlessly harmonized.
          </div>
          <p class="body_paragraph">
            Our Cambridge programmes (O-Levels, IGCSE, and A-Levels) develop deep subject mastery, conceptual clarity, and higher-order critical thinking skills to thoroughly prepare students for the demands of the modern world.
          </p>
          <p class="body_paragraph">
            Students benefit greatly from high-quality instructional resources and an elite faculty. Our philosophy is that assessment should both <em>prove and improve</em> students' intellect — giving them clarity, pace, and intellectual challenge while maximizing dedicated instructional time.
          </p>

          <div class="highlights_list">
            <div class="highlight_item">
              <span class="check_icon">✓</span>
              <div>
                <strong>Premier Cambridge Faculty:</strong> Renowned master educators with decades of consistent Cambridge distinction records.
              </div>
            </div>
            <div class="highlight_item">
              <span class="check_icon">✓</span>
              <div>
                <strong>Global University Admissions Office:</strong> Comprehensive guidance facilitating flawless applications to top universities in Pakistan (LUMS, AKU, NUST, GIKI, FAST) and abroad (UK, USA, Canada, Australia).
              </div>
            </div>
            <div class="highlight_item">
              <span class="check_icon">✓</span>
              <div>
                <strong>State-of-the-Art Sciences & Computing Labs:</strong> Advanced practical suites meeting the most stringent British Council and Cambridge CAIE compliance benchmarks.
              </div>
            </div>
          </div>
        </div>

        <div class="intro_media">
          <div class="media_card">
            <img 
              src={getMediaUrl("/images/batch3/cambridge_sec.jpg")} 
              alt="Cambridge Section Academic Complex" 
              loading="lazy"
              onerror="this.src='/images/welcome_side.jpg'"
            />
            <span class="media_caption">The Cambridge Academic Wing at Crescent School</span>
          </div>
          <div class="media_card">
            <img 
              src={getMediaUrl("/images/batch3/creb1.jpg")} 
              alt="Cambridge Classrooms & Student Life" 
              loading="lazy"
              onerror="this.src='/images/hero_slider_1.jpg'"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Programme Pathways -->
  <section class="pathways_section">
    <div class="container">
      <div class="section_header_center">
        <span class="sub_badge">QUALIFICATION TIERS</span>
        <h2 class="section_title">Cambridge Academic Pathways</h2>
        <div class="title-decorator"></div>
      </div>

      <div class="pathways_grid">
        <div class="pathway_card">
          <div class="pathway_badge">STAGE 1</div>
          <h3>Cambridge Lower Secondary & O-Levels</h3>
          <p class="pathway_desc">Spanning Classes VII through XI. Offering comprehensive subject clusters across Pre-Medical, Pre-Engineering, Computer Sciences, and Humanities.</p>
          <ul class="pathway_subjects">
            <li>• English Language & Literature, Mathematics (Syllabus D / Add Math)</li>
            <li>• Physics, Chemistry, Biology, Computer Science</li>
            <li>• Economics, Accounting, Business Studies</li>
            <li>• Pakistan Studies, Islamiyat, Urdu</li>
          </ul>
        </div>

        <div class="pathway_card highlight">
          <div class="pathway_badge gold">STAGE 2</div>
          <h3>Cambridge International A-Levels</h3>
          <p class="pathway_desc">A prestigious two-year pre-university program offering specialized academic depth for entry into global higher education.</p>
          <ul class="pathway_subjects">
            <li>• Advanced Sciences: Physics, Chemistry, Biology, Mathematics</li>
            <li>• Advanced Computing: Computer Science & IT Systems</li>
            <li>• Business & Social Sciences: Economics, Accounting, Law, Sociology</li>
            <li>• Dedicated SAT / ACT and university admissions coaching</li>
          </ul>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .sub_badge {
    display: inline-block;
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: var(--primary-color);
    background: rgba(0, 33, 71, 0.08);
    padding: 5px 12px;
    border-radius: 16px;
    margin-bottom: 12px;
    text-transform: uppercase;
  }

  .academic_intro_section {
    padding: 80px 0;
    background: var(--bg-white);
  }

  .intro_grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 50px;
    align-items: center;
  }

  .section_heading {
    font-size: clamp(26px, 3.2vw, 36px);
    color: var(--primary-color);
    margin-bottom: 18px;
    line-height: 1.3;
  }

  .lead_text {
    font-size: 17px;
    font-weight: 600;
    line-height: 1.65;
    color: var(--primary-light);
    margin-bottom: 16px;
  }

  .body_paragraph {
    font-size: 15px;
    line-height: 1.8;
    color: var(--text-muted);
    margin-bottom: 16px;
  }

  .highlights_list {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-top: 24px;
  }

  .highlight_item {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--text-dark);
  }

  .check_icon {
    color: var(--accent-gold-hover);
    font-weight: 800;
    font-size: 16px;
  }

  .intro_media {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .media_card {
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    background: #ffffff;
    border: 4px solid #ffffff;
  }

  .media_card img {
    width: 100%;
    height: 240px;
    object-fit: cover;
  }

  .media_caption {
    display: block;
    font-size: 12px;
    color: var(--text-muted);
    padding: 8px 12px;
    background: #ffffff;
    text-align: center;
  }

  .pathways_section {
    padding: 80px 0 100px;
    background: var(--bg-light);
  }

  .section_header_center {
    text-align: center;
    max-width: 700px;
    margin: 0 auto 50px;
  }

  .pathways_grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 30px;
  }

  .pathway_card {
    background: #ffffff;
    border-radius: var(--radius-md);
    padding: 38px 30px;
    border: 1px solid var(--border-light);
    box-shadow: var(--shadow-sm);
    transition: all 0.3s ease;
  }

  .pathway_card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-lg);
  }

  .pathway_card.highlight {
    border-top: 4px solid var(--accent-gold);
    background: linear-gradient(135deg, #ffffff 0%, #fdfbf7 100%);
  }

  .pathway_badge {
    display: inline-block;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1px;
    color: var(--primary-color);
    background: rgba(0, 33, 71, 0.08);
    padding: 4px 12px;
    border-radius: 12px;
    margin-bottom: 14px;
  }

  .pathway_badge.gold {
    color: #9a7200;
    background: rgba(253, 200, 0, 0.2);
  }

  .pathway_card h3 {
    font-size: 22px;
    color: var(--primary-color);
    margin-bottom: 12px;
  }

  .pathway_desc {
    font-size: 14.5px;
    line-height: 1.65;
    color: var(--text-muted);
    margin-bottom: 20px;
  }

  .pathway_subjects {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 13.5px;
    color: var(--text-dark);
    font-weight: 500;
    padding-top: 14px;
    border-top: 1px solid var(--border-light);
  }

  @media (max-width: 900px) {
    .intro_grid {
      grid-template-columns: 1fr;
    }
  }
</style>
