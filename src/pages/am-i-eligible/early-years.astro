---
import Layout from '../../layouts/Layout.astro';
import { getMediaUrl } from '../../utils/media';

const sections = [
  { id: "early-years", name: "Early Years (Pre-K to K2)", href: "/am-i-eligible/early-years/", active: true },
  { id: "junior", name: "Junior School (PYP 1 to 5)", href: "/am-i-eligible/" },
  { id: "middle", name: "Middle School (Class 6 to 8)", href: "/am-i-eligible/middle-school/" },
  { id: "senior", name: "Senior School (Matric)", href: "/am-i-eligible/senior-school/" },
  { id: "cambridge", name: "Cambridge (O & A Level)", href: "/am-i-eligible/cambridge/" },
  { id: "college", name: "The Crescent College", href: "/am-i-eligible/college/" },
  { id: "ib", name: "IB (MYP / DP / CP)", href: "/am-i-eligible/ib/" }
];

const earlyYearsTable = [
  { classGrade: "Pre Kindergarten (Pre-K)", ageRange: "2.6 years to 3.3 years", cutoff: "Calculated as of August 1st" },
  { classGrade: "Kindergarten 1 (K1 / Nursery)", ageRange: "3.4 years to 4.3 years", cutoff: "Calculated as of August 1st" },
  { classGrade: "Kindergarten 2 (K2 / Prep)", ageRange: "4.4 years to 5.3 years", cutoff: "Calculated as of August 1st" }
];

const earlyYearsDocs = [
  "Official Crescent School Online Application Form printout",
  "Clear photocopy of NADRA Child Registration Certificate (B-Form)",
  "Two recent passport-size photographs of the child with light blue/white background",
  "Photocopy of Computerized National Identity Cards (CNIC) of both parents / legal guardian",
  "Child's immunization & vaccination record photocopy (optional but recommended)"
];
---

<Layout 
  title="Am I Eligible? Crescent Early Years – Crescent School"
  description="Age criteria and admission requirements for Crescent Early Years (Pre-K, K1, K2). Learn about admissions benchmarks and required documents."
>
  <!-- Standard Top Page Hero Banner -->
  <section class="page_hero_banner">
    <div class="container">
      <div class="hero_breadcrumbs">
        <a href="/">Home</a>
        <span>/</span>
        <a href="/online-application-form/">Admission</a>
        <span>/</span>
        <a href="/am-i-eligible/">Am I Eligible?</a>
        <span>/</span>
        <span class="current">Early Years</span>
      </div>
      <h1 class="hero_page_title">Crescent Early Years Eligibility</h1>
      <p class="hero_subtitle">Age benchmarks and admissions guidelines for Pre-Kindergarten, Kindergarten 1, and Kindergarten 2.</p>
    </div>
  </section>

  <!-- Section Navigation Tabs -->
  <section class="eligibility_nav_strip">
    <div class="container">
      <nav class="eligibility_tabs" aria-label="Eligibility Sections">
        {sections.map(sec => (
          <a 
            href={sec.href} 
            class={`eligibility_tab_btn ${sec.active ? 'active' : ''}`}
          >
            {sec.name}
          </a>
        ))}
      </nav>
    </div>
  </section>

  <!-- Main Content Body -->
  <section class="eligibility_main_section">
    <div class="container">
      <div class="eligibility_layout">
        <!-- Left Column: Criteria & Details -->
        <div class="eligibility_content">
          <span class="sub_badge">EARLY CHILDHOOD EDUCATION</span>
          <h2 class="section_heading">Crescent Early Years Admission Criteria</h2>
          <p class="lead_text">
            Admissions to Crescent Early Years are governed strictly by developmental age readiness. Ages are benchmarked as of <strong>August 1st</strong> of the entry year to ensure optimal cognitive, motor, and social readiness.
          </p>

          <!-- Criteria Table -->
          <div class="table_responsive_wrapper">
            <table class="styled_criteria_table">
              <thead>
                <tr>
                  <th>Class / Grade</th>
                  <th>Age Range Benchmark</th>
                  <th>Cut-Off Guideline</th>
                </tr>
              </thead>
              <tbody>
                {earlyYearsTable.map(row => (
                  <tr>
                    <td class="grade_name"><strong>{row.classGrade}</strong></td>
                    <td class="age_value"><span class="badge_age">{row.ageRange}</span></td>
                    <td class="cutoff_text">{row.cutoff}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <!-- Evaluation Procedure Notice -->
          <div class="info_notice_box">
            <h4>Friendly Evaluation & Interaction Process</h4>
            <p>
              For Early Years candidates, there is no formal academic written test. The evaluation consists of an informal, child-friendly interaction designed to assess verbal expression, social curiosity, basic motor coordination, and visual recognition in a welcoming Montessori environment.
            </p>
          </div>

          <!-- Required Documents Summary -->
          <div class="required_docs_card">
            <div class="docs_header">
              <span class="docs_icon">📁</span>
              <h3>Documents to be Submitted</h3>
            </div>
            <ul class="docs_checklist">
              {earlyYearsDocs.map(doc => (
                <li>
                  <span class="chk_mark">✓</span>
                  <span>{doc}</span>
                </li>
              ))}
            </ul>
            <div class="docs_footer">
              <a href="/required-documents/" class="text_link">Full Document Submission Guidelines &rarr;</a>
            </div>
          </div>
        </div>

        <!-- Right Column: Visuals & CTAs -->
        <div class="eligibility_sidebar">
          <div class="hero_visual_card">
            <img 
              src={getMediaUrl("/images/batch6/mont.jpg")} 
              alt="Early Years Montessori Play Area" 
              loading="lazy"
              onerror="this.src='/images/batch3/early_learning.jpg'"
            />
            <div class="visual_caption">
              Montessori activity center nurturing curiosity, balance, and creative play.
            </div>
          </div>

          <div class="sidebar_cta_card">
            <h4>Admissions for Early Years</h4>
            <p>Registrations for Pre-K, K1, and K2 are evaluated on a first-come, merit basis. Submit your application online.</p>
            <a href="/online-application-form/" class="btn_apply_gold">Apply Online for Early Years</a>
          </div>

          <div class="support_card">
            <h5>Admissions Helpdesk</h5>
            <p>Have questions regarding age relaxation or documentation?</p>
            <p class="phone_num">📞 042 3742 1361-4</p>
            <a href="mailto:info@crescentschool.edu.pk" class="email_link">info@crescentschool.edu.pk</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .sub_badge {
    display: inline-block;
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: var(--primary-color);
    background: rgba(0, 33, 71, 0.08);
    padding: 5px 12px;
    border-radius: 16px;
    margin-bottom: 12px;
    text-transform: uppercase;
  }

  .eligibility_nav_strip {
    background: #f0f4f8;
    border-bottom: 1px solid var(--border-light);
    padding: 12px 0;
  }

  .eligibility_tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: center;
  }

  .eligibility_tab_btn {
    padding: 8px 16px;
    font-size: 13.5px;
    font-weight: 600;
    color: var(--primary-color);
    background: #ffffff;
    border: 1px solid var(--border-light);
    border-radius: 20px;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .eligibility_tab_btn:hover {
    background: var(--primary-color);
    color: #ffffff;
    border-color: var(--primary-color);
  }

  .eligibility_tab_btn.active {
    background: var(--primary-color);
    color: #ffffff;
    border-color: var(--primary-color);
    box-shadow: var(--shadow-sm);
  }

  .eligibility_main_section {
    padding: 70px 0;
    background: var(--bg-white);
  }

  .eligibility_layout {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 45px;
    align-items: start;
  }

  .section_heading {
    font-size: clamp(24px, 2.8vw, 32px);
    color: var(--primary-color);
    margin-bottom: 16px;
  }

  .lead_text {
    font-size: 15.5px;
    line-height: 1.75;
    color: var(--text-dark);
    margin-bottom: 24px;
  }

  .table_responsive_wrapper {
    overflow-x: auto;
    margin-bottom: 30px;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--border-light);
  }

  .styled_criteria_table {
    width: 100%;
    border-collapse: collapse;
    background: #ffffff;
    text-align: left;
    font-size: 14px;
  }

  .styled_criteria_table th {
    background: var(--primary-color);
    color: #ffffff;
    padding: 14px 18px;
    font-weight: 600;
    font-size: 13.5px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .styled_criteria_table td {
    padding: 14px 18px;
    border-bottom: 1px solid var(--border-light);
    color: var(--text-dark);
  }

  .styled_criteria_table tr:last-child td {
    border-bottom: none;
  }

  .badge_age {
    display: inline-block;
    background: rgba(0, 33, 71, 0.08);
    color: var(--primary-color);
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 4px;
  }

  .info_notice_box {
    background: #eff6ff;
    border: 1px solid #bfdbfe;
    border-left: 4px solid #3b82f6;
    border-radius: var(--radius-md);
    padding: 20px;
    margin-bottom: 30px;
  }

  .info_notice_box h4 {
    color: #1e40af;
    font-size: 16px;
    margin-bottom: 8px;
  }

  .info_notice_box p {
    font-size: 13.5px;
    line-height: 1.6;
    color: #1e3a8a;
    margin: 0;
  }

  .required_docs_card {
    background: #fcfcfd;
    border: 1px solid var(--border-light);
    border-left: 4px solid var(--accent-gold);
    border-radius: var(--radius-md);
    padding: 28px;
    box-shadow: var(--shadow-sm);
  }

  .docs_header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
  }

  .docs_icon {
    font-size: 24px;
  }

  .docs_header h3 {
    font-size: 18px;
    color: var(--primary-color);
    margin: 0;
  }

  .docs_checklist {
    list-style: none;
    padding: 0;
    margin: 0 0 16px 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .docs_checklist li {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    font-size: 14px;
    line-height: 1.5;
    color: var(--text-dark);
  }

  .chk_mark {
    color: #0b8043;
    font-weight: 800;
    font-size: 15px;
  }

  .text_link {
    color: var(--primary-color);
    font-weight: 600;
    font-size: 13.5px;
    text-decoration: none;
  }

  .text_link:hover {
    color: var(--accent-gold-hover);
    text-decoration: underline;
  }

  .eligibility_sidebar {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .hero_visual_card {
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    border: 4px solid #ffffff;
    background: #ffffff;
  }

  .hero_visual_card img {
    width: 100%;
    height: 240px;
    object-fit: cover;
    display: block;
  }

  .visual_caption {
    padding: 10px 14px;
    font-size: 12.5px;
    color: var(--text-muted);
    background: #ffffff;
  }

  .sidebar_cta_card {
    background: linear-gradient(135deg, var(--primary-dark) 0%, var(--primary-color) 100%);
    color: #ffffff;
    border-radius: var(--radius-md);
    padding: 28px;
    text-align: center;
    box-shadow: var(--shadow-md);
  }

  .sidebar_cta_card h4 {
    color: #ffffff;
    font-size: 18px;
    margin-bottom: 8px;
  }

  .sidebar_cta_card p {
    color: rgba(255, 255, 255, 0.85);
    font-size: 13px;
    line-height: 1.5;
    margin-bottom: 16px;
  }

  .btn_apply_gold {
    display: block;
    background: var(--accent-gold);
    color: var(--primary-dark);
    font-weight: 700;
    font-size: 13px;
    padding: 12px;
    border-radius: var(--radius-sm);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    transition: all 0.2s ease;
  }

  .btn_apply_gold:hover {
    background: var(--accent-gold-hover);
    transform: translateY(-2px);
  }

  .support_card {
    background: #f8fafc;
    border-radius: var(--radius-md);
    padding: 22px;
    border: 1px solid var(--border-light);
    text-align: center;
  }

  .support_card h5 {
    color: var(--primary-color);
    font-size: 15px;
    margin-bottom: 6px;
  }

  .support_card p {
    font-size: 12.5px;
    color: var(--text-muted);
    margin-bottom: 8px;
  }

  .phone_num {
    font-weight: 700;
    color: var(--primary-color);
    font-size: 14px;
    margin-bottom: 4px;
  }

  .email_link {
    color: var(--primary-light);
    font-size: 12.5px;
    text-decoration: none;
  }

  @media (max-width: 900px) {
    .eligibility_layout {
      grid-template-columns: 1fr;
    }
  }
</style>
