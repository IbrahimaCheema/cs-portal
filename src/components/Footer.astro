---
import { getMediaUrl } from '../utils/media';
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <!-- Main Footer Content -->
  <div class="footer-main">
    <div class="container footer-grid">
      <!-- Column 1: School Identity & Mission -->
      <div class="footer-col col-about">
        <div class="footer-brand">
          <div class="brand-crest-frame">
            <img 
              src={getMediaUrl('/images/cs_crest_centered.png')} 
              alt="The Crescent School Emblem" 
              class="footer-crest" 
              width="50" 
              height="50" 
            />
          </div>
          <div class="brand-text-block">
            <div class="brand-title">THE CRESCENT SCHOOL</div>
            <div class="brand-subtitle">CRESCENT MODEL HIGHER SECONDARY SCHOOL</div>
            <div class="brand-meta">ESTD. 1968 &bull; SHADMAN, LAHORE</div>
          </div>
        </div>
        <p class="about-text">
          At Crescent School, we are inspired by values that make each student of ours rise to their potential. Since 1968, delivering academic excellence, integrity, and character across Pakistan.
        </p>
        <div class="social-pills">
          <a href="https://www.facebook.com/CrescentSchoolOfficial/" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/></svg>
          </a>
          <a href="https://twitter.com/crescentschool1" target="_blank" rel="noopener noreferrer" aria-label="Twitter">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M23 3a10.9 10.9 0 01-3.14 1.53 4.48 4.48 0 00-7.86 3v1A10.66 10.66 0 013 4s-4 9 5 13a11.64 11.64 0 01-7 2c9 5 20 0 20-11.5a4.5 4.5 0 00-.08-.83A7.72 7.72 0 0023 3z"/></svg>
          </a>
          <a href="https://www.linkedin.com/school/crescent-school-official/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6zM2 9h4v12H2zM4 2a2 2 0 110 4 2 2 0 010-4z"/></svg>
          </a>
          <a href="https://www.instagram.com/crescent.school.official/" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
            <svg viewBox="0 0 24 24" fill="currentColor"><rect x="2" y="2" width="20" height="20" rx="5" ry="5" fill="none" stroke="currentColor" stroke-width="2"/><path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37zm1.5-4.87h.01"/></svg>
          </a>
        </div>
      </div>

      <!-- Column 2: Boys Campus with Map & Direct Link -->
      <div class="footer-col col-campus">
        <h3 class="col-title">BOYS CAMPUS</h3>
        <div class="campus-info">
          <p class="campus-address">
            <svg class="icon" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 010-5 2.5 2.5 0 010 5z"/></svg>
            <a href="https://www.google.com/maps?cid=17272449557287959642" target="_blank" rel="noopener noreferrer" class="map-text-link" title="Open Boys Campus on Google Maps">
              <span>352 Shadman Colony, Lahore</span>
            </a>
          </p>
          <p class="campus-phone">
            <svg class="icon" viewBox="0 0 24 24" fill="currentColor"><path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2a1 1 0 011.02-.24 11.72 11.72 0 003.68.59 1 1 0 011 1v3.5a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1 11.72 11.72 0 00.59 3.68 1 1 0 01-.24 1.02l-2.23 2.09z"/></svg>
            <a href="tel:04237421361">042-37421361</a>
          </p>
          <p class="campus-email">
            <svg class="icon" viewBox="0 0 24 24" fill="currentColor"><path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
            <a href="mailto:info@crescentschool.edu.pk">info@crescentschool.edu.pk</a>
          </p>
        </div>
        <!-- Boys Campus Google Map Embed -->
        <div class="campus-map-card">
          <iframe 
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3400.4290402687084!2d74.32178981515108!3d31.53983808136312!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x391904bd457949b3%3A0xefb4439d3b51fc5a!2sCrescent%20Model%20Higher%20Secondary%20School%20(Boys%20Campus)!5e0!3m2!1sen!2s!4v1622808445194!5m2!1sen!2s" 
            width="100%" 
            height="110" 
            style="border:0;" 
            allowfullscreen="" 
            loading="lazy" 
            referrerpolicy="no-referrer-when-downgrade"
            title="Boys Campus Google Map"
          ></iframe>
          <a href="https://www.google.com/maps?cid=17272449557287959642" target="_blank" rel="noopener noreferrer" class="map-action-pill">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 010-5 2.5 2.5 0 010 5z"/></svg>
            <span>View on Google Maps</span>
            <svg class="arrow-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
          </a>
        </div>
      </div>

      <!-- Column 3: Girls Campus with Map & Direct Link -->
      <div class="footer-col col-campus">
        <h3 class="col-title">GIRLS CAMPUS</h3>
        <div class="campus-info">
          <p class="campus-address">
            <svg class="icon" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 010-5 2.5 2.5 0 010 5z"/></svg>
            <a href="https://www.google.com/maps?cid=12619077274026858159" target="_blank" rel="noopener noreferrer" class="map-text-link" title="Open Girls Campus on Google Maps">
              <span>930A Shadman Colony, Lahore</span>
            </a>
          </p>
          <p class="campus-phone">
            <svg class="icon" viewBox="0 0 24 24" fill="currentColor"><path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2a1 1 0 011.02-.24 11.72 11.72 0 003.68.59 1 1 0 011 1v3.5a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1 11.72 11.72 0 00.59 3.68 1 1 0 01-.24 1.02l-2.23 2.09z"/></svg>
            <a href="tel:04235960725">042 3596 0725-26</a>
          </p>
          <p class="campus-email">
            <svg class="icon" viewBox="0 0 24 24" fill="currentColor"><path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
            <a href="mailto:info@crescentschool.edu.pk">info@crescentschool.edu.pk</a>
          </p>
        </div>
        <!-- Girls Campus Google Map Embed -->
        <div class="campus-map-card">
          <iframe 
            src="https://www.google.com/maps/embed?pb=!1m14!1m8!1m3!1d3400.3557198316403!2d74.3266505!3d31.5418509!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3919050daf092b57%3A0xaf1fe67705bd56af!2sCrescent%20Model%20Higher%20Secondary%20School%20(Girls%20Campus)!5e0!3m2!1sen!2s!4v1622808529841!5m2!1sen!2s" 
            width="100%" 
            height="110" 
            style="border:0;" 
            allowfullscreen="" 
            loading="lazy" 
            referrerpolicy="no-referrer-when-downgrade"
            title="Girls Campus Google Map"
          ></iframe>
          <a href="https://www.google.com/maps?cid=12619077274026858159" target="_blank" rel="noopener noreferrer" class="map-action-pill">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 010-5 2.5 2.5 0 010 5z"/></svg>
            <span>View on Google Maps</span>
            <svg class="arrow-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
          </a>
        </div>
      </div>

      <!-- Column 4: Quick Portals -->
      <div class="footer-col col-links">
        <h3 class="col-title">QUICK PORTALS</h3>
        <ul class="footer-link-list">
          <li><a href="/online-application-form/">Online Admission Form</a></li>
          <li><a href="/merit-list/">Merit Lists & Results</a></li>
          <li><a href="/hall-of-fame/">Hall of Fame</a></li>
          <li><a href="/facilities/">Campus Facilities</a></li>
          <li><a href="/careers/">Career Opportunities</a></li>
          <li><a href="/contact-2/">Contact & Location</a></li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Bottom Bar -->
  <div class="footer-bottom">
    <div class="container bottom-inner">
      <p class="copyright-text">
        &copy; {currentYear} Crescent Model Higher Secondary School. All Rights Reserved.
      </p>
      <div class="bottom-links">
        <a href="/mission-values/">Values</a>
        <span>•</span>
        <a href="/history/">History</a>
        <span>•</span>
        <a href="/general-rules/">Discipline</a>
        <span>•</span>
        <a href="/affiliations/">Affiliations</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: #001226;
    color: #cbd5e1;
    border-top: 4px solid var(--accent-gold);
    margin-top: auto;
  }

  .footer-main {
    padding: 56px 0 42px;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.25fr 1.15fr 1.15fr 0.85fr;
    gap: 32px;
    align-items: start;
  }

  /* Brand Presentation */
  .footer-brand {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 18px;
  }

  .brand-crest-frame {
    width: 56px;
    height: 56px;
    background: #ffffff;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 3px;
    border: 2px solid var(--accent-gold);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.4);
    flex-shrink: 0;
  }

  .footer-crest {
    width: 48px;
    height: 48px;
    object-fit: contain;
  }

  .brand-text-block {
    display: flex;
    flex-direction: column;
  }

  .brand-title {
    font-family: var(--font-heading);
    font-size: 1.12rem;
    font-weight: 800;
    color: #ffffff;
    letter-spacing: 0.03em;
    line-height: 1.2;
  }

  .brand-subtitle {
    font-size: 0.70rem;
    font-weight: 700;
    color: var(--accent-gold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-top: 3px;
    line-height: 1.2;
  }

  .brand-meta {
    font-size: 0.65rem;
    font-weight: 600;
    color: #94a3b8;
    letter-spacing: 0.08em;
    margin-top: 2px;
  }

  .about-text {
    font-size: 13.5px;
    line-height: 1.65;
    color: #94a3b8;
    margin-bottom: 20px;
  }

  .social-pills {
    display: flex;
    gap: 10px;
  }

  .social-pills a {
    width: 34px;
    height: 34px;
    background: rgba(255, 255, 255, 0.08);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #cbd5e1;
    transition: var(--transition-fast);
  }

  .social-pills a svg {
    width: 16px;
    height: 16px;
  }

  .social-pills a:hover {
    background: var(--accent-gold);
    color: #001226;
    transform: translateY(-2px);
  }

  /* Column Titles */
  .col-title {
    font-family: var(--font-heading);
    color: var(--accent-gold);
    font-size: 14.5px;
    letter-spacing: 0.8px;
    margin-bottom: 16px;
    font-weight: 700;
    position: relative;
    padding-bottom: 8px;
  }

  .col-title::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 32px;
    height: 2px;
    background: var(--accent-gold);
  }

  /* Campus Information */
  .campus-info p {
    display: flex;
    align-items: flex-start;
    gap: 9px;
    font-size: 13px;
    color: #94a3b8;
    margin-bottom: 9px;
    line-height: 1.45;
  }

  .campus-info .icon {
    width: 15px;
    height: 15px;
    color: var(--accent-gold);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .campus-info a {
    color: #cbd5e1;
    transition: var(--transition-fast);
  }

  .campus-info a:hover {
    color: var(--accent-gold);
  }

  .map-text-link {
    display: inline-block;
  }

  .map-text-link:hover span {
    text-decoration: underline;
    color: var(--accent-gold);
  }

  /* Campus Map Embed Card */
  .campus-map-card {
    margin-top: 14px;
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    overflow: hidden;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .campus-map-card:hover {
    border-color: rgba(253, 200, 0, 0.4);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
  }

  .campus-map-card iframe {
    display: block;
    width: 100%;
    filter: brightness(0.92) contrast(1.05);
    transition: filter 0.2s ease;
  }

  .campus-map-card:hover iframe {
    filter: brightness(1) contrast(1);
  }

  .map-action-pill {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 7px 12px;
    background: rgba(0, 33, 71, 0.85);
    color: #ffffff;
    font-size: 11.5px;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.2s ease, color 0.2s ease;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .map-action-pill svg {
    width: 13px;
    height: 13px;
    color: var(--accent-gold);
    flex-shrink: 0;
  }

  .map-action-pill .arrow-icon {
    width: 12px;
    height: 12px;
    color: #94a3b8;
    transition: transform 0.2s ease, color 0.2s ease;
  }

  .map-action-pill:hover {
    background: var(--accent-gold);
    color: #001226;
  }

  .map-action-pill:hover svg {
    color: #001226;
  }

  .map-action-pill:hover .arrow-icon {
    transform: translate(2px, -2px);
  }

  /* Quick Links */
  .footer-link-list {
    list-style: none;
  }

  .footer-link-list li {
    margin-bottom: 9px;
  }

  .footer-link-list a {
    font-size: 13px;
    color: #94a3b8;
    transition: var(--transition-fast);
    display: inline-block;
  }

  .footer-link-list a:hover {
    color: var(--accent-gold);
    transform: translateX(4px);
  }

  /* Bottom Bar */
  .footer-bottom {
    background: #000c1a;
    padding: 16px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    font-size: 12px;
    color: #64748b;
  }

  .bottom-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
  }

  .bottom-links {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .bottom-links a {
    color: #94a3b8;
    font-size: 12px;
  }

  .bottom-links a:hover {
    color: var(--accent-gold);
  }

  @media (max-width: 1100px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 32px;
    }
  }

  @media (max-width: 640px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .bottom-inner {
      flex-direction: column;
      text-align: center;
    }
    .footer-brand {
      flex-direction: row;
    }
  }
</style>
